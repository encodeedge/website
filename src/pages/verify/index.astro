---
export const prerender = false;
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { 
  ShieldCheck, 
  Search, 
  Award, 
  CheckCircle2, 
  Lock, 
  ArrowRight,
  ExternalLink,
  GraduationCap
} from 'lucide-react';
import { getCollection } from 'astro:content';

const url = new URL(Astro.request.url);
const searchId = url.searchParams.get('id') || '';

// If a search ID was submitted in the query string, redirect directly to `/verify/[id]`
if (searchId) {
  // If user pasted a full URL, extract path
  let targetId = searchId.trim();
  if (targetId.startsWith('http')) {
    try {
      const parsed = new URL(targetId);
      return Astro.redirect(parsed.pathname + parsed.search);
    } catch {
      // fallback
    }
  }
  return Astro.redirect(`/verify/${encodeURIComponent(targetId)}`);
}

const certificates = await getCollection('certificates');
const courses = await getCollection('courses');
---

<DefaultLayout 
  title="Official Credential Verification | EncodeEdge Academy"
  description="Verify the authenticity and integrity of EncodeEdge certificates and course completion credentials."
>
  <div class="py-12 md:py-20 container mx-auto px-4 max-w-4xl space-y-12">
    
    {/* Hero Section */}
    <div class="text-center space-y-4 max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/25 text-emerald-600 dark:text-emerald-400 text-xs font-bold font-mono">
        <ShieldCheck className="size-4" />
        <span>Cryptographic Verification Engine</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black font-display text-foreground tracking-tight">
        Verify Student Credentials
      </h1>

      <p class="text-sm sm:text-base text-muted-foreground font-body leading-relaxed">
        EncodeEdge issues tamper-evident, cryptographically signed certificates for all completed mastery tracks. Enter a Credential ID or verification link to validate authenticity.
      </p>
    </div>

    {/* Verification Search Card */}
    <div class="rounded-3xl border border-border/80 bg-card p-6 sm:p-10 shadow-xl space-y-6 max-w-2xl mx-auto">
      <form action="/verify" method="GET" class="space-y-4">
        <label for="cred-search-input" class="text-xs sm:text-sm font-bold text-foreground block">
          Enter Credential ID or Full Verification Link:
        </label>
        
        <div class="flex flex-col sm:flex-row gap-2.5">
          <input
            id="cred-search-input"
            type="text"
            name="id"
            placeholder="e.g. EE-APPL-4921-2026 or paste verification URL..."
            class="flex-1 px-4 py-3 rounded-xl border border-input bg-background text-foreground text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-primary/40 shadow-xs"
            required
            autoFocus
          />
          <button
            type="submit"
            class="px-6 py-3 rounded-xl bg-primary text-primary-foreground font-bold text-sm shadow-md hover:opacity-90 transition-all flex items-center justify-center gap-2 shrink-0 cursor-pointer"
          >
            <Search className="size-4" />
            <span>Verify Now</span>
          </button>
        </div>
      </form>

      {/* Security explanation badges */}
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-border/60 text-xs">
        <div class="flex items-start gap-2 p-3 rounded-2xl bg-muted/20 border border-border/60">
          <Lock className="size-4 text-emerald-500 shrink-0 mt-0.5" />
          <div>
            <div class="font-bold text-foreground">Anti-Tamper</div>
            <div class="text-[11px] text-muted-foreground">Signed with SHA-256 HMAC</div>
          </div>
        </div>

        <div class="flex items-start gap-2 p-3 rounded-2xl bg-muted/20 border border-border/60">
          <CheckCircle2 className="size-4 text-blue-500 shrink-0 mt-0.5" />
          <div>
            <div class="font-bold text-foreground">Instant Proof</div>
            <div class="text-[11px] text-muted-foreground">Real-time status checks</div>
          </div>
        </div>

        <div class="flex items-start gap-2 p-3 rounded-2xl bg-muted/20 border border-border/60">
          <Award className="size-4 text-amber-500 shrink-0 mt-0.5" />
          <div>
            <div class="font-bold text-foreground">Official Records</div>
            <div class="text-[11px] text-muted-foreground">Backed by curriculum leads</div>
          </div>
        </div>
      </div>
    </div>

    {/* Frequently Verified Tracks */}
    <div class="space-y-6 max-w-3xl mx-auto">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold font-display text-foreground">
          Accredited Certification Tracks
        </h2>
        <a 
          href="/courses" 
          class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1"
        >
          <span>View all tracks</span>
          <ArrowRight className="size-3" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {courses.slice(0, 4).map((c) => (
          <div key={c.id} class="p-5 rounded-2xl border border-border/80 bg-card/60 space-y-2 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs text-muted-foreground mb-1">
                <span class="font-mono uppercase font-bold text-[10px] text-amber-600 dark:text-amber-400">
                  Track: {c.id}
                </span>
                <span class="capitalize">{c.data.level}</span>
              </div>
              <h3 class="font-bold text-sm text-foreground">
                {c.data.title}
              </h3>
            </div>
            <div class="pt-2 flex items-center justify-between text-xs border-t border-border/60">
              <span class="text-muted-foreground flex items-center gap-1 text-[11px]">
                <GraduationCap className="size-3.5 text-primary" />
                {c.data.instructor || 'Atul Jha'}
              </span>
              <a 
                href={`/courses/${c.id}`}
                class="font-semibold text-primary hover:underline text-[11px] inline-flex items-center gap-0.5"
              >
                <span>Curriculum</span>
                <ExternalLink className="size-3" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</DefaultLayout>
