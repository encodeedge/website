---
import { getCollection } from 'astro:content';
import RoadmapLayout from '@/layouts/RoadmapLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { TOPIC_METADATA } from '@/lib/topics';

export async function getStaticPaths() {
  const roadmaps = await getCollection('roadmaps');
  return roadmaps.map((roadmap) => ({
    params: { slug: roadmap.id },
    props: { roadmap },
  }));
}

interface Props {
	roadmap: CollectionEntry<'roadmaps'>;
}

const { roadmap } = Astro.props;
const totalTopics = roadmap.data.nodes?.reduce((acc, section) => acc + (section.topics?.length ?? 0), 0) ?? 0;
const totalModules = roadmap.data.nodes?.length ?? 0;

const topicMeta = TOPIC_METADATA[roadmap.id] || {
  value: roadmap.id,
  label: roadmap.data.title,
  description: roadmap.data.description,
  color: '#E5E795',
  roadmapSlug: roadmap.id,
};

// Helper to parse duration string to numeric hours
function parseDurationHours(duration?: string): number {
  if (!duration) return 2;
  const d = duration.toLowerCase();
  if (d.includes('hour') || d.includes('hr')) {
    return parseFloat(d) || 2;
  }
  if (d.includes('min')) {
    return Math.round(((parseFloat(d) || 45) / 60) * 10) / 10;
  }
  if (d.includes('week')) {
    return (parseFloat(d) || 1) * 10;
  }
  return 2;
}

// Calculate total estimated hours
let totalHours = 0;
roadmap.data.nodes?.forEach((sec) => {
  sec.topics?.forEach((t) => {
    totalHours += parseDurationHours(t.duration);
  });
});
const estimatedHours = Math.max(10, Math.round(totalHours));

// Helper to slugify topic names for anchors
const slugify = (str: string) => str.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<RoadmapLayout 
  title={`${roadmap.data.title} - Interactive Roadmap`} 
  description={roadmap.data.description}
>

<div 
  class="woords_container_small py-6 sm:py-10" 
  id="roadmapContainer" 
  data-slug={roadmap.id} 
  data-title={roadmap.data.title}
  data-estimated-hours={estimatedHours}
>

  {/* 1. Woords Editorial Breadcrumbs & Header */}
  <div class="mb-8">
    <div class="flex items-center gap-2 text-xs font-semibold text-muted-foreground mb-4">
      <a href="/roadmaps" class="hover:text-foreground flex items-center gap-1.5 transition-colors">
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        <span>All Roadmaps</span>
      </a>
      <span>/</span>
      <span class="text-foreground font-medium">{roadmap.data.title}</span>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-6 border-b border-black-150 dark:border-black-800">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 mb-3 flex-wrap">
          <span 
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-black shadow-xs"
            style={`background-color: ${topicMeta.color};`}
          >
            <svg class="size-3.5 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
            {topicMeta.label || roadmap.data.title}
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
            <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Interactive Graph Curriculum
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-medium font-serif text-foreground tracking-tight leading-[1.15]">
          {roadmap.data.title}
        </h1>
        <p class="text-sm sm:text-base text-muted-foreground font-body mt-2.5 leading-relaxed">
          {roadmap.data.description}
        </p>
      </div>

      {/* Header Stats Chips */}
      <div class="flex items-center gap-2.5 sm:gap-3 shrink-0 flex-wrap">
        <div class="px-4 py-2.5 rounded-2xl border border-black-150 dark:border-black-800 bg-card/80 backdrop-blur-xs text-center min-w-[76px] shadow-xs">
          <span class="block text-xl font-bold font-serif text-foreground">{totalModules}</span>
          <span class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider">Phases</span>
        </div>
        <div class="px-4 py-2.5 rounded-2xl border border-black-150 dark:border-black-800 bg-card/80 backdrop-blur-xs text-center min-w-[76px] shadow-xs">
          <span class="block text-xl font-bold font-serif text-foreground" id="totalTopicsDisplay">{totalTopics}</span>
          <span class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider">Topics</span>
        </div>
        <div class="px-4 py-2.5 rounded-2xl border border-black-150 dark:border-black-800 bg-card/80 backdrop-blur-xs text-center min-w-[84px] shadow-xs">
          <span class="block text-xl font-bold font-serif text-foreground">~{estimatedHours}h</span>
          <span class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider">Total Time</span>
        </div>
      </div>
    </div>
  </div>

  {/* 2. Sticky Control Toolbar */}
  <div 
    class="sticky z-30 mb-6 rounded-2xl border border-black-200 dark:border-black-800 bg-background/95 backdrop-blur-md shadow-md p-3.5 sm:p-4 transition-all max-h-[85vh] overflow-y-auto" 
    id="stickyToolbar"
  >
    
    {/* Progress Bar & High-Level Actions */}
    <div id="toolbarTopSection" class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4 pb-3.5 border-b border-black-150 dark:border-black-800">
      
      {/* Learning Progress & Hours Tracker (Desktop / Tablet view; mobile displays floating button) */}
      <div class="flex-1 max-w-xl hidden md:block" id="topStudyProgressBar">
        <div class="flex items-center justify-between text-xs font-semibold mb-1.5 flex-wrap gap-1">
          <span class="text-foreground flex items-center gap-1.5">
            <svg class="size-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Study Progress:
            <span class="text-muted-foreground font-normal ml-0.5">
              <strong class="text-foreground font-semibold" id="completedCountDisplay">0</strong> of {totalTopics} completed
              <span class="mx-1.5 text-muted-foreground/50">•</span>
              <span id="completedHoursDisplay" class="font-semibold text-foreground">0h</span> of ~{estimatedHours}h
            </span>
          </span>
          <span class="font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400" id="progressPercentDisplay">0%</span>
        </div>
        <div class="w-full h-2 rounded-full bg-black-100 dark:bg-black-800 overflow-hidden">
          <div 
            id="progressBarFill"
            class="h-full bg-linear-to-r from-emerald-500 to-teal-400 transition-all duration-300 rounded-full" 
            style="width: 0%;"
          ></div>
        </div>
      </div>

      {/* View Switcher, Density & Actions Group */}
      <div class="flex items-center gap-2 shrink-0 flex-wrap">
        
        {/* Dual View Mode Toggle */}
        <div class="inline-flex p-1 rounded-xl bg-black-100 dark:bg-black-800 border border-black-150 dark:border-black-700" id="viewModeGroup">
          <button 
            type="button" 
            id="btnViewFlowchart"
            class="view-mode-btn active inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer shadow-xs"
            title="Switch to Visual Zigzag Tree Canvas"
          >
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="5" r="3" />
              <line x1="12" y1="8" x2="12" y2="12" />
              <circle cx="6" cy="19" r="3" />
              <circle cx="18" cy="19" r="3" />
              <path d="M12 12l-6 4" />
              <path d="M12 12l6 4" />
            </svg>
            <span>Tree Graph</span>
          </button>
          <button 
            type="button" 
            id="btnViewSyllabus"
            class="view-mode-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer text-muted-foreground hover:text-foreground"
            title="Switch to Syllabus Guide View"
          >
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="8" y1="6" x2="21" y2="6" />
              <line x1="8" y1="12" x2="21" y2="12" />
              <line x1="8" y1="18" x2="21" y2="18" />
              <line x1="3" y1="6" x2="3.01" y2="6" />
              <line x1="3" y1="12" x2="3.01" y2="12" />
              <line x1="3" y1="18" x2="3.01" y2="18" />
            </svg>
            <span>Syllabus Guide</span>
          </button>
        </div>

        {/* Visual Density Toggle (Detailed vs Compact) */}
        <button 
          type="button" 
          id="btnToggleDensity"
          class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl text-xs font-semibold border border-black-150 dark:border-black-800 bg-card hover:bg-secondary text-foreground transition-colors cursor-pointer shadow-2xs"
          title="Toggle between Compact node view and Detailed cards"
        >
          <svg class="size-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" />
            <rect x="14" y="3" width="7" height="7" />
            <rect x="14" y="14" width="7" height="7" />
            <rect x="3" y="14" width="7" height="7" />
          </svg>
          <span id="densityToggleText">Compact</span>
        </button>

        {/* Keyboard Shortcuts Button */}
        <button 
          type="button" 
          id="openShortcutsBtn"
          class="p-2 rounded-xl border border-black-150 dark:border-black-800 bg-card hover:bg-secondary text-muted-foreground hover:text-foreground transition-colors cursor-pointer shadow-2xs"
          title="View Keyboard Shortcuts"
          aria-label="Keyboard Shortcuts"
        >
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M6 12h.01M10 12h.01M14 12h.01M18 12h.01M8 16h8" />
          </svg>
        </button>

        {/* Export Progress Button */}
        <button 
          type="button"
          id="exportProgressBtn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-foreground bg-card hover:bg-secondary border border-black-150 dark:border-black-800 transition-colors cursor-pointer shrink-0 shadow-xs"
          title="Export your study checklist as Markdown"
        >
          <svg class="size-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span id="exportBtnText">Export</span>
        </button>

        {/* Reset Progress Button */}
        <button 
          type="button"
          id="openResetModalBtn"
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-semibold text-rose-600 dark:text-rose-400 bg-rose-500/10 hover:bg-rose-500/20 transition-colors cursor-pointer shrink-0"
          title="Reset roadmap progress"
        >
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Reset</span>
        </button>
      </div>

    </div>

    {/* Search & Filter Controls Row */}
    <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3 text-xs">
      
      {/* Live Topic Search */}
      <div class="relative flex-1 max-w-md">
        <svg class="size-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input 
          type="text" 
          id="topicSearchInput" 
          placeholder="Filter topics (e.g., Transformers, Search, A*)..." 
          class="w-full pl-8 pr-16 py-1.5 rounded-xl bg-card border border-black-150 dark:border-black-800 text-foreground placeholder:text-muted-foreground focus:outline-hidden focus:ring-1 focus:ring-primary text-xs shadow-xs"
        />
        <div class="absolute right-2.5 top-1/2 -translate-y-1/2 flex items-center gap-1 pointer-events-none">
          <span class="px-1.5 py-0.5 rounded-md bg-black-100 dark:bg-black-800 text-[10px] font-mono text-muted-foreground border border-black-200 dark:border-black-700">/</span>
        </div>
        <button 
          type="button"
          id="clearSearchBtn"
          class="absolute right-7 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground hidden cursor-pointer"
          title="Clear search"
        >
          <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>

      {/* Filter Groups */}
      <div class="flex items-center gap-2.5 overflow-x-auto pb-1 lg:pb-0 flex-wrap">
        
        {/* Status Filter Pills */}
        <div class="flex items-center gap-1 shrink-0" id="statusFilterContainer">
          <span class="text-muted-foreground font-semibold text-[11px] mr-0.5">Status:</span>
          <button type="button" class="status-filter-btn active px-2.5 py-1 rounded-lg font-semibold border transition-all cursor-pointer text-[11px]" data-status="all">All</button>
          <button type="button" class="status-filter-btn px-2.5 py-1 rounded-lg font-semibold border transition-all cursor-pointer text-[11px]" data-status="done">Done</button>
          <button type="button" class="status-filter-btn px-2.5 py-1 rounded-lg font-semibold border transition-all cursor-pointer text-[11px]" data-status="learning">In Progress</button>
          <button type="button" class="status-filter-btn px-2.5 py-1 rounded-lg font-semibold border transition-all cursor-pointer text-[11px]" data-status="todo">Todo</button>
          <button type="button" class="status-filter-btn px-2.5 py-1 rounded-lg font-semibold border transition-all cursor-pointer text-[11px]" data-status="starred">
            <span>⭐ Starred</span>
            <span id="starredFilterCount" class="ml-1 px-1 rounded-full text-[9px] bg-secondary text-secondary-foreground font-mono">0</span>
          </button>
          <button type="button" class="status-filter-btn px-2.5 py-1 rounded-lg font-semibold border transition-all cursor-pointer text-[11px]" data-status="optional">Optional</button>
        </div>

        <div class="hidden sm:block h-4 w-px bg-black-200 dark:bg-black-800"></div>

        {/* Level Filter Pills */}
        <div class="flex items-center gap-1 shrink-0" id="levelFilterContainer">
          <span class="text-muted-foreground font-semibold text-[11px] mr-0.5">Level:</span>
          <button type="button" class="level-btn active px-2.5 py-1 rounded-lg font-semibold border transition-all cursor-pointer text-[11px]" data-level="all">All</button>
          <button type="button" class="level-btn px-2.5 py-1 rounded-lg font-semibold border transition-all cursor-pointer text-[11px]" data-level="beginner">Beginner</button>
          <button type="button" class="level-btn px-2.5 py-1 rounded-lg font-semibold border transition-all cursor-pointer text-[11px]" data-level="intermediate">Intermediate</button>
          <button type="button" class="level-btn px-2.5 py-1 rounded-lg font-semibold border transition-all cursor-pointer text-[11px]" data-level="advanced">Advanced</button>
        </div>

      </div>
    </div>
  </div>

  {/* 3. Next Up Recommendation Banner */}
  <div id="nextUpBanner" class="mb-8 p-4 rounded-2xl border border-black-150 dark:border-black-800 bg-card/80 backdrop-blur-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs">
    <div class="flex items-center gap-3.5 min-w-0">
      <div class="size-10 rounded-xl bg-ghost-accent text-black flex items-center justify-center shrink-0 font-bold shadow-xs">
        🎯
      </div>
      <div class="min-w-0">
        <div class="flex items-center gap-2 mb-0.5">
          <span class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground" id="nextUpLabel">Recommended Next Step</span>
          <span id="nextUpDiffBadge" class="text-[10px] font-semibold px-2 py-0.5 rounded-md bg-secondary text-secondary-foreground uppercase">
            Beginner
          </span>
          <span id="nextUpDurationBadge" class="text-[11px] text-muted-foreground font-medium hidden sm:inline">
            ⏱️ 3 hours
          </span>
        </div>
        <h3 id="nextUpTitle" class="text-base font-serif font-medium text-foreground truncate">
          Intelligent Agents &amp; Problem Formulation
        </h3>
      </div>
    </div>

    <button 
      type="button" 
      id="nextUpActionBtn"
      class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-foreground text-background hover:opacity-90 transition-all cursor-pointer shrink-0 shadow-xs"
    >
      <span>Jump to Topic</span>
      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
    </button>
  </div>

  {/* 4. Interactive Legend Bar */}
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8 px-4 py-3 rounded-2xl bg-card border border-black-150 dark:border-black-800 text-xs text-muted-foreground shadow-xs">
    <div class="flex items-center gap-3.5 flex-wrap">
      <span class="font-bold uppercase tracking-wider text-[10px] text-foreground">Graph Legend:</span>
      <div class="flex items-center gap-1.5">
        <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-ghost-accent text-black border border-black/20">Recommended</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-semibold border border-dashed border-border text-muted-foreground">Optional</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="size-2 rounded-full bg-emerald-500"></span>
        <span>Beginner</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="size-2 rounded-full bg-blue-500"></span>
        <span>Intermediate</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="size-2 rounded-full bg-purple-500"></span>
        <span>Advanced</span>
      </div>
    </div>

    <div class="flex items-center gap-3 text-[11px]">
      <span class="flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-medium">
        <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
        Done
      </span>
      <span>•</span>
      <span class="flex items-center gap-1 text-amber-600 dark:text-amber-400 font-medium">
        <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        In Progress
      </span>
      <span>•</span>
      <span class="text-foreground font-semibold">Use J/K or click cards to explore</span>
    </div>
  </div>

  {/* 5. VIEW MODE A: Zigzag Tree / Graph Canvas */}
  <div class="view-panel active relative" id="flowchartCanvas">
    
    {/* Start Landmark Node */}
    <div class="flex flex-col items-center mb-8">
      <div class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-ghost-accent text-black shadow-xs">
        <svg class="size-3.5 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
        </svg>
        Curriculum Start
      </div>
      <div class="w-0.5 h-6 bg-dashed border-l-2 border-black-300 dark:border-black-700"></div>
    </div>

    {/* Phases Zigzag Tree List */}
    <div class="space-y-12" id="flowchartModules">
      {roadmap.data.nodes?.map((section, sIdx) => {
        const stepNumber = String(sIdx + 1).padStart(2, '0');
        const sectionTotal = section.topics?.length ?? 0;

        return (
          <div class="roadmap-module relative" data-module-id={section.id}>
            
            {/* Phase Milestone Header Card (Centered) */}
            <div class="max-w-2xl mx-auto mb-6 p-4 sm:p-5 rounded-2xl border border-black-150 dark:border-black-800 bg-card/90 backdrop-blur-xs text-center shadow-xs">
              <div class="inline-flex items-center gap-2 mb-2">
                <span class="size-7 rounded-xl bg-black-100 dark:bg-black-800 text-foreground font-serif font-bold text-xs flex items-center justify-center border border-black-200 dark:border-black-700 shadow-2xs">
                  {stepNumber}
                </span>
                <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground">
                  Phase {stepNumber}
                </span>
                <span class="module-progress-badge text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-secondary text-secondary-foreground" data-total={sectionTotal}>
                  0/{sectionTotal} completed
                </span>
              </div>

              <h2 class="text-xl sm:text-2xl font-serif font-medium text-foreground tracking-tight">
                {section.title}
              </h2>

              {section.description && (
                <p class="text-xs text-muted-foreground mt-1.5 font-body max-w-lg mx-auto">
                  {section.description}
                </p>
              )}

              {/* Phase Quick Actions */}
              <div class="mt-3 flex items-center justify-center gap-2">
                <button 
                  type="button" 
                  class="mark-phase-btn text-[11px] font-semibold px-3 py-1 rounded-lg border border-black-150 dark:border-black-800 bg-secondary/70 hover:bg-secondary text-foreground transition-all cursor-pointer shadow-2xs"
                  data-phase-id={section.id}
                  title="Toggle all topics in this phase as completed"
                >
                  Mark Phase Done
                </button>
              </div>
            </div>

            {/* Vertical connector down from Phase Milestone into the tree */}
            <div class="flex justify-center mb-6">
              <div class="w-0.5 h-6 bg-dashed border-l-2 border-black-300 dark:border-black-700"></div>
            </div>

            {/* Alternating Zigzag Tree Container */}
            <div class="zigzag-tree-wrapper relative py-2">
              
              {/* Central Spine Line (Desktop md+) */}
              <div class="hidden md:block absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-0.5 border-l-2 border-dashed border-black-200 dark:border-black-800 pointer-events-none"></div>

              {/* Left Spine Line (Mobile < md) */}
              <div class="block md:hidden absolute left-5 top-0 bottom-0 w-0.5 border-l-2 border-dashed border-black-200 dark:border-black-800 pointer-events-none"></div>

              {/* Topics Grid (Zigzag Alternating Left & Right) */}
              <div class="space-y-6 md:space-y-8">
                {section.topics?.map((topic, tIdx) => {
                  const isEven = tIdx % 2 === 0;
                  const topicSlug = slugify(topic.name);
                  const hours = parseDurationHours(topic.duration);

                  const diffDotColors = {
                    beginner: 'bg-emerald-500',
                    intermediate: 'bg-blue-500',
                    advanced: 'bg-purple-500',
                  };
                  const dotColor = diffDotColors[topic.difficulty as keyof typeof diffDotColors] || 'bg-emerald-500';

                  return (
                    <div 
                      class={`topic-node-wrapper relative ${
                        isEven 
                          ? 'md:w-[calc(50%-2.25rem)] md:mr-auto md:ml-0 ml-12' 
                          : 'md:w-[calc(50%-2.25rem)] md:ml-auto md:mr-0 ml-12'
                      }`}
                      id={`topic-node-${topicSlug}`}
                    >
                      {/* Branching Connector & Waypoint (Desktop - Left items connect to the right) */}
                      {isEven ? (
                        <>
                          <div class="hidden md:block absolute -right-9 top-1/2 -translate-y-1/2 w-9 h-0.5 border-t-2 border-dashed border-black-200 dark:border-black-800 pointer-events-none transition-colors connector-line"></div>
                          <div class="hidden md:flex absolute -right-11 top-1/2 -translate-y-1/2 size-4 rounded-full border-2 border-black-300 dark:border-black-700 bg-background items-center justify-center pointer-events-none z-10 transition-colors waypoint-dot">
                            <span class="size-1.5 rounded-full bg-muted-foreground dot-inner"></span>
                          </div>
                        </>
                      ) : (
                        <>
                          <div class="hidden md:block absolute -left-9 top-1/2 -translate-y-1/2 w-9 h-0.5 border-t-2 border-dashed border-black-200 dark:border-black-800 pointer-events-none transition-colors connector-line"></div>
                          <div class="hidden md:flex absolute -left-11 top-1/2 -translate-y-1/2 size-4 rounded-full border-2 border-black-300 dark:border-black-700 bg-background items-center justify-center pointer-events-none z-10 transition-colors waypoint-dot">
                            <span class="size-1.5 rounded-full bg-muted-foreground dot-inner"></span>
                          </div>
                        </>
                      )}

                      {/* Mobile Branch Connector & Waypoint (< md) */}
                      <div class="block md:hidden absolute -left-7 top-1/2 -translate-y-1/2 w-7 h-0.5 border-t-2 border-dashed border-black-200 dark:border-black-800 pointer-events-none connector-line"></div>
                      <div class="flex md:hidden absolute -left-9 top-1/2 -translate-y-1/2 size-4 rounded-full border-2 border-black-300 dark:border-black-700 bg-background items-center justify-center pointer-events-none z-10 waypoint-dot">
                        <span class="size-1.5 rounded-full bg-muted-foreground dot-inner"></span>
                      </div>

                      {/* Topic Card */}
                      <div 
                        class={`topic-node group relative rounded-2xl border p-4 transition-all duration-200 cursor-pointer bg-card border-black-150 dark:border-black-800 hover:border-primary/60 hover:shadow-md ${topic.optional ? 'border-dashed' : ''}`}
                        data-topic-name={topic.name}
                        data-topic-slug={topicSlug}
                        data-difficulty={topic.difficulty}
                        data-optional={topic.optional ? 'true' : 'false'}
                        data-duration-hours={hours}
                        tabindex="0"
                      >
                        <div class="flex flex-col justify-between gap-2.5">
                          <div>
                            {/* Card Badges & Star Button */}
                            <div class="flex items-center justify-between gap-2 mb-1.5">
                              <div class="flex items-center gap-1.5 flex-wrap">
                                <span class={`size-2 rounded-full ${dotColor} shrink-0`}></span>
                                <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                                  {topic.difficulty}
                                </span>
                                {topic.optional ? (
                                  <span class="text-[10px] font-semibold uppercase px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20">
                                    Optional
                                  </span>
                                ) : (
                                  <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full bg-ghost-accent text-black border border-black/20">
                                    Recommended
                                  </span>
                                )}
                                {topic.duration && (
                                  <span class="text-[10px] text-muted-foreground font-medium">
                                    • {topic.duration}
                                  </span>
                                )}
                              </div>

                              {/* Star / Bookmark Topic Button */}
                              <button 
                                type="button"
                                class="star-topic-btn p-1 rounded-md text-muted-foreground hover:text-amber-500 transition-colors cursor-pointer"
                                title="Star topic"
                                aria-label="Star topic"
                              >
                                <svg class="size-3.5 star-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                </svg>
                              </button>
                            </div>

                            {/* Title */}
                            <h3 class="text-base font-serif font-medium text-foreground group-hover:text-primary transition-colors leading-snug">
                              {topic.name}
                            </h3>

                            {/* Description (collapsible in compact mode) */}
                            {topic.description && (
                              <p class="topic-description text-xs text-muted-foreground mt-1 line-clamp-2 leading-relaxed font-body">
                                {topic.description}
                              </p>
                            )}
                          </div>

                          {/* Action Buttons Row */}
                          <div class="flex items-center justify-between gap-2 pt-2 border-t border-black-150 dark:border-black-800/80">
                            {/* Status Quick-Toggle Button */}
                            <button 
                              type="button" 
                              class="status-toggle-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold border transition-all cursor-pointer bg-secondary hover:bg-secondary/80 text-foreground border-black-150 dark:border-black-800 shadow-2xs"
                              title="Click to cycle status: Todo -> Done -> In Progress -> Skip"
                            >
                              <span class="status-icon-box">
                                <span class="size-2 rounded-full bg-muted-foreground inline-block"></span>
                              </span>
                              <span class="status-text capitalize">Todo</span>
                            </button>

                            {/* Details Button */}
                            <button 
                              type="button" 
                              class="topic-details-btn p-1.5 rounded-xl text-muted-foreground hover:text-foreground hover:bg-secondary border border-black-150 dark:border-black-800 transition-colors cursor-pointer shadow-2xs"
                              title="Open study notes & blueprint"
                              aria-label="Open topic details"
                            >
                              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10" />
                                <path d="M12 16v-4" />
                                <path d="M12 8h.01" />
                              </svg>
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>

            {/* Connecting transit line down to next module */}
            {sIdx < (roadmap.data.nodes?.length ?? 0) - 1 && (
              <div class="flex justify-center my-6">
                <div class="w-0.5 h-8 bg-dashed border-l-2 border-black-300 dark:border-black-700"></div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>

  {/* 6. VIEW MODE B: Syllabus Checklist Guide */}
  <div class="view-panel hidden space-y-6" id="syllabusCanvas">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-bold uppercase tracking-wider text-muted-foreground">
        Curriculum Breakdown
      </h2>
      <button 
        type="button" 
        id="btnToggleAllPhases"
        class="text-xs font-semibold px-3 py-1.5 rounded-xl border border-black-150 dark:border-black-800 bg-card hover:bg-secondary text-muted-foreground hover:text-foreground transition-colors cursor-pointer shadow-2xs"
      >
        Collapse All Phases
      </button>
    </div>

    {roadmap.data.nodes?.map((section, sIdx) => {
      const stepNumber = String(sIdx + 1).padStart(2, '0');
      const sectionTotal = section.topics?.length ?? 0;

      return (
        <div class="syllabus-phase-card rounded-2xl border border-black-150 dark:border-black-800 bg-card overflow-hidden shadow-xs" data-phase-id={section.id}>
          {/* Phase Header */}
          <div class="p-5 sm:p-6 bg-black-50/50 dark:bg-black-900/40 border-b border-black-150 dark:border-black-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-3.5">
              <div class="size-9 rounded-xl bg-ghost-accent text-black font-serif font-bold text-sm flex items-center justify-center shrink-0 shadow-xs">
                {stepNumber}
              </div>
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <h2 class="text-lg sm:text-xl font-serif font-medium text-foreground tracking-tight">
                    {section.title}
                  </h2>
                  <span class="syllabus-phase-badge text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-secondary text-secondary-foreground" data-total={sectionTotal}>
                    0/{sectionTotal} completed
                  </span>
                </div>
                {section.description && (
                  <p class="text-xs text-muted-foreground mt-1 font-body max-w-2xl">
                    {section.description}
                  </p>
                )}
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <button 
                type="button" 
                class="mark-phase-btn text-xs font-semibold px-3 py-1.5 rounded-xl border border-black-150 dark:border-black-800 bg-card hover:bg-secondary text-foreground transition-colors cursor-pointer"
                data-phase-id={section.id}
              >
                Mark Phase Done
              </button>
              <button 
                type="button" 
                class="syllabus-toggle-phase-btn text-xs font-semibold px-3 py-1.5 rounded-xl border border-black-150 dark:border-black-800 bg-card hover:bg-secondary text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
              >
                Collapse
              </button>
            </div>
          </div>

          {/* Phase Topic Items List */}
          <div class="syllabus-phase-body divide-y divide-black-150 dark:divide-black-800 p-2 sm:p-4 space-y-3">
            {section.topics?.map((topic) => {
              const topicSlug = slugify(topic.name);
              const hours = parseDurationHours(topic.duration);

              return (
                <div 
                  class="syllabus-topic-item rounded-xl p-4 transition-all hover:bg-secondary/40"
                  data-topic-name={topic.name}
                  data-topic-slug={topicSlug}
                  data-difficulty={topic.difficulty}
                  data-optional={topic.optional ? 'true' : 'false'}
                  data-duration-hours={hours}
                >
                  <div class="flex items-start gap-3.5">
                    {/* Direct Status Checkbox */}
                    <button 
                      type="button"
                      class="syllabus-checkbox-btn mt-1 size-5 rounded-md border border-black-300 dark:border-black-600 flex items-center justify-center shrink-0 cursor-pointer bg-card hover:border-emerald-500 transition-colors"
                      title="Toggle completed status"
                    >
                      <svg class="size-3.5 text-white opacity-0 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                    </button>

                    <div class="flex-1 min-w-0">
                      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-1.5">
                        <div class="flex items-center gap-2 flex-wrap">
                          <h3 class="syllabus-topic-title text-base font-serif font-medium text-foreground">
                            {topic.name}
                          </h3>
                          <span class="text-[10px] font-semibold uppercase px-2 py-0.5 rounded-md bg-secondary text-secondary-foreground">
                            {topic.difficulty}
                          </span>
                          {topic.optional && (
                            <span class="text-[10px] font-semibold uppercase px-2 py-0.5 rounded-md bg-amber-500/10 text-amber-700 dark:text-amber-400">
                              Optional
                            </span>
                          )}
                          {topic.duration && (
                            <span class="text-[11px] text-muted-foreground font-medium">
                              ⏱️ {topic.duration}
                            </span>
                          )}
                        </div>

                        <button 
                          type="button"
                          class="open-drawer-syllabus-btn inline-flex items-center gap-1 text-xs font-semibold text-primary hover:underline cursor-pointer"
                        >
                          <span>Open Notes &amp; Resources</span>
                          <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14" />
                            <path d="M12 5l7 7-7 7" />
                          </svg>
                        </button>
                      </div>

                      {topic.description && (
                        <p class="text-xs text-muted-foreground leading-relaxed font-body mb-3">
                          {topic.description}
                        </p>
                      )}

                      {/* Inline Takeaways */}
                      {topic.takeaways && topic.takeaways.length > 0 && (
                        <div class="mt-2.5 p-3 rounded-xl bg-card border border-black-150 dark:border-black-800/80 text-xs">
                          <span class="font-bold text-[10px] uppercase tracking-wider text-muted-foreground block mb-2">Key Outcomes:</span>
                          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            {topic.takeaways.map((point) => (
                              <div class="flex items-start gap-2 text-foreground/90">
                                <span class="text-emerald-500 mt-0.5">✓</span>
                                <span class="leading-tight">{point}</span>
                              </div>
                            ))}
                          </div>
                        </div>
                      )}

                      {/* Direct Links */}
                      {topic.links && topic.links.length > 0 && (
                        <div class="flex items-center gap-2 mt-3 flex-wrap">
                          <span class="text-[11px] text-muted-foreground font-semibold">Links:</span>
                          {topic.links.map((link) => (
                            <a 
                              href={link.url} 
                              target="_blank" 
                              rel="noopener noreferrer" 
                              class="inline-flex items-center gap-1 text-[11px] text-foreground bg-secondary/80 hover:bg-secondary px-2.5 py-1 rounded-lg border border-black-150 dark:border-black-800 transition-colors"
                            >
                              <span>{link.title}</span>
                              <svg class="size-2.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>

  {/* Empty State when Search has no results */}
  <div id="emptySearchState" class="hidden text-center py-16 px-4 bg-card rounded-2xl border border-black-150 dark:border-black-800 mt-6 shadow-xs">
    <svg class="size-8 text-muted-foreground mx-auto mb-3 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
    <h3 class="text-base font-serif font-bold text-foreground">No matching topics found</h3>
    <p class="text-xs text-muted-foreground mt-1 max-w-sm mx-auto font-body">
      Try adjusting your search keyword or resetting the status and difficulty filters.
    </p>
    <button 
      type="button"
      id="resetFiltersBtn"
      class="mt-4 px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-ghost-accent text-black cursor-pointer shadow-xs"
    >
      Reset All Filters
    </button>
  </div>

</div>

{/* 7. Rich Slide-Over Topic Modal / Drawer */}
<div id="topicDrawerBackdrop" class="drawer-backdrop">
  <div id="topicDrawerPanel" class="drawer-panel">
    
    {/* Drawer Header */}
    <div class="px-6 py-5 border-b border-border flex justify-between items-start bg-card/80 backdrop-blur-md">
      <div class="space-y-2 max-w-[85%]">
        <div class="flex items-center gap-2 flex-wrap" id="drawerBadges">
          <span id="drawerBadgeDiff" class="px-2.5 py-0.5 rounded-full text-xs font-semibold capitalize bg-secondary text-secondary-foreground">
            Beginner
          </span>
          <span id="drawerBadgeOptional" class="hidden px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20">
            Optional
          </span>
          <span id="drawerBadgeDuration" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-secondary text-secondary-foreground">
            <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span id="drawerDurationText">45 min</span>
          </span>
          <button 
            type="button"
            id="drawerStarBtn"
            class="p-1 rounded-md text-muted-foreground hover:text-amber-500 transition-colors cursor-pointer"
            title="Star this topic"
          >
            <svg class="size-4 drawer-star-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
          </button>
        </div>
        <h2 id="drawerTopicTitle" class="text-2xl font-serif font-medium text-foreground leading-tight tracking-tight">
          Topic Title
        </h2>
      </div>

      <div class="flex items-center gap-1 -mr-2">
        {/* Share direct link */}
        <button 
          type="button" 
          id="shareTopicBtn"
          class="p-2 text-muted-foreground hover:text-foreground hover:bg-secondary rounded-full transition-colors cursor-pointer"
          title="Copy permalink to this topic"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
          </svg>
        </button>

        {/* Close Drawer Button */}
        <button 
          type="button" 
          id="closeDrawerBtn" 
          aria-label="Close topic drawer"
          class="p-2 text-muted-foreground hover:text-foreground hover:bg-secondary rounded-full transition-colors cursor-pointer"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
    </div>

    {/* Roadmap Status Switcher Toolbar */}
    <div class="px-6 py-3 bg-secondary/40 border-b border-border flex items-center justify-between gap-2 overflow-x-auto text-xs">
      <span class="font-semibold text-muted-foreground shrink-0 flex items-center gap-1.5">
        <svg class="size-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
        </svg>
        Status:
      </span>
      <div class="flex items-center gap-1.5 shrink-0" id="drawerStatusBtnGroup">
        <button 
          type="button" 
          id="drawerStatusDone"
          class="drawer-status-btn inline-flex items-center gap-1 px-3 py-1 rounded-lg font-semibold transition-all cursor-pointer bg-card hover:bg-secondary border border-border text-foreground"
        >
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
          <span>Done</span>
        </button>
        <button 
          type="button" 
          id="drawerStatusLearning"
          class="drawer-status-btn inline-flex items-center gap-1 px-3 py-1 rounded-lg font-semibold transition-all cursor-pointer bg-card hover:bg-secondary border border-border text-foreground"
        >
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>In Progress</span>
        </button>
        <button 
          type="button" 
          id="drawerStatusSkip"
          class="drawer-status-btn inline-flex items-center gap-1 px-3 py-1 rounded-lg font-semibold transition-all cursor-pointer bg-card hover:bg-secondary border border-border text-muted-foreground"
        >
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 4 15 12 5 20 5 4"/><line x1="19" y1="5" x2="19" y2="19"/></svg>
          <span>Skip</span>
        </button>
        <button 
          type="button" 
          id="drawerStatusTodo"
          title="Reset status to Todo"
          class="p-1 text-muted-foreground hover:text-foreground rounded-lg hover:bg-secondary transition-colors cursor-pointer"
        >
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        </button>
      </div>
    </div>

    {/* Navigation Tabs (Overview, My Study Notes, Resources) */}
    <div class="flex border-b border-border px-6 bg-card/30">
      <button 
        type="button" 
        id="tabBtnOverview" 
        class="tab-nav-btn active py-3 mr-6 text-sm font-semibold border-b-2 transition-colors cursor-pointer border-primary text-primary"
      >
        Overview
      </button>
      <button 
        type="button" 
        id="tabBtnNotes" 
        class="tab-nav-btn py-3 mr-6 text-sm font-semibold border-b-2 transition-colors cursor-pointer border-transparent text-muted-foreground hover:text-foreground flex items-center gap-1.5"
      >
        <span>My Notes</span>
        <span id="notesIndicator" class="size-2 rounded-full bg-emerald-500 hidden"></span>
      </button>
      <button 
        type="button" 
        id="tabBtnResources" 
        class="tab-nav-btn py-3 text-sm font-semibold border-b-2 transition-colors cursor-pointer border-transparent text-muted-foreground hover:text-foreground"
      >
        Resources &amp; Guides
        <span id="resourcesCountBadge" class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] bg-secondary text-secondary-foreground font-mono">0</span>
      </button>
    </div>

    {/* Drawer Scrollable Content */}
    <div class="flex-1 overflow-y-auto p-6 space-y-6">
      
      {/* Tab 1: Overview */}
      <div id="tabContentOverview" class="space-y-6">
        <div>
          <h3 class="text-xs font-bold font-serif uppercase tracking-wider text-muted-foreground mb-2 flex items-center gap-1.5">
