  </button>
</div>

{/* Embedded JSON Data for Instant Native Topic Lookup */}
<script type="application/json" id="roadmap-data" set:html={JSON.stringify(roadmap.data.nodes || [])} />

</RoadmapLayout>

<style>
  /* Sticky Toolbar positioning across all viewports */
  #stickyToolbar {
    top: calc(var(--site-header-height, 7.25rem) + 0.75rem);
  }
  @media (min-width: 768px) {
    #stickyToolbar {
      top: calc(var(--site-header-height, 7.75rem) + 0.75rem);
    }
  }

  /* Toolbar Top Section (Progress bar + all settings/buttons) */
  #toolbarTopSection {
