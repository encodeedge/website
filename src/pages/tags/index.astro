---
// src/pages/topics/index.astro
import { getCollection } from 'astro:content';

import { Background } from '@/components/background';
import { SITE_TITLE } from '@/consts';
import DefaultLayout from '@/layouts/DefaultLayout.astro';


//const topicMap = new Map(TOPIC_OPTIONS.map(t => [t.value, t.label]));


const allPosts = await getCollection('blog');

// Calculate counts for each unique topic slug
const tagCounts = allPosts.reduce((acc, post) => {
    // Iterate over the array of topics for each post
    (post.data.tags || []).forEach(tagSlug => {
        if (!acc[tagSlug]) {
            acc[tagSlug] = {
                count: 0,
                // Use the predefined label for consistent display
                label: tagSlug, 
                slug: tagSlug,
            };
        }
        acc[tagSlug].count++;
    });
    return acc;
}, {} as Record<string, { count: number; label: string; slug: string }>);

// Convert to an array and sort by topic name
const tags = Object.values(tagCounts).sort((a, b) => a.label.localeCompare(b.label));

const title = `All Tags | ${SITE_TITLE}`;
const description = 'A directory of all AI and ML tags covered on this blog.';

---

<DefaultLayout title={title} description={description}>
    <div class="py-12 md:py-16 max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <span class="inline-block text-xs font-semibold uppercase tracking-wider bg-black-100 dark:bg-black-800 text-muted-foreground px-3 py-1 rounded-full mb-3">
                Index
            </span>
            <h1 class="text-4xl sm:text-5xl font-bold font-display tracking-tight text-foreground mb-4">
                Explore by Tag
            </h1>
            <p class="text-base sm:text-lg text-muted-foreground font-body">
                Browse through all topic tags, keywords, and foundational concepts across all publications.
            </p>
        </div>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
            {tags.map(tag => (
                <a 
                    href={`/tags/${tag.slug}`} 
                    class="group block p-5 border border-black-200 dark:border-black-800 rounded-2xl bg-card hover:bg-black-50 dark:hover:bg-black-850 hover:border-black-300 dark:hover:border-black-700 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
                >
                    <div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1">
                        Tag
                    </div>
                    <h2 class="text-base sm:text-lg font-bold font-display text-foreground group-hover:text-primary transition-colors truncate">
                        #{tag.label}
                    </h2>
                    <p class="mt-2 text-xs text-muted-foreground font-body">
                        {tag.count} {tag.count === 1 ? 'article' : 'articles'}
                    </p>
                </a>
            ))}
        </div>
    </div>
</DefaultLayout>