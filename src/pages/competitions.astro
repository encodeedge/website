---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { CompetitionsHub } from '@/components/interactive/CompetitionsHub';
import { Trophy, Sparkles, Flame, ExternalLink, Rss } from 'lucide-react';
import { getCollection } from 'astro:content';
import { getAggregatedCompetitions, type Competition } from '@/lib/competitions';

// Load Keystatic curated competitions
const keystaticRaw = await getCollection('competitions').catch(() => []);
const keystaticCompetitions: Competition[] = (keystaticRaw || []).map((entry: any) => {
  const data = entry.data;
  const deadlineDate = data.deadline ? new Date(data.deadline) : new Date(Date.now() + 30 * 86400000);
  const now = new Date();
  const diffTime = deadlineDate.getTime() - now.getTime();
  const isPast = diffTime <= 0;
  const daysRemaining = isPast ? 0 : Math.ceil(diffTime / (1000 * 60 * 60 * 24));

  const platformNameMap: Record<string, string> = {
    kaggle: 'Kaggle',
    hackerrank: 'HackerRank',
    drivendata: 'DrivenData',
    huggingface: 'Hugging Face',
    zindi: 'Zindi',
    aicrowd: 'AIcrowd',
    custom: 'Partner Challenge',
  };

  return {
    id: entry.id,
    title: data.title,
    slug: entry.id,
    platform: data.platform || 'custom',
    platformName: platformNameMap[data.platform] || 'Partner Challenge',
    url: data.url,
    description: data.description || '',
    problemStatement: data.problemStatement,
    category: data.category || 'NLP & LLMs',
    difficulty: data.difficulty || 'Intermediate',
    prizePool: data.prizePool || '$10,000',
    prizeAmountUSD: data.prizeAmountUSD || 0,
    rewardType: data.rewardType || 'cash',
    teamsCount: data.teamsCount || 0,
    deadline: data.deadline || deadlineDate.toISOString().split('T')[0],
    daysRemaining,
    status: isPast ? 'completed' : (data.status || (daysRemaining <= 7 ? 'ending-soon' : 'active')),
    tags: data.tags || ['AI', 'Machine Learning'],
    featured: data.featured ?? false,
    evaluationMetric: data.evaluationMetric,
    datasetSize: undefined,
    hostName: data.hostName || 'EncodeEdge Community',
  };
});

// Aggregate competitions respecting Keystatic Sources singleton settings & limits
const { competitions, sourcesSettings } = await getAggregatedCompetitions(keystaticCompetitions);
const enableSync = sourcesSettings?.displaySettings?.enableCompetitionsSync ?? true;
const autoSync = sourcesSettings?.displaySettings?.autoSyncCompetitions ?? true;
const hideCompleted = sourcesSettings?.displaySettings?.hideCompletedCompetitions ?? true;
---

<DefaultLayout 
  title="Active AI & ML Competitions | Kaggle, HackerRank, DrivenData & Zindi | EncodeEdge" 
  description="Discover live AI/ML competitions, data science hackathons, and benchmarks across Kaggle, HackerRank, DrivenData, Hugging Face, and Zindi. Filter by track, cash prizes, and deadlines."
>
  <div class="py-8 md:py-16 container mx-auto px-4 max-w-6xl space-y-12">
    {/* Hero Section */}
    <div class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold">
        <Trophy class="size-3.5" />
        <span>Multi-Platform AI/ML Aggregator</span>
        <span class="size-1.5 rounded-full bg-amber-500 animate-pulse ml-0.5"></span>
      </div>

      <h1 class="text-4xl md:text-5xl font-extrabold font-display text-foreground tracking-tight leading-tight">
        Active AI &amp; ML <span class="text-primary">Competitions</span>
      </h1>

      <p class="text-sm md:text-base text-muted-foreground leading-relaxed">
        Test your algorithmic models against real-world benchmarks. Aggregated active challenges, prize pools, and community leaderboards across <strong class="text-foreground">Kaggle</strong>, <strong class="text-foreground">HackerRank</strong>, <strong class="text-foreground">DrivenData</strong>, <strong class="text-foreground">Hugging Face</strong>, and <strong class="text-foreground">Zindi</strong>.
      </p>
    </div>

    {/* Interactive Competitions Hub Component */}
    <section>
      <CompetitionsHub 
        client:load 
        initialCompetitions={competitions} 
        enableSync={enableSync}
        autoSync={autoSync}
        hideCompleted={hideCompleted}
      />
    </section>
  </div>
</DefaultLayout>
