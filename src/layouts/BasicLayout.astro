---
import BaseHead from "@/components/BaseHead.astro";
import { Footer } from "@/components/blocks/footer";
import { Navbar } from "@/components/blocks/navbar";
import GoogleAnalytics from "@/components/analytics/GoogleAnalytics.astro";
import GoogleTagManager from "@/components/analytics/GoogleTagManager.astro";

import { getNavigationSettings } from "@/lib/settings";

const { title, description } = Astro.props;
const navSettings = await getNavigationSettings();
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.0.1/dist/cookieconsent.css" />
    <!-- Google Tag Manager (Keystatic-controlled container) -->
    <GoogleTagManager part="head" />
    <!-- Google Analytics 4 (Keystatic-controlled & consent-aware) -->
    <GoogleAnalytics />
  </head>
  <body class="min-h-screen flex flex-col antialiased bg-background text-foreground">
    <!-- Google Tag Manager (noscript body fallback) -->
    <GoogleTagManager part="body" />
    <Navbar 
      client:load 
      navLinks={navSettings.navLinks}
      enableSearch={navSettings.showSearch}
      showSubscribeButton={navSettings.showSubscribeButton}
      subscribeButtonText={navSettings.subscribeButtonText}
      subscribeButtonUrl={navSettings.subscribeButtonUrl}
    />
    <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16 w-full">
      <article class="prose prose-lg dark:prose-invert max-w-none font-body">
        <slot />
      </article>
    </main>
    <Footer />
    <script type="module" src="/scripts/cookieconsent-config.js"></script>
  </body>

</html>
