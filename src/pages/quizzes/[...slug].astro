---
import { getCollection } from 'astro:content';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { InteractiveQuiz } from '@/components/ui/interactive-quiz';
import { CourseNavigation } from '@/components/ui/course-navigation';
import { getCoursesMap } from '@/utils/course-map';

export async function getStaticPaths() {
  const quizzes = await getCollection('quizzes');
  return quizzes.map(quiz => ({
    params: { slug: quiz.id },
    props: { quiz },
  }));
}

const { quiz } = Astro.props;
const coursesMap = await getCoursesMap();
---

<DefaultLayout title={`${quiz.data.title} | Quiz`} description={quiz.data.description || quiz.data.title}>
  <div class="max-w-4xl mx-auto px-4 py-12 md:py-16">
    <CourseNavigation coursesMap={coursesMap} currentItemId={quiz.id} itemType="quiz" mode="top" client:load />

    <div class="mb-8 mt-6">
      <div class="flex items-center gap-4 mb-3">
        <span class="woords_tag_small">Quiz</span>
        {quiz.data.questions && (
          <span class="text-xs font-semibold text-muted-foreground">
            {quiz.data.questions.length} questions
          </span>
        )}
      </div>
      <h1 class="font-display font-bold text-3xl md:text-5xl tracking-tight text-foreground mb-3 leading-tight">
        {quiz.data.title}
      </h1>
      {quiz.data.description && (
        <p class="text-base sm:text-lg text-muted-foreground max-w-2xl leading-relaxed">
          {quiz.data.description}
        </p>
      )}
    </div>

    {quiz.data.questions && (
      <div class="my-8">
        <InteractiveQuiz questions={quiz.data.questions} client:load />
      </div>
    )}

    <CourseNavigation coursesMap={coursesMap} currentItemId={quiz.id} itemType="quiz" mode="bottom" client:load />
  </div>
</DefaultLayout>
