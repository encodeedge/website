---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { 
  ShieldCheck, 
  Award, 
  Calendar, 
  CheckCircle2, 
  Copy, 
  ExternalLink, 
  Share2, 
  ArrowLeft,
  Building,
  GraduationCap,
  Sparkles
} from 'lucide-react';
import { getCollection } from 'astro:content';

const { id } = Astro.params;

// Search params for dynamic student info
const url = new URL(Astro.request.url);
const studentName = url.searchParams.get('student') || 'Verified Student';
const courseParam = url.searchParams.get('course') || 'applied-deep-learning';
const grade = url.searchParams.get('grade') || 'With Distinction';

const courses = await getCollection('courses');
const matchedCourse = courses.find(c => c.id === courseParam) || courses[0];

const courseTitle = matchedCourse?.data?.title || 'Applied Deep Learning: From Foundations to Transformers';
const instructor = matchedCourse?.data?.instructor || 'Atul Jha';
const issueDate = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const skills = [
  'Deep Neural Networks',
  'PyTorch Autograd & Tensors',
  'Convolutional Architectures & ResNet',
  'Scaled Dot-Product Self-Attention',
  'High-Performance CUDA Inference'
];
---

<DefaultLayout 
  title={`Credential Verification: ${id} | EncodeEdge Academy`}
  description={`Official verified credential for ${studentName} in ${courseTitle}. Issued by EncodeEdge.`}
>
  <div class="py-12 md:py-20 container mx-auto px-4 max-w-3xl space-y-8">
    
    {/* Back link */}
    <div>
      <a 
        href="/courses" 
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors"
      >
        <ArrowLeft className="size-3.5" />
        <span>Back to All Courses</span>
      </a>
    </div>

    {/* Verification Card */}
    <div class="rounded-3xl border border-border/80 bg-card overflow-hidden shadow-lg">
      
      {/* Verified Banner */}
      <div class="bg-gradient-to-r from-emerald-500/15 via-emerald-500/10 to-transparent border-b border-emerald-500/20 p-6 sm:p-8 flex items-center justify-between flex-wrap gap-4">
        <div class="flex items-center gap-3.5">
          <div class="size-12 rounded-2xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 shrink-0 shadow-xs">
            <ShieldCheck className="size-6" />
          </div>
          <div>
            <span class="text-[11px] font-extrabold uppercase tracking-widest text-emerald-600 dark:text-emerald-400 block">
              Official Verified Credential
            </span>
            <h1 class="text-xl sm:text-2xl font-extrabold font-display text-foreground">
              EncodeEdge Certificate of Mastery
            </h1>
          </div>
        </div>

        <div class="px-3.5 py-1.5 rounded-full bg-card border border-border/80 text-xs font-mono font-bold text-foreground shadow-xs">
          ID: {id}
        </div>
      </div>

      <div class="p-6 sm:p-10 space-y-8">
        
        {/* Recipient Details */}
        <div class="space-y-2 border-b border-border/60 pb-6 text-center sm:text-left">
          <span class="text-xs text-muted-foreground uppercase font-semibold tracking-wider">
            This certifies that
          </span>
          <h2 class="text-3xl sm:text-4xl font-black font-display text-foreground tracking-tight">
            {studentName}
          </h2>
          <p class="text-sm sm:text-base text-muted-foreground font-body max-w-xl">
            has successfully fulfilled all curriculum requirements, passed hands-on coding labs, and demonstrated practical mastery in:
          </p>
          <div class="text-lg sm:text-xl font-bold font-display text-primary pt-1">
            {courseTitle}
          </div>
        </div>

        {/* Credential Attributes 2x2 Grid */}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div class="p-4 rounded-2xl bg-muted/20 border border-border/60 space-y-1">
            <span class="text-muted-foreground font-semibold flex items-center gap-1.5">
              <Calendar className="size-3.5 text-primary" /> Issue Date
            </span>
            <div class="font-bold text-sm text-foreground">{issueDate}</div>
            <div class="text-[11px] text-muted-foreground">Permanent Lifetime Credential</div>
          </div>

          <div class="p-4 rounded-2xl bg-muted/20 border border-border/60 space-y-1">
            <span class="text-muted-foreground font-semibold flex items-center gap-1.5">
              <Award className="size-3.5 text-amber-500" /> Academic Standing
            </span>
            <div class="font-bold text-sm text-foreground">{grade}</div>
            <div class="text-[11px] text-muted-foreground">Top Quartile Performance</div>
          </div>

          <div class="p-4 rounded-2xl bg-muted/20 border border-border/60 space-y-1">
            <span class="text-muted-foreground font-semibold flex items-center gap-1.5">
              <GraduationCap className="size-3.5 text-blue-500" /> Instructor
            </span>
            <div class="font-bold text-sm text-foreground">{instructor}</div>
            <div class="text-[11px] text-muted-foreground">EncodeEdge Curriculum Lead</div>
          </div>

          <div class="p-4 rounded-2xl bg-muted/20 border border-border/60 space-y-1">
            <span class="text-muted-foreground font-semibold flex items-center gap-1.5">
              <Building className="size-3.5 text-purple-500" /> Issuing Organization
            </span>
            <div class="font-bold text-sm text-foreground">EncodeEdge Academy</div>
            <div class="text-[11px] text-muted-foreground">Verified Educational Authority</div>
          </div>
        </div>

        {/* Competencies Validated */}
        <div class="space-y-3">
          <h3 class="text-xs font-bold text-foreground uppercase tracking-wider flex items-center gap-1.5">
            <Sparkles className="size-3.5 text-primary" /> Competencies & Skills Validated
          </h3>
          <div class="flex flex-wrap gap-2">
            {skills.map((skill, sIdx) => (
              <span 
                key={sIdx}
                class="px-3 py-1.5 rounded-xl bg-card border border-border/80 text-xs font-semibold text-foreground flex items-center gap-1.5 shadow-xs"
              >
                <CheckCircle2 className="size-3 text-emerald-500" />
                <span>{skill}</span>
              </span>
            ))}
          </div>
        </div>

        {/* Action Buttons */}
        <div class="pt-4 border-t border-border/60 flex items-center justify-between flex-wrap gap-3">
          <div class="flex items-center gap-2">
            <a
              href={`https://www.linkedin.com/profile/add?startTask=CERTIFICATION_NAME&name=${encodeURIComponent(courseTitle)}&organizationName=EncodeEdge&issueYear=${new Date().getFullYear()}&issueMonth=${new Date().getMonth() + 1}&certId=${id}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2.5 rounded-xl bg-[#0A66C2] hover:bg-[#004182] text-white text-xs font-bold shadow-sm transition-colors inline-flex items-center gap-1.5 cursor-pointer"
            >
              <ExternalLink className="size-3.5" />
              <span>Add to LinkedIn Profile</span>
            </a>
          </div>

          <a
            href="/dashboard"
            class="px-4 py-2.5 rounded-xl bg-muted hover:bg-muted/80 text-foreground text-xs font-semibold border border-border/80 transition-colors inline-flex items-center gap-1.5"
          >
            <span>Go to My Learning Dashboard</span>
          </a>
        </div>

      </div>
    </div>
  </div>
</DefaultLayout>
