---
import { Background } from '@/components/background';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { Badge } from "@/components/ui/badge";
import EditorialPostCover from '@/components/ui/EditorialPostCover.astro';

const notebooks = await Astro.glob<any>('./*.astro');
const filteredNotebooks = notebooks
  .filter((n) => !n.file.endsWith('index.astro'))
  .map((n) => {
    const frontmatter = n.frontmatter || n;
    const url = n.url;
    const slug = url?.split('/').filter(Boolean).pop() || '';
    const title = frontmatter?.title || slug
      .split('-')
      .map((word: string) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');

    return {
      title,
      description: frontmatter?.description || '',
      image: frontmatter?.image,
      tags: Array.isArray(frontmatter?.tags) ? frontmatter.tags : [],
      topics: Array.isArray(frontmatter?.topics) ? frontmatter.topics : [],
      authorName: frontmatter?.authorName,
      authorImage: frontmatter?.authorImage,
      url,
    };
  });
---

<DefaultLayout title="Notebooks" description="Index of all notebooks">
	<div class="py-12 md:py-16 max-w-6xl mx-auto px-4 sm:px-6">
		<div class="text-center max-w-2xl mx-auto mb-12">
			<span class="inline-block text-xs font-semibold uppercase tracking-wider bg-black-100 dark:bg-black-800 text-muted-foreground px-3 py-1 rounded-full mb-3">
				Interactive Code
			</span>
			<h1 class="text-4xl sm:text-5xl font-bold font-display tracking-tight text-foreground mb-4">
				Jupyter Notebooks
			</h1>
			<p class="text-base sm:text-lg text-muted-foreground font-body">
				Explore runnable notebooks, hands-on experiments, and annotated code implementations.
			</p>
		</div>

		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{filteredNotebooks.map((notebook) => (
				<div class="rounded-2xl border border-black-200 dark:border-black-800 bg-card overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
					<div>
						<a href={notebook.url} class="block group">
							<div class="p-2.5">
								<EditorialPostCover
									post={{
										id: notebook.url?.split('/').filter(Boolean).pop() || 'notebook',
										data: {
											title: notebook.title,
											topics: notebook.topics.length ? notebook.topics : ['python'],
											tags: notebook.tags,
											readTime: 12,
										}
									}}
									variant="card"
									class="!mb-0 w-full"
								/>
							</div>
							<div class="px-4 pt-2 pb-3">
								<h2 class="text-xl font-bold font-display text-foreground group-hover:text-primary transition-colors leading-snug mb-2">
									{notebook.title}
								</h2>
								{notebook.description && (
									<p class="text-muted-foreground font-body line-clamp-2 text-sm leading-relaxed">
										{notebook.description}
									</p>
								)}
							</div>
						</a>
					</div>

					<div class="px-4 pb-4 pt-2 border-t border-black-100 dark:border-black-800 space-y-3">
						{notebook.authorName && (
							<a href={`/authors/${notebook.authorName.toLowerCase().replace(/\s+/g, '-')}`} class="flex items-center gap-2 text-xs text-muted-foreground hover:text-foreground transition-colors font-medium">
								{notebook.authorImage ? (
									<img src={notebook.authorImage} alt={notebook.authorName} class="size-5 rounded-full border object-cover" />
								) : (
									<div class="size-5 rounded-full bg-black-100 dark:bg-black-800 flex items-center justify-center text-[9px] font-bold text-muted-foreground">
										{notebook.authorName.charAt(0)}
									</div>
								)}
								<span>{notebook.authorName}</span>
							</a>
						)}

						{(notebook.tags?.length > 0 || notebook.topics?.length > 0) && (
							<div class="flex flex-wrap gap-1.5">
								{notebook.tags.slice(0, 3).map((tag: string) => (
									<a href={`/tags/${tag}`} class="woords_tag text-xs">
										#{tag}
									</a>
								))}
								{notebook.topics.slice(0, 3).map((topic: string) => (
									<a href={`/topics/${topic}`} class="woords_tag text-xs">
										{topic}
									</a>
								))}
							</div>
						)}
					</div>
				</div>
			))}
		</div>
	</div>
</DefaultLayout>

