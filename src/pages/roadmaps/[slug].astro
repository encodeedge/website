</div>

{/* 11. Study Progress Modal Overlay */}
<div id="studyProgressModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="studyProgressModalTitle">
  <div class="modal-content max-w-lg p-6 sm:p-7 rounded-3xl space-y-5">
    {/* Modal Header */}
    <div class="flex items-center justify-between pb-3 border-b border-border/60">
      <div class="flex items-center gap-2.5">
        <div class="size-9 rounded-2xl bg-emerald-500/15 text-emerald-500 flex items-center justify-center shrink-0">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h3 id="studyProgressModalTitle" class="text-base sm:text-lg font-bold font-serif text-foreground">Study Progress</h3>
          <p class="text-[11px] text-muted-foreground">{roadmap.data.title}</p>
        </div>
      </div>
      <button 
        type="button" 
        id="closeStudyProgressModalBtn" 
        class="size-8 rounded-full text-muted-foreground hover:text-foreground hover:bg-secondary flex items-center justify-center cursor-pointer transition-colors"
        title="Close progress overlay"
        aria-label="Close"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    {/* Study Progress Section (Matching the top toolbar section) */}
    <div class="p-4 sm:p-5 rounded-2xl bg-secondary/50 border border-border/50 space-y-3">
      <div class="flex items-center justify-between text-xs font-semibold flex-wrap gap-1">
        <span class="text-foreground flex items-center gap-1.5">
          <svg class="size-3.5 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Study Progress:
          <span class="text-muted-foreground font-normal ml-0.5">
            <strong class="text-foreground font-semibold" id="modalCompletedCountDisplay">0</strong> of {totalTopics} completed
            <span class="mx-1 text-muted-foreground/50">•</span>
            <span id="modalCompletedHoursDisplay" class="font-semibold text-foreground">0h</span> of ~{estimatedHours}h
          </span>
        </span>
        <span class="font-mono text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400" id="modalProgressPercentDisplay">0%</span>
      </div>
      <div class="w-full h-3 rounded-full bg-black-100 dark:bg-black-800 overflow-hidden">
        <div 
          id="modalProgressBarFill" 
          class="h-full bg-linear-to-r from-emerald-500 to-teal-400 transition-all duration-300 rounded-full" 
          style="width: 0%;"
        ></div>
      </div>
    </div>

    {/* Stats Grid */}
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
      <div class="p-3 rounded-2xl bg-secondary/40 border border-border/40 text-center">
        <span class="block text-base sm:text-lg font-bold font-mono text-foreground" id="modalStatCompleted">0 / {totalTopics}</span>
        <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">Completed</span>
      </div>
      <div class="p-3 rounded-2xl bg-secondary/40 border border-border/40 text-center">
        <span class="block text-base sm:text-lg font-bold font-mono text-foreground" id="modalStatHours">0h / ~{estimatedHours}h</span>
        <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">Hours Done</span>
      </div>
      <div class="col-span-2 sm:col-span-1 p-3 rounded-2xl bg-secondary/40 border border-border/40 text-center">
        <span class="block text-base sm:text-lg font-bold font-mono text-emerald-600 dark:text-emerald-400" id="modalStatRemaining">{totalTopics} Left</span>
        <span class="text-[10px] text-muted-foreground uppercase font-semibold tracking-wider">Remaining</span>
      </div>
    </div>

    {/* Roadmap Settings & Actions in Overlay */}
    <div class="pt-3 border-t border-border/60 space-y-2.5">
      <div class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider">Settings &amp; Actions</div>
      <div class="flex items-center gap-2 flex-wrap">
        {/* Dual View Mode Toggle */}
        <div class="inline-flex p-1 rounded-xl bg-black-100 dark:bg-black-800 border border-black-150 dark:border-black-700">
          <button 
            type="button" 
            id="modalBtnViewFlowchart"
            class="view-mode-btn active inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer shadow-xs"
            title="Tree Graph View"
          >
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="5" r="3" />
              <line x1="12" y1="8" x2="12" y2="12" />
              <circle cx="6" cy="19" r="3" />
              <circle cx="18" cy="19" r="3" />
              <path d="M12 12l-6 4" />
              <path d="M12 12l6 4" />
            </svg>
            <span>Tree Graph</span>
          </button>
          <button 
            type="button" 
            id="modalBtnViewSyllabus"
            class="view-mode-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer text-muted-foreground hover:text-foreground"
            title="Syllabus Guide View"
          >
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="8" y1="6" x2="21" y2="6" />
              <line x1="8" y1="12" x2="21" y2="12" />
              <line x1="8" y1="18" x2="21" y2="18" />
              <line x1="3" y1="6" x2="3.01" y2="6" />
              <line x1="3" y1="12" x2="3.01" y2="12" />
              <line x1="3" y1="18" x2="3.01" y2="18" />
            </svg>
            <span>Syllabus Guide</span>
          </button>
        </div>

        {/* Export Button in Modal */}
        <button 
          type="button" 
          id="modalExportProgressBtn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-foreground bg-card hover:bg-secondary border border-black-150 dark:border-black-800 transition-colors cursor-pointer shadow-xs"
          title="Export progress"
        >
          <svg class="size-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Export</span>
        </button>

        {/* Reset Button in Modal */}
        <button 
          type="button" 
          id="modalResetProgressBtn"
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-semibold text-rose-600 dark:text-rose-400 bg-rose-500/10 hover:bg-rose-500/20 transition-colors cursor-pointer shrink-0"
          title="Reset progress"
        >
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Reset</span>
        </button>
      </div>
    </div>

    {/* Close Action */}
    <div class="pt-1">
      <button
        type="button"
        id="dismissStudyProgressModalBtn"
        class="w-full py-2.5 rounded-xl text-xs font-semibold bg-secondary hover:bg-secondary/80 text-foreground transition-colors cursor-pointer flex items-center justify-center gap-1.5"
      >
        <span>Close Overlay</span>
      </button>
    </div>
  </div>
</div>

{/* 12. Floating Study Progress Pill Button */}
<div 
  id="floatingProgressContainer" 
  class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-50 flex flex-col items-end floating-hidden"
>
  <button 
    type="button"
    id="floatingProgressBtn"
