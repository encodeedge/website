{/* 100% Native Script (Zero React Dependency, Guaranteed Click Activation) */}
<script is:inline>
  function initRoadmap() {
    const container = document.getElementById('roadmapContainer');
    if (!container) return;
    const slug = container.getAttribute('data-slug') || 'roadmap';
    const roadmapTitle = container.getAttribute('data-title') || 'Roadmap';

    // Parse preloaded nodes data
    const rawData = document.getElementById('roadmap-data')?.textContent || '[]';
    let nodesList = [];
    try {
      nodesList = JSON.parse(rawData);
    } catch (e) {
      console.error('Error parsing roadmap nodes data:', e);
    }

    const topicsMap = new Map();
    const allTopicsList = [];
    nodesList.forEach((sec) => {
      sec.topics?.forEach((t) => {
        t.sectionId = sec.id;
        t.sectionTitle = sec.title;
        topicsMap.set(t.name, t);
        allTopicsList.push(t);
      });
    });

    const estimatedHours = parseInt(container.getAttribute('data-estimated-hours') || '0', 10) || 
      Math.max(10, Math.round(allTopicsList.reduce((acc, t) => acc + (t.durationHours || 2), 0)));

    // LocalStorage State Sets
    let completedTopics = new Set(JSON.parse(localStorage.getItem(`completedTopics_${slug}`) || '[]'));
    let learningTopics = new Set(JSON.parse(localStorage.getItem(`learningTopics_${slug}`) || '[]'));
    let skippedTopics = new Set(JSON.parse(localStorage.getItem(`skippedTopics_${slug}`) || '[]'));
    let starredTopics = new Set(JSON.parse(localStorage.getItem(`starredTopics_${slug}`) || '[]'));

    const topicNodes = Array.from(document.querySelectorAll('.topic-node'));
    const syllabusItems = Array.from(document.querySelectorAll('.syllabus-topic-item'));
    const totalTopicsCount = topicNodes.length;

    // Ensure header height CSS variable is accurately measured immediately
    function syncHeaderHeight() {
      const header = document.querySelector('header');
      if (header) {
        const h = Math.round(header.getBoundingClientRect().height || header.offsetHeight);
        if (h > 0) {
          document.documentElement.style.setProperty('--site-header-height', h + 'px');
        }
      }
    }
    syncHeaderHeight();

    // Elements
    const completedCountEl = document.getElementById('completedCountDisplay');
    const completedHoursEl = document.getElementById('completedHoursDisplay');
    const progressPercentEl = document.getElementById('progressPercentDisplay');
    const progressBarFillEl = document.getElementById('progressBarFill');
    const starredFilterCountEl = document.getElementById('starredFilterCount');

    // Floating Progress Bar & Study Progress Modal Controls
    const floatingContainer = document.getElementById('floatingProgressContainer');
    const floatingBtn = document.getElementById('floatingProgressBtn');
    const floatingProgressCircle = document.getElementById('floatingProgressCircle');
    const floatingPillPercent = document.getElementById('floatingPillPercent');
    const floatingPillCount = document.getElementById('floatingPillCount');

    // Study Progress Modal Elements
    const studyProgressModal = document.getElementById('studyProgressModal');
    const closeStudyProgressModalBtn = document.getElementById('closeStudyProgressModalBtn');
    const dismissStudyProgressModalBtn = document.getElementById('dismissStudyProgressModalBtn');
    const modalCompletedCountDisplay = document.getElementById('modalCompletedCountDisplay');
    const modalCompletedHoursDisplay = document.getElementById('modalCompletedHoursDisplay');
    const modalProgressPercentDisplay = document.getElementById('modalProgressPercentDisplay');
    const modalProgressBarFill = document.getElementById('modalProgressBarFill');
    const modalStatCompleted = document.getElementById('modalStatCompleted');
    const modalStatHours = document.getElementById('modalStatHours');
    const modalStatRemaining = document.getElementById('modalStatRemaining');

    function updateFloatingProgress(pct, completed, hours) {
      if (floatingPillPercent) floatingPillPercent.textContent = `${pct}%`;
      if (floatingPillCount) floatingPillCount.textContent = `(${completed}/${totalTopicsCount})`;
      if (floatingProgressCircle) {
        floatingProgressCircle.setAttribute('stroke-dasharray', `${pct}, 100`);
      }

      // Sync modal elements
      if (modalCompletedCountDisplay) modalCompletedCountDisplay.textContent = `${completed}`;
      if (modalCompletedHoursDisplay) modalCompletedHoursDisplay.textContent = `${hours}h`;
      if (modalProgressPercentDisplay) modalProgressPercentDisplay.textContent = `${pct}%`;
      if (modalProgressBarFill) modalProgressBarFill.style.width = `${pct}%`;
      if (modalStatCompleted) modalStatCompleted.textContent = `${completed} / ${totalTopicsCount}`;
      if (modalStatHours) modalStatHours.textContent = `${hours}h / ~${estimatedHours}h`;
      if (modalStatRemaining) {
        const left = Math.max(0, totalTopicsCount - completed);
        modalStatRemaining.textContent = `${left} Left`;
      }
    }

    // Floating Progress Bar & Study Progress Modal Overlay Controls
    function handleScrollFloatingProgress() {
      if (!floatingContainer) return;
      const isMobile = window.innerWidth < 768;
      const topSection = document.getElementById('toolbarTopSection') || document.getElementById('topStudyProgressBar');

      if (isMobile) {
        // Mobile: Always display secondary floating button at bottom and hide that entire top section
        floatingContainer.classList.remove('floating-hidden', 'translate-y-16', 'opacity-0', 'pointer-events-none');
        floatingContainer.classList.add('floating-visible');
        if (topSection) {
          topSection.classList.add('toolbar-top-collapsed');
          topSection.style.setProperty('display', 'none', 'important');
        }
        return;
      }

      // Desktop / Tablet (md+):
      // Show top section when scroll is at top (scrollY <= 50).
      // As soon as user scrolls past that section (scrollY > 50), hide that full section and animate into floating button at bottom
      const passedSection = window.scrollY > 50;

      if (passedSection) {
        floatingContainer.classList.remove('floating-hidden', 'translate-y-16', 'opacity-0', 'pointer-events-none');
        floatingContainer.classList.add('floating-visible');
        if (topSection) {
          topSection.classList.add('toolbar-top-collapsed');
          topSection.style.setProperty('display', 'none', 'important');
        }
      } else {
        floatingContainer.classList.add('floating-hidden');
        floatingContainer.classList.remove('floating-visible');
        if (topSection) {
          topSection.classList.remove('toolbar-top-collapsed');
          topSection.style.removeProperty('display');
        }
      }
    }

    window.addEventListener('scroll', handleScrollFloatingProgress, { passive: true });
    document.addEventListener('scroll', handleScrollFloatingProgress, { passive: true });
    window.addEventListener('resize', handleScrollFloatingProgress, { passive: true });
    handleScrollFloatingProgress();

    function openStudyProgressModal() {
      if (studyProgressModal) {
        studyProgressModal.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeStudyProgressModal() {
      if (studyProgressModal) {
        studyProgressModal.classList.remove('open');
        document.body.style.overflow = '';
      }
    }

    floatingBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      openStudyProgressModal();
    });

    closeStudyProgressModalBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeStudyProgressModal();
    });

    dismissStudyProgressModalBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeStudyProgressModal();
    });

    studyProgressModal?.addEventListener('click', (e) => {
      if (e.target === studyProgressModal) {
        closeStudyProgressModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && studyProgressModal?.classList.contains('open')) {
        closeStudyProgressModal();
      }
    });

    // Wire Modal Settings Buttons to main toolbar actions
    const modalBtnViewFlowchart = document.getElementById('modalBtnViewFlowchart');
    const modalBtnViewSyllabus = document.getElementById('modalBtnViewSyllabus');
    const modalExportProgressBtn = document.getElementById('modalExportProgressBtn');
    const modalResetProgressBtn = document.getElementById('modalResetProgressBtn');

    modalBtnViewFlowchart?.addEventListener('click', () => {
      document.getElementById('btnViewFlowchart')?.click();
      modalBtnViewFlowchart.classList.add('active');
      modalBtnViewSyllabus?.classList.remove('active');
    });

    modalBtnViewSyllabus?.addEventListener('click', () => {
      document.getElementById('btnViewSyllabus')?.click();
      modalBtnViewSyllabus.classList.add('active');
      modalBtnViewFlowchart?.classList.remove('active');
    });

    modalExportProgressBtn?.addEventListener('click', () => {
      document.getElementById('exportProgressBtn')?.click();
    });

    modalResetProgressBtn?.addEventListener('click', () => {
      closeStudyProgressModal();
      document.getElementById('openResetModalBtn')?.click();
    });

    // Next Up Banner
    const nextUpBanner = document.getElementById('nextUpBanner');
    const nextUpTitle = document.getElementById('nextUpTitle');
    const nextUpDiffBadge = document.getElementById('nextUpDiffBadge');
    const nextUpDurationBadge = document.getElementById('nextUpDurationBadge');
    const nextUpActionBtn = document.getElementById('nextUpActionBtn');
    let currentNextUpTopic = null;

    // View & Density Switchers
    const btnViewFlowchart = document.getElementById('btnViewFlowchart');
    const btnViewSyllabus = document.getElementById('btnViewSyllabus');
    const flowchartCanvas = document.getElementById('flowchartCanvas');
    const syllabusCanvas = document.getElementById('syllabusCanvas');
    const btnToggleDensity = document.getElementById('btnToggleDensity');
    const densityToggleText = document.getElementById('densityToggleText');

    // Drawer Elements
    const drawerBackdrop = document.getElementById('topicDrawerBackdrop');
    const closeDrawerBtn = document.getElementById('closeDrawerBtn');
    const shareTopicBtn = document.getElementById('shareTopicBtn');
    const drawerStarBtn = document.getElementById('drawerStarBtn');

    const drawerBadgeDiff = document.getElementById('drawerBadgeDiff');
    const drawerBadgeOptional = document.getElementById('drawerBadgeOptional');
    const drawerDurationText = document.getElementById('drawerDurationText');
    const drawerTopicTitle = document.getElementById('drawerTopicTitle');
    const drawerDescription = document.getElementById('drawerDescription');

    const drawerCodeSection = document.getElementById('drawerCodeSection');
    const drawerCodeText = document.getElementById('drawerCodeText');
    const copyCodeBtn = document.getElementById('copyCodeBtn');
    const copyCodeText = document.getElementById('copyCodeText');

    const drawerTakeawaysSection = document.getElementById('drawerTakeawaysSection');
    const drawerTakeawaysList = document.getElementById('drawerTakeawaysList');
    const takeawaysProgressBadge = document.getElementById('takeawaysProgressBadge');

    const drawerPrereqsSection = document.getElementById('drawerPrereqsSection');
    const drawerPrereqsList = document.getElementById('drawerPrereqsList');

    const tabBtnOverview = document.getElementById('tabBtnOverview');
    const tabBtnNotes = document.getElementById('tabBtnNotes');
    const tabBtnResources = document.getElementById('tabBtnResources');
    const tabContentOverview = document.getElementById('tabContentOverview');
    const tabContentNotes = document.getElementById('tabContentNotes');
    const tabContentResources = document.getElementById('tabContentResources');
    const resourcesCountBadge = document.getElementById('resourcesCountBadge');
    const notesIndicator = document.getElementById('notesIndicator');

    const topicNoteTextarea = document.getElementById('topicNoteTextarea');
    const noteSavedStatus = document.getElementById('noteSavedStatus');
    const noteCharCount = document.getElementById('noteCharCount');
    const clearNoteBtn = document.getElementById('clearNoteBtn');

    const drawerVideoSection = document.getElementById('drawerVideoSection');
    const drawerVideoLink = document.getElementById('drawerVideoLink');
    const drawerLinksSection = document.getElementById('drawerLinksSection');
    const drawerLinksContainer = document.getElementById('drawerLinksContainer');
    const drawerRefsSection = document.getElementById('drawerRefsSection');
    const drawerRefsContainer = document.getElementById('drawerRefsContainer');
    const drawerNoResources = document.getElementById('drawerNoResources');
    const drawerEncodeEdgeSearchLink = document.getElementById('drawerEncodeEdgeSearchLink');

    const drawerStatusDone = document.getElementById('drawerStatusDone');
    const drawerStatusLearning = document.getElementById('drawerStatusLearning');
    const drawerStatusSkip = document.getElementById('drawerStatusSkip');
    const drawerStatusTodo = document.getElementById('drawerStatusTodo');

    let currentActiveTopic = null;
    let noteSaveTimeout = null;
    let focusedTopicIndex = -1;

    function slugifyStr(str) {
      return (str || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    }

    function getTopicStatus(name) {
      if (completedTopics.has(name)) return 'done';
      if (learningTopics.has(name)) return 'learning';
      if (skippedTopics.has(name)) return 'skipped';
      return 'todo';
    }

    function setTopicStatus(name, status) {
      completedTopics.delete(name);
      learningTopics.delete(name);
      skippedTopics.delete(name);

      if (status === 'done') completedTopics.add(name);
      else if (status === 'learning') learningTopics.add(name);
      else if (status === 'skipped') skippedTopics.add(name);

      try {
        localStorage.setItem(`completedTopics_${slug}`, JSON.stringify([...completedTopics]));
        localStorage.setItem(`learningTopics_${slug}`, JSON.stringify([...learningTopics]));
        localStorage.setItem(`skippedTopics_${slug}`, JSON.stringify([...skippedTopics]));
      } catch (e) {
        console.error(e);
      }

      renderAllNodes();
      updateProgress();
      updateNextUpBanner();

      if (currentActiveTopic && currentActiveTopic.name === name) {
        updateDrawerStatusButtons(status);
      }
    }

    function cycleTopicStatus(name) {
      const current = getTopicStatus(name);
      if (current === 'todo') setTopicStatus(name, 'done');
      else if (current === 'done') setTopicStatus(name, 'learning');
      else if (current === 'learning') setTopicStatus(name, 'skipped');
      else setTopicStatus(name, 'todo');
    }

    function toggleStar(name) {
      if (starredTopics.has(name)) {
        starredTopics.delete(name);
      } else {
        starredTopics.add(name);
      }
      try {
        localStorage.setItem(`starredTopics_${slug}`, JSON.stringify([...starredTopics]));
      } catch (e) {}

      renderStars();
      if (currentActiveTopic && currentActiveTopic.name === name) {
        updateDrawerStarButton();
      }
      if (activeStatus === 'starred') {
        applyFilters();
      }
    }

    function renderStars() {
      topicNodes.forEach((node) => {
        const name = node.getAttribute('data-topic-name');
        const starBtn = node.querySelector('.star-topic-btn');
        if (starBtn) {
          if (starredTopics.has(name)) {
            starBtn.classList.add('starred');
          } else {
            starBtn.classList.remove('starred');
          }
        }
      });
      if (starredFilterCountEl) {
        starredFilterCountEl.textContent = String(starredTopics.size);
      }
    }

    function updateDrawerStarButton() {
      if (!currentActiveTopic || !drawerStarBtn) return;
      if (starredTopics.has(currentActiveTopic.name)) {
        drawerStarBtn.classList.add('starred');
      } else {
        drawerStarBtn.classList.remove('starred');
      }
    }

    function renderAllNodes() {
      let completedHoursTotal = 0;

      // 1. Flowchart Nodes & Wrapper Status (for Waypoint glows)
      topicNodes.forEach((node) => {
        const name = node.getAttribute('data-topic-name');
        const status = getTopicStatus(name);
        const hours = parseFloat(node.getAttribute('data-duration-hours') || '2');
        const wrapper = node.closest('.topic-node-wrapper');

        node.classList.remove('status-done', 'status-learning', 'status-skipped');
        if (wrapper) {
          wrapper.classList.remove('status-done', 'status-learning', 'status-skipped');
        }

        const textEl = node.querySelector('.status-text');
        const iconEl = node.querySelector('.status-icon-box');

        if (status === 'done') {
          node.classList.add('status-done');
          if (wrapper) wrapper.classList.add('status-done');
          completedHoursTotal += hours;
          if (textEl) textEl.textContent = 'Done';
          if (iconEl) iconEl.innerHTML = '<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>';
        } else if (status === 'learning') {
          node.classList.add('status-learning');
          if (wrapper) wrapper.classList.add('status-learning');
          if (textEl) textEl.textContent = 'In Progress';
          if (iconEl) iconEl.innerHTML = '<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
        } else if (status === 'skipped') {
          node.classList.add('status-skipped');
          if (wrapper) wrapper.classList.add('status-skipped');
          if (textEl) textEl.textContent = 'Skipped';
          if (iconEl) iconEl.innerHTML = '<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 4 15 12 5 20 5 4"/><line x1="19" y1="5" x2="19" y2="19"/></svg>';
        } else {
          if (textEl) textEl.textContent = 'Todo';
          if (iconEl) iconEl.innerHTML = '<span class="size-2 rounded-full bg-muted-foreground inline-block"></span>';
        }
      });

      // 2. Syllabus Items
      syllabusItems.forEach((item) => {
        const name = item.getAttribute('data-topic-name');
        const status = getTopicStatus(name);

        item.classList.remove('status-done', 'status-learning', 'status-skipped');
        if (status === 'done') {
          item.classList.add('status-done');
        }
      });

      // 3. Module Milestone Counters & Mark Phase Buttons
      document.querySelectorAll('.roadmap-module').forEach((mod) => {
        const nodes = Array.from(mod.querySelectorAll('.topic-node'));
        const doneCount = nodes.filter((n) => completedTopics.has(n.getAttribute('data-topic-name'))).length;
        const badge = mod.querySelector('.module-progress-badge');
        const phaseBtn = mod.querySelector('.mark-phase-btn');

        if (badge) {
          badge.textContent = `${doneCount}/${nodes.length} completed`;
          if (doneCount === nodes.length && nodes.length > 0) {
            badge.className = 'module-progress-badge text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold';
          } else {
            badge.className = 'module-progress-badge text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-secondary text-secondary-foreground';
          }
        }

        if (phaseBtn) {
          if (doneCount === nodes.length && nodes.length > 0) {
            phaseBtn.textContent = 'Reset Phase';
            phaseBtn.classList.add('text-muted-foreground');
          } else {
            phaseBtn.textContent = 'Mark Phase Done';
            phaseBtn.classList.remove('text-muted-foreground');
          }
        }
      });

      // 4. Syllabus Phase Counters
      document.querySelectorAll('.syllabus-phase-card').forEach((phase) => {
        const items = Array.from(phase.querySelectorAll('.syllabus-topic-item'));
        const doneCount = items.filter((n) => completedTopics.has(n.getAttribute('data-topic-name'))).length;
        const badge = phase.querySelector('.syllabus-phase-badge');
        const phaseBtn = phase.querySelector('.mark-phase-btn');

        if (badge) {
          badge.textContent = `${doneCount}/${items.length} completed`;
          if (doneCount === items.length && items.length > 0) {
            badge.className = 'syllabus-phase-badge text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold';
          } else {
            badge.className = 'syllabus-phase-badge text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-secondary text-secondary-foreground';
          }
        }

        if (phaseBtn) {
          if (doneCount === items.length && items.length > 0) {
            phaseBtn.textContent = 'Reset Phase';
          } else {
            phaseBtn.textContent = 'Mark Phase Done';
          }
        }
      });

      renderStars();
    }

    function updateProgress() {
      const completedCount = completedTopics.size;
      const percent = totalTopicsCount > 0 ? Math.round((completedCount / totalTopicsCount) * 100) : 0;

      // Compute total completed hours
      let doneHours = 0;
      allTopicsList.forEach((t) => {
        if (completedTopics.has(t.name)) {
          doneHours += (t.durationHours || 2);
        }
      });
      const roundedDoneHours = Math.round(doneHours);

      if (completedCountEl) completedCountEl.textContent = String(completedCount);
      if (completedHoursEl) completedHoursEl.textContent = `${roundedDoneHours}h`;
      if (progressPercentEl) progressPercentEl.textContent = `${percent}%`;
      if (progressBarFillEl) progressBarFillEl.style.width = `${percent}%`;
      updateFloatingProgress(percent, completedCount, roundedDoneHours);

      // ── Achievements integration ──────────────────────────────────────
      window.dispatchEvent(new CustomEvent('ee_roadmap_progress', {
        detail: { completedCount, totalCount: totalTopicsCount, percent }
      }));
    }

    function updateNextUpBanner() {
      if (!nextUpBanner) return;

      // First check if there is an in-progress topic
      let candidate = allTopicsList.find((t) => learningTopics.has(t.name));

      // If not, find the first todo topic
      if (!candidate) {
        candidate = allTopicsList.find((t) => !completedTopics.has(t.name) && !skippedTopics.has(t.name));
      }

      currentNextUpTopic = candidate;

      if (!candidate) {
        // All completed!
        if (nextUpTitle) nextUpTitle.textContent = 'Curriculum 100% Completed!';
        if (nextUpDiffBadge) nextUpDiffBadge.textContent = 'Mastered';
        if (nextUpDurationBadge) nextUpDurationBadge.textContent = '🎉 All Done';
        const labelEl = document.getElementById('nextUpLabel');
        if (labelEl) labelEl.textContent = 'Celebration';
        if (nextUpActionBtn) {
          const span = nextUpActionBtn.querySelector('span');
          if (span) span.textContent = 'Export Progress';
        }
      } else {
        const isLearning = learningTopics.has(candidate.name);
        const labelEl = document.getElementById('nextUpLabel');
        if (labelEl) labelEl.textContent = isLearning ? 'Currently In Progress' : 'Recommended Next Step';

        if (nextUpTitle) nextUpTitle.textContent = candidate.name;
        if (nextUpDiffBadge) nextUpDiffBadge.textContent = candidate.difficulty || 'Beginner';
        if (nextUpDurationBadge) nextUpDurationBadge.textContent = `⏱️ ${candidate.duration || '2 hours'}`;
        if (nextUpActionBtn) {
          const span = nextUpActionBtn.querySelector('span');
          if (span) span.textContent = isLearning ? 'Continue Topic' : 'Start Topic';
        }
      }
    }

    nextUpActionBtn?.addEventListener('click', () => {
      if (!currentNextUpTopic) {
        document.getElementById('exportProgressBtn')?.click();
        return;
      }
      openDrawer(currentNextUpTopic);

      // Scroll to topic node
      const slugName = slugifyStr(currentNextUpTopic.name);
      const target = document.getElementById(`topic-node-${slugName}`);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    // Mark Entire Phase Action
    document.querySelectorAll('.mark-phase-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const phaseId = btn.getAttribute('data-phase-id');
        const phaseData = nodesList.find((s) => s.id === phaseId);
        if (!phaseData || !phaseData.topics) return;

        const phaseTopicNames = phaseData.topics.map((t) => t.name);
        const allDone = phaseTopicNames.every((n) => completedTopics.has(n));

        if (allDone) {
          // Reset all to todo
          phaseTopicNames.forEach((n) => {
            completedTopics.delete(n);
            learningTopics.delete(n);
            skippedTopics.delete(n);
          });
        } else {
          // Mark all as done
          phaseTopicNames.forEach((n) => {
            completedTopics.add(n);
            learningTopics.delete(n);
            skippedTopics.delete(n);
          });
        }

        try {
          localStorage.setItem(`completedTopics_${slug}`, JSON.stringify([...completedTopics]));
          localStorage.setItem(`learningTopics_${slug}`, JSON.stringify([...learningTopics]));
          localStorage.setItem(`skippedTopics_${slug}`, JSON.stringify([...skippedTopics]));
        } catch (err) {}

        renderAllNodes();
        updateProgress();
        updateNextUpBanner();
        showToast(allDone ? 'Phase reset to Todo.' : 'Phase marked as complete!');
      });
    });

    // View Switching
    function setViewMode(mode) {
      if (mode === 'syllabus') {
        btnViewSyllabus?.classList.add('active');
        btnViewFlowchart?.classList.remove('active');
        flowchartCanvas?.classList.add('hidden');
        syllabusCanvas?.classList.remove('hidden');
        try { localStorage.setItem(`roadmap_view_${slug}`, 'syllabus'); } catch (e) {}
      } else {
        btnViewFlowchart?.classList.add('active');
        btnViewSyllabus?.classList.remove('active');
        flowchartCanvas?.classList.remove('hidden');
        syllabusCanvas?.classList.add('hidden');
        try { localStorage.setItem(`roadmap_view_${slug}`, 'flowchart'); } catch (e) {}
      }
    }

    btnViewFlowchart?.addEventListener('click', () => setViewMode('flowchart'));
    btnViewSyllabus?.addEventListener('click', () => setViewMode('syllabus'));

    // Restore saved view preference
    const savedView = localStorage.getItem(`roadmap_view_${slug}`);
    if (savedView === 'syllabus') {
      setViewMode('syllabus');
    }

    // Visual Density Toggle
    let isCompact = localStorage.getItem(`roadmap_density_${slug}`) === 'compact';
    function updateDensityUI() {
      if (isCompact) {
        flowchartCanvas?.classList.add('density-compact');
        if (densityToggleText) densityToggleText.textContent = 'Detailed';
      } else {
        flowchartCanvas?.classList.remove('density-compact');
        if (densityToggleText) densityToggleText.textContent = 'Compact';
      }
    }
    btnToggleDensity?.addEventListener('click', () => {
      isCompact = !isCompact;
      try { localStorage.setItem(`roadmap_density_${slug}`, isCompact ? 'compact' : 'detailed'); } catch (e) {}
      updateDensityUI();
    });
    updateDensityUI();

    // Syllabus Phase collapse buttons & Global Toggle All
    document.querySelectorAll('.syllabus-toggle-phase-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.syllabus-phase-card');
        const body = card?.querySelector('.syllabus-phase-body');
        if (body) {
          const isCollapsed = body.style.display === 'none';
          body.style.display = isCollapsed ? '' : 'none';
          btn.textContent = isCollapsed ? 'Collapse' : 'Expand';
        }
      });
    });

    const btnToggleAllPhases = document.getElementById('btnToggleAllPhases');
    let allPhasesExpanded = true;
    btnToggleAllPhases?.addEventListener('click', () => {
      allPhasesExpanded = !allPhasesExpanded;
      document.querySelectorAll('.syllabus-phase-card').forEach((card) => {
        const body = card.querySelector('.syllabus-phase-body');
        const btn = card.querySelector('.syllabus-toggle-phase-btn');
        if (body) {
          body.style.display = allPhasesExpanded ? '' : 'none';
        }
        if (btn) {
          btn.textContent = allPhasesExpanded ? 'Collapse' : 'Expand';
        }
      });
      btnToggleAllPhases.textContent = allPhasesExpanded ? 'Collapse All Phases' : 'Expand All Phases';
    });

    // Checkpoints in Drawer
    function loadTakeawaysChecklist(topic) {
      if (!drawerTakeawaysList) return;
      const key = `roadmap_takeaways_${slug}_${encodeURIComponent(topic.name)}`;
      let checkedIndices = new Set();
      try {
        checkedIndices = new Set(JSON.parse(localStorage.getItem(key) || '[]'));
      } catch (e) {}

      const total = topic.takeaways?.length || 0;
      if (takeawaysProgressBadge) {
        takeawaysProgressBadge.textContent = `${checkedIndices.size}/${total} checkpoints`;
      }

      drawerTakeawaysList.innerHTML = (topic.takeaways || []).map((point, idx) => {
        const isChecked = checkedIndices.has(idx);
        return `
          <li class="flex items-start gap-3 text-xs text-foreground/90 bg-card p-3 rounded-xl border border-border cursor-pointer hover:border-primary/40 transition-all group" data-idx="${idx}">
            <input 
              type="checkbox" 
              class="takeaway-checkbox mt-0.5 size-4 rounded text-primary focus:ring-primary/20 cursor-pointer accent-emerald-600" 
              ${isChecked ? 'checked' : ''} 
            />
            <span class="leading-snug select-none ${isChecked ? 'line-through text-muted-foreground' : ''}">${point}</span>
          </li>
        `;
      }).join('');

      drawerTakeawaysList.querySelectorAll('li').forEach((li) => {
        li.addEventListener('click', (e) => {
          const checkbox = li.querySelector('.takeaway-checkbox');
          if (e.target !== checkbox) {
            checkbox.checked = !checkbox.checked;
          }
          const idx = parseInt(li.getAttribute('data-idx') || '0', 10);
          const span = li.querySelector('span');

          if (checkbox.checked) {
            checkedIndices.add(idx);
            span?.classList.add('line-through', 'text-muted-foreground');
          } else {
            checkedIndices.delete(idx);
            span?.classList.remove('line-through', 'text-muted-foreground');
          }

          try {
            localStorage.setItem(key, JSON.stringify([...checkedIndices]));
          } catch (err) {}

          if (takeawaysProgressBadge) {
            takeawaysProgressBadge.textContent = `${checkedIndices.size}/${total} checkpoints`;
          }
        });
      });
    }

    // Study Notes in Drawer
    function loadTopicNotes(topic) {
      const noteKey = `roadmap_note_${slug}_${encodeURIComponent(topic.name)}`;
      const saved = localStorage.getItem(noteKey) || '';
      if (topicNoteTextarea) {
        topicNoteTextarea.value = saved;
      }
      if (noteCharCount) {
        noteCharCount.textContent = `${saved.length} characters`;
      }
      if (notesIndicator) {
        notesIndicator.style.display = saved.trim().length > 0 ? 'inline-block' : 'none';
      }
    }

    function saveTopicNotes() {
      if (!currentActiveTopic || !topicNoteTextarea) return;
      const noteKey = `roadmap_note_${slug}_${encodeURIComponent(currentActiveTopic.name)}`;
      const val = topicNoteTextarea.value;
      try {
        localStorage.setItem(noteKey, val);
      } catch (e) {}

      if (noteSavedStatus) {
        noteSavedStatus.textContent = 'Saved!';
        setTimeout(() => {
          if (noteSavedStatus) noteSavedStatus.textContent = 'Auto-saved locally';
        }, 1500);
      }
      if (noteCharCount) {
        noteCharCount.textContent = `${val.length} characters`;
      }
      if (notesIndicator) {
        notesIndicator.style.display = val.trim().length > 0 ? 'inline-block' : 'none';
      }
    }

    topicNoteTextarea?.addEventListener('input', () => {
      if (noteSavedStatus) noteSavedStatus.textContent = 'Saving...';
      clearTimeout(noteSaveTimeout);
      noteSaveTimeout = setTimeout(saveTopicNotes, 400);
    });

    clearNoteBtn?.addEventListener('click', () => {
      if (!currentActiveTopic || !topicNoteTextarea) return;
      if (confirm('Clear notes for this topic?')) {
        topicNoteTextarea.value = '';
        saveTopicNotes();
      }
    });

    function updateDrawerStatusButtons(status) {
      const allBtns = [drawerStatusDone, drawerStatusLearning, drawerStatusSkip];
      allBtns.forEach((b) => {
        if (b) {
          b.className = 'drawer-status-btn inline-flex items-center gap-1 px-3 py-1 rounded-lg font-semibold transition-all cursor-pointer bg-card hover:bg-secondary border border-border text-foreground';
        }
      });

      if (status === 'done' && drawerStatusDone) {
        drawerStatusDone.className = 'drawer-status-btn inline-flex items-center gap-1 px-3 py-1 rounded-lg font-semibold transition-all cursor-pointer bg-emerald-600 text-white border-emerald-600 shadow-xs';
      } else if (status === 'learning' && drawerStatusLearning) {
        drawerStatusLearning.className = 'drawer-status-btn inline-flex items-center gap-1 px-3 py-1 rounded-lg font-semibold transition-all cursor-pointer bg-amber-600 text-white border-amber-600 shadow-xs';
      } else if (status === 'skipped' && drawerStatusSkip) {
        drawerStatusSkip.className = 'drawer-status-btn inline-flex items-center gap-1 px-3 py-1 rounded-lg font-semibold transition-all cursor-pointer bg-slate-700 text-white border-slate-700 shadow-xs';
      }
    }

    function openDrawer(topic) {
      if (!topic) return;
      currentActiveTopic = topic;

      // Badges
      if (drawerBadgeDiff) drawerBadgeDiff.textContent = topic.difficulty;
      if (drawerBadgeOptional) {
        drawerBadgeOptional.style.display = topic.optional ? 'inline-block' : 'none';
      }
      if (drawerDurationText) drawerDurationText.textContent = topic.duration || '2 hours';
      if (drawerTopicTitle) drawerTopicTitle.textContent = topic.name;
      if (drawerDescription) drawerDescription.textContent = topic.description || '';

      // Update URL hash for deep linking without jumping
      const topicSlug = slugifyStr(topic.name);
      history.replaceState(null, '', `#${topicSlug}`);

      // Code Section
      if (topic.codeSnippet && topic.codeSnippet.trim()) {
        if (drawerCodeSection) drawerCodeSection.classList.remove('hidden');
        if (drawerCodeText) drawerCodeText.textContent = topic.codeSnippet;
      } else {
        if (drawerCodeSection) drawerCodeSection.classList.add('hidden');
      }

      // Takeaways & Checkpoints
      if (topic.takeaways && topic.takeaways.length > 0) {
        if (drawerTakeawaysSection) drawerTakeawaysSection.classList.remove('hidden');
        loadTakeawaysChecklist(topic);
      } else {
        if (drawerTakeawaysSection) drawerTakeawaysSection.classList.add('hidden');
      }

      // Prerequisites
      if (topic.prerequisites && topic.prerequisites.length > 0) {
        if (drawerPrereqsSection) drawerPrereqsSection.classList.remove('hidden');
        if (drawerPrereqsList) {
          drawerPrereqsList.innerHTML = topic.prerequisites.map((req) => `
            <li class="flex items-center gap-2 text-xs text-muted-foreground bg-secondary/40 px-3 py-2 rounded-xl">
              <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
              <span>${req}</span>
            </li>
          `).join('');
        }
      } else {
        if (drawerPrereqsSection) drawerPrereqsSection.classList.add('hidden');
      }

      // Resources Tab Data
      let resCount = 0;
      if (topic.videoUrl) resCount++;
      if (topic.links) resCount += topic.links.length;
      if (topic.references) resCount += topic.references.length;

      if (resourcesCountBadge) resourcesCountBadge.textContent = String(resCount);

      if (topic.videoUrl) {
        if (drawerVideoSection) drawerVideoSection.classList.remove('hidden');
        if (drawerVideoLink) drawerVideoLink.href = topic.videoUrl;
      } else {
        if (drawerVideoSection) drawerVideoSection.classList.add('hidden');
      }

      if (topic.links && topic.links.length > 0) {
        if (drawerLinksSection) drawerLinksSection.classList.remove('hidden');
        if (drawerLinksContainer) {
          drawerLinksContainer.innerHTML = topic.links.map((link) => `
            <a href="${link.url}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3.5 rounded-xl border border-border bg-card hover:border-primary/50 hover:bg-secondary/40 transition-all group">
              <span class="text-xs font-medium text-foreground group-hover:text-primary transition-colors">${link.title}</span>
              <svg class="size-3.5 text-muted-foreground group-hover:text-primary transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          `).join('');
        }
      } else {
        if (drawerLinksSection) drawerLinksSection.classList.add('hidden');
      }

      if (topic.references && topic.references.length > 0) {
        if (drawerRefsSection) drawerRefsSection.classList.remove('hidden');
        if (drawerRefsContainer) {
          drawerRefsContainer.innerHTML = topic.references.map((ref) => `
            <a href="${ref.url}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-2.5 rounded-xl border border-border/60 text-xs text-muted-foreground hover:text-foreground hover:border-border transition-colors group">
              <span>${ref.title}</span>
              <svg class="size-3 opacity-60 group-hover:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          `).join('');
        }
      } else {
        if (drawerRefsSection) drawerRefsSection.classList.add('hidden');
      }

      if (drawerEncodeEdgeSearchLink) {
        drawerEncodeEdgeSearchLink.href = `/blog?q=${encodeURIComponent(topic.name)}`;
      }

      if (resCount === 0) {
        if (drawerNoResources) drawerNoResources.classList.remove('hidden');
      } else {
        if (drawerNoResources) drawerNoResources.classList.add('hidden');
      }

      // Load personal notes
      loadTopicNotes(topic);

      // Star status
      updateDrawerStarButton();

      // Default to Overview Tab
      switchTab('overview');

      // Update status buttons in drawer
      updateDrawerStatusButtons(getTopicStatus(topic.name));

      // Show drawer
      if (drawerBackdrop) drawerBackdrop.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (drawerBackdrop) drawerBackdrop.classList.remove('open');
      document.body.style.overflow = '';
      currentActiveTopic = null;
    }

    function switchTab(tab) {
      [tabBtnOverview, tabBtnNotes, tabBtnResources].forEach((b) => {
        b?.classList.remove('border-primary', 'text-primary');
        b?.classList.add('border-transparent', 'text-muted-foreground');
      });
      [tabContentOverview, tabContentNotes, tabContentResources].forEach((c) => {
        c?.classList.add('hidden');
      });

      if (tab === 'notes') {
        tabBtnNotes?.classList.add('border-primary', 'text-primary');
        tabBtnNotes?.classList.remove('border-transparent', 'text-muted-foreground');
        tabContentNotes?.classList.remove('hidden');
      } else if (tab === 'resources') {
        tabBtnResources?.classList.add('border-primary', 'text-primary');
        tabBtnResources?.classList.remove('border-transparent', 'text-muted-foreground');
        tabContentResources?.classList.remove('hidden');
      } else {
        tabBtnOverview?.classList.add('border-primary', 'text-primary');
        tabBtnOverview?.classList.remove('border-transparent', 'text-muted-foreground');
        tabContentOverview?.classList.remove('hidden');
      }
    }

    tabBtnOverview?.addEventListener('click', () => switchTab('overview'));
    tabBtnNotes?.addEventListener('click', () => switchTab('notes'));
    tabBtnResources?.addEventListener('click', () => switchTab('resources'));

    drawerStarBtn?.addEventListener('click', () => {
      if (currentActiveTopic) {
        toggleStar(currentActiveTopic.name);
      }
    });

    shareTopicBtn?.addEventListener('click', () => {
      if (!currentActiveTopic) return;
      const url = `${window.location.origin}${window.location.pathname}#${slugifyStr(currentActiveTopic.name)}`;
      navigator.clipboard.writeText(url);
      showToast('Direct link copied to clipboard!');
    });

    // Attach listeners to Flowchart cards
    topicNodes.forEach((node, idx) => {
      const topicName = node.getAttribute('data-topic-name');
      const toggleBtn = node.querySelector('.status-toggle-btn');
      const detailsBtn = node.querySelector('.topic-details-btn');
      const starBtn = node.querySelector('.star-topic-btn');

      node.addEventListener('click', (e) => {
        if (e.target.closest('.status-toggle-btn') || e.target.closest('.star-topic-btn')) return;
        const topicData = topicsMap.get(topicName) || { name: topicName, description: '', difficulty: 'beginner' };
        openDrawer(topicData);
      });

      if (toggleBtn) {
        toggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          cycleTopicStatus(topicName);
        });
      }

      if (starBtn) {
        starBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleStar(topicName);
        });
      }

      if (detailsBtn) {
        detailsBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const topicData = topicsMap.get(topicName) || { name: topicName, description: '', difficulty: 'beginner' };
          openDrawer(topicData);
        });
      }
    });

    // Attach listeners to Syllabus Guide items
    syllabusItems.forEach((item) => {
      const topicName = item.getAttribute('data-topic-name');
      const chkBtn = item.querySelector('.syllabus-checkbox-btn');
      const openBtn = item.querySelector('.open-drawer-syllabus-btn');

      chkBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const cur = getTopicStatus(topicName);
        setTopicStatus(topicName, cur === 'done' ? 'todo' : 'done');
      });

      openBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const topicData = topicsMap.get(topicName) || { name: topicName, description: '', difficulty: 'beginner' };
        openDrawer(topicData);
      });
    });

    // Drawer status buttons
    drawerStatusDone?.addEventListener('click', () => {
      if (!currentActiveTopic) return;
      const cur = getTopicStatus(currentActiveTopic.name);
      setTopicStatus(currentActiveTopic.name, cur === 'done' ? 'todo' : 'done');
    });

    drawerStatusLearning?.addEventListener('click', () => {
      if (!currentActiveTopic) return;
      const cur = getTopicStatus(currentActiveTopic.name);
      setTopicStatus(currentActiveTopic.name, cur === 'learning' ? 'todo' : 'learning');
    });

    drawerStatusSkip?.addEventListener('click', () => {
      if (!currentActiveTopic) return;
      const cur = getTopicStatus(currentActiveTopic.name);
      setTopicStatus(currentActiveTopic.name, cur === 'skipped' ? 'todo' : 'skipped');
    });

    drawerStatusTodo?.addEventListener('click', () => {
      if (!currentActiveTopic) return;
      setTopicStatus(currentActiveTopic.name, 'todo');
    });

    closeDrawerBtn?.addEventListener('click', closeDrawer);
    drawerBackdrop?.addEventListener('click', (e) => {
      if (e.target === drawerBackdrop) closeDrawer();
    });

    // Copy Code button
    copyCodeBtn?.addEventListener('click', () => {
      if (!currentActiveTopic || !currentActiveTopic.codeSnippet) return;
      navigator.clipboard.writeText(currentActiveTopic.codeSnippet);
      if (copyCodeText) copyCodeText.textContent = 'Copied!';
      setTimeout(() => {
        if (copyCodeText) copyCodeText.textContent = 'Copy code';
      }, 2000);
    });

    // Keyboard Shortcuts Cheatsheet Modal
    const shortcutsModal = document.getElementById('shortcutsModal');
    const openShortcutsBtn = document.getElementById('openShortcutsBtn');
    const closeShortcutsBtn = document.getElementById('closeShortcutsBtn');
    const dismissShortcutsBtn = document.getElementById('dismissShortcutsBtn');

    function openShortcuts() {
      if (shortcutsModal) shortcutsModal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeShortcuts() {
      if (shortcutsModal) shortcutsModal.classList.remove('open');
      document.body.style.overflow = '';
    }
    openShortcutsBtn?.addEventListener('click', openShortcuts);
    closeShortcutsBtn?.addEventListener('click', closeShortcuts);
    dismissShortcutsBtn?.addEventListener('click', closeShortcuts);
    shortcutsModal?.addEventListener('click', (e) => {
      if (e.target === shortcutsModal) closeShortcuts();
    });

    // Keyboard Navigation
    window.addEventListener('keydown', (e) => {
      const isInputActive = document.activeElement === searchInput || document.activeElement === topicNoteTextarea || document.activeElement?.tagName === 'INPUT';

      if (e.key === 'Escape') {
        closeDrawer();
        closeResetModal();
        closeShortcuts();
      } else if (e.key === '/' && !isInputActive) {
        e.preventDefault();
        searchInput?.focus();
      } else if (!isInputActive) {
        const visibleNodes = topicNodes.filter((n) => n.style.display !== 'none');
        if (visibleNodes.length === 0) return;

        if (e.key === 'j' || e.key === 'ArrowDown') {
          e.preventDefault();
          if (focusedTopicIndex < visibleNodes.length - 1) focusedTopicIndex++;
          else focusedTopicIndex = 0;
          highlightFocusedTopic(visibleNodes);
        } else if (e.key === 'k' || e.key === 'ArrowUp') {
          e.preventDefault();
          if (focusedTopicIndex > 0) focusedTopicIndex--;
          else focusedTopicIndex = visibleNodes.length - 1;
          highlightFocusedTopic(visibleNodes);
        } else if (e.key === ' ' && focusedTopicIndex >= 0 && focusedTopicIndex < visibleNodes.length) {
          e.preventDefault();
          const target = visibleNodes[focusedTopicIndex];
          const name = target.getAttribute('data-topic-name');
          if (name) cycleTopicStatus(name);
        } else if (e.key === 'Enter' && focusedTopicIndex >= 0 && focusedTopicIndex < visibleNodes.length) {
          e.preventDefault();
          const target = visibleNodes[focusedTopicIndex];
          const name = target.getAttribute('data-topic-name');
          const topicData = topicsMap.get(name);
          if (topicData) openDrawer(topicData);
        } else if ((e.key === 's' || e.key === 'S') && focusedTopicIndex >= 0 && focusedTopicIndex < visibleNodes.length) {
          e.preventDefault();
          const target = visibleNodes[focusedTopicIndex];
          const name = target.getAttribute('data-topic-name');
          if (name) toggleStar(name);
        }
      }
    });

    function highlightFocusedTopic(visibleNodes) {
      topicNodes.forEach((n) => n.classList.remove('keyboard-focused'));
      if (focusedTopicIndex >= 0 && focusedTopicIndex < visibleNodes.length) {
        const target = visibleNodes[focusedTopicIndex];
        target.classList.add('keyboard-focused');
        target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    // Search and Filter Logic
    const searchInput = document.getElementById('topicSearchInput');
    const clearSearchBtn = document.getElementById('clearSearchBtn');
    const statusFilterBtns = Array.from(document.querySelectorAll('.status-filter-btn'));
    const levelBtns = Array.from(document.querySelectorAll('.level-btn'));
    const emptySearchState = document.getElementById('emptySearchState');
    const resetFiltersBtn = document.getElementById('resetFiltersBtn');

    let activeStatus = 'all';
    let activeLevel = 'all';
    let searchQuery = '';

    function applyFilters() {
      let visibleCount = 0;

      // Filter Flowchart cards
      topicNodes.forEach((node) => {
        const name = node.getAttribute('data-topic-name') || '';
        const diff = node.getAttribute('data-difficulty') || 'beginner';
        const isOpt = node.getAttribute('data-optional') === 'true';
        const isStar = starredTopics.has(name);
        const status = getTopicStatus(name);

        const topicData = topicsMap.get(name);
        const desc = topicData?.description || '';
        const takeaways = (topicData?.takeaways || []).join(' ');
        const fullText = `${name} ${desc} ${takeaways}`.toLowerCase();

        const matchLevel = activeLevel === 'all' || diff === activeLevel;
        let matchStatus = true;
        if (activeStatus === 'done') matchStatus = status === 'done';
        else if (activeStatus === 'learning') matchStatus = status === 'learning';
        else if (activeStatus === 'todo') matchStatus = status === 'todo';
        else if (activeStatus === 'optional') matchStatus = isOpt;
        else if (activeStatus === 'starred') matchStatus = isStar;

        const matchSearch = !searchQuery || fullText.includes(searchQuery);

        const wrapper = node.closest('.topic-node-wrapper');

        if (matchLevel && matchStatus && matchSearch) {
          node.style.display = '';
          if (wrapper) wrapper.style.display = '';
          visibleCount++;
        } else {
          node.style.display = 'none';
          if (wrapper) wrapper.style.display = 'none';
        }
      });

      // Filter Syllabus items
      syllabusItems.forEach((item) => {
        const name = item.getAttribute('data-topic-name') || '';
        const diff = item.getAttribute('data-difficulty') || 'beginner';
        const isOpt = item.getAttribute('data-optional') === 'true';
        const isStar = starredTopics.has(name);
        const status = getTopicStatus(name);

        const topicData = topicsMap.get(name);
        const desc = topicData?.description || '';
        const takeaways = (topicData?.takeaways || []).join(' ');
        const fullText = `${name} ${desc} ${takeaways}`.toLowerCase();

        const matchLevel = activeLevel === 'all' || diff === activeLevel;
        let matchStatus = true;
        if (activeStatus === 'done') matchStatus = status === 'done';
        else if (activeStatus === 'learning') matchStatus = status === 'learning';
        else if (activeStatus === 'todo') matchStatus = status === 'todo';
        else if (activeStatus === 'optional') matchStatus = isOpt;
        else if (activeStatus === 'starred') matchStatus = isStar;

        const matchSearch = !searchQuery || fullText.includes(searchQuery);

        if (matchLevel && matchStatus && matchSearch) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });

      // Show/hide entire modules in Flowchart
      document.querySelectorAll('.roadmap-module').forEach((mod) => {
        const topics = Array.from(mod.querySelectorAll('.topic-node'));
        const hasVisible = topics.some((t) => t.style.display !== 'none');
        mod.style.display = hasVisible ? '' : 'none';
      });

      // Show/hide entire phases in Syllabus
      document.querySelectorAll('.syllabus-phase-card').forEach((phase) => {
        const items = Array.from(phase.querySelectorAll('.syllabus-topic-item'));
        const hasVisible = items.some((t) => t.style.display !== 'none');
        phase.style.display = hasVisible ? '' : 'none';
      });

      if (emptySearchState) {
        emptySearchState.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      focusedTopicIndex = -1;
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target.value || '').trim().toLowerCase();
        if (clearSearchBtn) {
          clearSearchBtn.style.display = searchQuery ? 'block' : 'none';
        }
        applyFilters();
      });
    }

    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      clearSearchBtn.style.display = 'none';
      applyFilters();
    });

    statusFilterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        statusFilterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeStatus = btn.getAttribute('data-status') || 'all';
        applyFilters();
      });
    });

    levelBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        levelBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeLevel = btn.getAttribute('data-level') || 'all';
        applyFilters();
      });
    });

    resetFiltersBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      if (clearSearchBtn) clearSearchBtn.style.display = 'none';
      statusFilterBtns.forEach((b) => b.classList.remove('active'));
      statusFilterBtns[0]?.classList.add('active');
      activeStatus = 'all';
      levelBtns.forEach((b) => b.classList.remove('active'));
      levelBtns[0]?.classList.add('active');
      activeLevel = 'all';
      applyFilters();
    });

    // Export Progress
    const exportBtn = document.getElementById('exportProgressBtn');
    const exportToast = document.getElementById('exportToast');
    const exportToastMsg = document.getElementById('exportToastMsg');

    function showToast(msg) {
      if (!exportToast) return;
      if (exportToastMsg) exportToastMsg.textContent = msg;
      exportToast.classList.remove('translate-y-20', 'opacity-0');
      exportToast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        exportToast.classList.add('translate-y-20', 'opacity-0');
        exportToast.classList.remove('translate-y-0', 'opacity-100');
      }, 3000);
    }

    exportBtn?.addEventListener('click', () => {
      const completedCount = completedTopics.size;
      const pct = totalTopicsCount > 0 ? Math.round((completedCount / totalTopicsCount) * 100) : 0;
      const dateStr = new Date().toISOString().split('T')[0];

      let md = `# ${roadmapTitle} - Study Progress\n\n`;
      md += `> Exported from EncodeEdge on ${dateStr}\n`;
      md += `> **Overall Progress**: ${completedCount}/${totalTopicsCount} completed (${pct}%)\n\n`;
      md += `---\n\n`;

      nodesList.forEach((sec, idx) => {
        md += `### Phase ${idx + 1}: ${sec.title}\n`;
        if (sec.description) md += `*${sec.description}*\n\n`;

        sec.topics?.forEach((t) => {
          const status = getTopicStatus(t.name);
          const isStar = starredTopics.has(t.name);
          const mark = status === 'done' ? '[x]' : status === 'learning' ? '[-]' : '[ ]';
          const starLabel = isStar ? ' ⭐' : '';
          const statusLabel = status === 'learning' ? ' *(In Progress)*' : status === 'skipped' ? ' *(Skipped)*' : '';
          md += `- ${mark} **${t.name}** [${t.difficulty}]${statusLabel}${starLabel}\n`;

          const noteKey = `roadmap_note_${slug}_${encodeURIComponent(t.name)}`;
          const note = localStorage.getItem(noteKey);
          if (note && note.trim()) {
            md += `  > **Note**: ${note.trim().replace(/\n/g, '\n  > ')}\n`;
          }
        });
        md += `\n`;
      });

      try {
        navigator.clipboard.writeText(md);
      } catch (err) {}

      try {
        const blob = new Blob([md], { type: 'text/markdown;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${slug}-study-progress.md`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      } catch (err) {}

      showToast('Progress exported & copied to clipboard!');
    });

    // Reset Progress Modal
    const resetModal = document.getElementById('resetConfirmModal');
    const openResetBtn = document.getElementById('openResetModalBtn');
    const cancelResetBtn = document.getElementById('cancelResetBtn');
    const confirmResetBtn = document.getElementById('confirmResetBtn');

    function openResetModal() {
      if (resetModal) resetModal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeResetModal() {
      if (resetModal) resetModal.classList.remove('open');
      document.body.style.overflow = '';
    }

    openResetBtn?.addEventListener('click', openResetModal);
    cancelResetBtn?.addEventListener('click', closeResetModal);
    resetModal?.addEventListener('click', (e) => {
      if (e.target === resetModal) closeResetModal();
    });

    confirmResetBtn?.addEventListener('click', () => {
      completedTopics.clear();
      learningTopics.clear();
      skippedTopics.clear();
      starredTopics.clear();

      try {
        localStorage.removeItem(`completedTopics_${slug}`);
        localStorage.removeItem(`learningTopics_${slug}`);
        localStorage.removeItem(`skippedTopics_${slug}`);
        localStorage.removeItem(`starredTopics_${slug}`);

        nodesList.forEach((sec) => {
          sec.topics?.forEach((t) => {
            localStorage.removeItem(`roadmap_note_${slug}_${encodeURIComponent(t.name)}`);
            localStorage.removeItem(`roadmap_takeaways_${slug}_${encodeURIComponent(t.name)}`);
          });
        });
      } catch (e) {
        console.error(e);
      }

      renderAllNodes();
      updateProgress();
      updateNextUpBanner();
      closeResetModal();
      showToast('All learning progress, stars, and notes reset.');
    });

    // Initial Render
    renderAllNodes();
    updateProgress();
    updateNextUpBanner();

    // Check URL Hash for deep linking
    if (window.location.hash) {
      const hash = window.location.hash.substring(1);
      const matched = allTopicsList.find((t) => slugifyStr(t.name) === hash);
      if (matched) {
        setTimeout(() => {
          openDrawer(matched);
          const el = document.getElementById(`topic-node-${hash}`);
          if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 300);
      }
    }


    // Ensure header height CSS variable is accurately measured across all viewports
    function syncHeaderHeight() {
      const header = document.querySelector('header');
      if (header) {
        const h = Math.round(header.getBoundingClientRect().height || header.offsetHeight);
        if (h > 0) {
          document.documentElement.style.setProperty('--site-header-height', h + 'px');
        }
      }
    }
    syncHeaderHeight();
    window.addEventListener('resize', syncHeaderHeight, { passive: true });
    window.addEventListener('orientationchange', syncHeaderHeight, { passive: true });
  }

  // Self-execute immediately if DOM already loaded or wait for ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRoadmap);
  } else {
    initRoadmap();
  }
  document.addEventListener('astro:page-load', initRoadmap);
</script>