---
import { getCollection } from 'astro:content';

import { Background } from '@/components/background';
import { BlogPosts } from '@/components/blocks/blog-posts';
import { SITE_TITLE, SITE_DESCRIPTION } from '@/consts';
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const blogPosts = await getCollection('blog');

const notebooks = await Astro.glob<any>('/src/pages/notebooks/*.astro');
const notebookPosts = notebooks
  .filter((n) => !n.file.endsWith('index.astro'))
  .map((n) => {
    const frontmatter = n.frontmatter || n;
    const url = n.url || '';
    const slug = url.split('/').filter(Boolean).pop() || '';
    const title = frontmatter.title || slug
      .split('-')
      .map((word: string) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');

    return {
      id: slug,
      slug: `/notebooks/${slug}/`,
      collection: 'notebooks',
      data: {
        title,
        description: frontmatter.description || 'Interactive Jupyter notebook covering core data structures, algorithms, and practical code execution.',
        pubDate: frontmatter.pubDate ? new Date(frontmatter.pubDate) : new Date('2025-11-01'),
        image: frontmatter.image || `/assets/notebooks/${slug}/image.png`,
        tags: frontmatter.tags || ['python', 'notebook', 'hands-on'],
        topics: ['python'],
        readTime: 12,
        featured: false,
        authorName: frontmatter.authorName || 'Atul Jha',
        authorImage: frontmatter.authorImage || '/assets/introduction-to-machine-learning/authorImage.png',
      }
    };
  });

const posts = [...blogPosts, ...notebookPosts].sort(
	(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);
---

<DefaultLayout title={`Articles & Blueprints | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<div class="py-10 md:py-14">
		<BlogPosts posts={posts} client:load />
	</div>
</DefaultLayout>
