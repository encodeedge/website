          <kbd class="shortcut-key">J</kbd>
          <kbd class="shortcut-key">K</kbd>
          <span class="text-muted-foreground/60">or</span>
          <kbd class="shortcut-key">↓</kbd>
          <kbd class="shortcut-key">↑</kbd>
