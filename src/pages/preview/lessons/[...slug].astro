---
export const prerender = false;

import DefaultLayout from "@/layouts/DefaultLayout.astro";
import { NeuralPlayground } from "@/components/interactive/NeuralPlayground";
import { GradientDescentLab } from "@/components/interactive/GradientDescentLab";
import { MemoryExplorer } from "@/components/interactive/MemoryExplorer";
import { CodeSandboxRunner } from "@/components/interactive/CodeSandboxRunner";
import { createGitHubReader } from "@keystatic/core/reader/github";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import keystaticConfig from "@/../keystatic.config";
import { Eye, GitBranch, ArrowLeft, RefreshCw, AlertCircle, Clock } from "lucide-react";

const { slug } = Astro.params;
const branch =
  Astro.url.searchParams.get("branch") ||
  Astro.cookies.get("ks-branch")?.value ||
  "master";

if (!slug) {
  return Astro.redirect("/courses");
}

let lessonData: any = null;
let renderedHtml = "";
let errorMessage: string | null = null;

try {
  const reader = createGitHubReader(keystaticConfig, {
    repo: "encodeedge/website",
    ref: branch,
    token:
      import.meta.env.KEYSTATIC_GITHUB_TOKEN ||
      import.meta.env.GITHUB_TOKEN ||
      undefined,
  });

  const entry = await reader.collections.lessons.read(slug);
  if (!entry) {
    errorMessage = `Lesson "${slug}" was not found on branch "${branch}". Ensure you have clicked "Save" in Keystatic.`;
  } else {
    lessonData = entry;
    const rawContent = await entry.content();

    let processedContent = rawContent || "";

    // Convert <Callout kind="...">...</Callout>
    processedContent = processedContent.replace(
      /<Callout(?:\s+kind="([^"]*)")?(?:\s+title="([^"]*)")?>([\s\S]*?)<\/Callout>/g,
      (_match, kind = "info", title = "", body = "") => {
        const borderColors: Record<string, string> = {
          info: "border-blue-500/40 bg-blue-500/5 text-blue-950 dark:text-blue-200",
          tip: "border-emerald-500/40 bg-emerald-500/5 text-emerald-950 dark:text-emerald-200",
          warning: "border-amber-500/40 bg-amber-500/5 text-amber-950 dark:text-amber-200",
          danger: "border-red-500/40 bg-red-500/5 text-red-950 dark:text-red-200",
        };
        const style = borderColors[kind] || borderColors.info;
        return `\n\n<div class="my-6 p-4 rounded-xl border ${style}">
          ${title ? `<div class="font-bold text-sm mb-1">${title}</div>` : ""}
          <div class="text-sm leading-relaxed">${body.trim()}</div>
        </div>\n\n`;
      }
    );

    // Convert <CodeSnippet ... />
    processedContent = processedContent.replace(
      /<CodeSnippet(?:\s+language="([^"]*)")?(?:\s+filename="([^"]*)")?(?:\s+code="([^"]*)")?\s*\/>/g,
      (_match, language = "python", filename = "", code = "") => {
        return `\n\n<div class="my-6 rounded-xl overflow-hidden border border-border/80 bg-black-950 text-slate-200">
          ${filename ? `<div class="px-4 py-2 bg-black-900 border-b border-white/10 font-mono text-xs text-slate-400">${filename}</div>` : ""}
          <pre class="p-4 overflow-x-auto text-xs font-mono"><code>${code}</code></pre>
        </div>\n\n`;
      }
    );

    const processor = await createMarkdownProcessor();
    const res = await processor.render(processedContent);
    renderedHtml = res.code;
  }
} catch (err: any) {
  console.error("Preview lesson render error:", err);
  errorMessage = `Unable to fetch preview from GitHub branch "${branch}": ${err.message}`;
}
---

<DefaultLayout
  title={lessonData ? `[Preview] ${lessonData.title}` : `Preview Lesson: ${slug}`}
  description="Live Keystatic lesson preview"
>
  <!-- Sticky Live Preview Top Bar -->
  <div class="sticky top-0 z-50 bg-amber-500/10 dark:bg-amber-950/80 backdrop-blur-md border-b border-amber-500/30 px-4 py-2.5 shadow-sm">
    <div class="container mx-auto max-w-6xl flex items-center justify-between flex-wrap gap-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="font-bold text-amber-900 dark:text-amber-200 flex items-center gap-1.5">
          <Eye class="w-3.5 h-3.5" />
          Live Lesson Preview
        </span>
        <span class="px-2 py-0.5 rounded-md bg-amber-500/20 text-amber-950 dark:text-amber-300 font-mono font-semibold flex items-center gap-1">
          <GitBranch class="w-3 h-3" />
          {branch}
        </span>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={Astro.url.href}
          class="inline-flex items-center gap-1 text-muted-foreground hover:text-foreground font-medium transition-colors"
        >
          <RefreshCw class="w-3 h-3" />
          Refresh
        </a>
        <a
          href="/preview/end"
          class="px-2.5 py-1 rounded-md bg-amber-500/20 hover:bg-amber-500/30 text-amber-950 dark:text-amber-200 font-bold transition-colors inline-flex items-center gap-1"
        >
          <ArrowLeft class="w-3 h-3" />
          Exit Preview
        </a>
      </div>
    </div>
  </div>

  {errorMessage ? (
    <div class="container mx-auto max-w-2xl px-4 py-16 text-center space-y-4">
      <div class="size-12 rounded-2xl bg-destructive/10 text-destructive flex items-center justify-center mx-auto">
        <AlertCircle class="w-6 h-6" />
      </div>
      <h1 class="text-2xl font-bold font-display">Preview Not Available</h1>
      <p class="text-sm text-muted-foreground max-w-md mx-auto leading-relaxed">
        {errorMessage}
      </p>
    </div>
  ) : lessonData ? (
    <div class="py-8 md:py-16 container mx-auto px-4 max-w-4xl space-y-8">
      <!-- Lesson Header -->
      <div class="space-y-4 pt-2">
        <div class="flex items-center gap-3">
          <span class={`text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full ${
            lessonData.lessonType === 'video' 
              ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20' 
              : lessonData.lessonType === 'lab'
              ? 'bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20'
              : 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20'
          }`}>
            {lessonData.lessonType === 'lab' ? 'Interactive Lab' : `${lessonData.lessonType} Lesson`}
          </span>

          {lessonData.duration && (
            <span class="flex items-center gap-1 text-xs text-muted-foreground font-semibold">
              <Clock class="w-3.5 h-3.5" />
              {lessonData.duration} min
            </span>
          )}
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-display tracking-tight text-foreground leading-[1.2]">
          {lessonData.title}
        </h1>

        {lessonData.description && (
          <p class="text-base sm:text-lg text-muted-foreground font-body leading-relaxed max-w-3xl">
            {lessonData.description}
          </p>
        )}
      </div>

      <!-- Video Embed (if video lesson) -->
      {lessonData.lessonType === 'video' && lessonData.videoUrl && (
        <div class="aspect-video w-full rounded-2xl overflow-hidden border border-border/80 bg-black shadow-lg">
          <iframe 
            src={lessonData.videoUrl} 
            class="w-full h-full" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
          ></iframe>
        </div>
      )}

      <!-- Interactive Lab Embed for specific conceptual lessons -->
      {(lessonData.interactiveLab === 'neural-playground' || slug === 'dl-perceptrons-and-backprop' || slug === 'dl-interactive-lab') && (
        <div class="my-8">
          <NeuralPlayground client:load />
        </div>
      )}

      {(lessonData.interactiveLab === 'gradient-descent' || slug === 'ml-gradient-descent-mechanics' || slug === 'ml-interactive-lab') && (
        <div class="my-8">
          <GradientDescentLab client:load />
        </div>
      )}

      {(lessonData.interactiveLab === 'memory-explorer' || slug === 'py-memory-management' || slug === 'py-interactive-lab') && (
        <div class="my-8">
          <MemoryExplorer client:load />
        </div>
      )}

      <!-- Lesson Markdown Prose Content -->
      <div class="prose prose-lg dark:prose-invert max-w-none font-body leading-relaxed pt-4">
        <div set:html={renderedHtml} />
      </div>

      <!-- Live In-Lesson Code Sandbox -->
      <div class="my-8">
        <CodeSandboxRunner contentId={slug} client:load />
      </div>
    </div>
  ) : null}
</DefaultLayout>

