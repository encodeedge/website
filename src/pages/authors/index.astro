---
import { getCollection } from 'astro:content';

import { Background } from '@/components/background';
import { SITE_TITLE } from '@/consts';
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const allPosts = await getCollection('blog');

// Helper to create URL-safe slugs
const slugify = (text: string) => {
  return text
    .toString()
    .toLowerCase()
    .trim()
    .replace(/\s+/g, '-')
    .replace(/[^\w-]+/g, '')
    .replace(/--+/g, '-');
};

// Calculate counts and gather metadata for each author
const authorStats = allPosts.reduce((acc, post) => {
    const name = post.data.authorName;
    if (!name) return acc; // Skip posts without an author

    if (!acc[name]) {
        acc[name] = {
            count: 0,
            label: name,
            slug: slugify(name),
            // Grab the image from the first post found for this author
            image: post.data.authorImage || null
        };
    }
    acc[name].count++;
    
    // If we didn't have an image before but this post has one, update it
    if (!acc[name].image && post.data.authorImage) {
        acc[name].image = post.data.authorImage;
    }

    return acc;
}, {} as Record<string, { count: number; label: string; slug: string; image: string | null }>);

// Convert to an array and sort by Author name
const authors = Object.values(authorStats).sort((a, b) => a.label.localeCompare(b.label));

const title = `All Authors | ${SITE_TITLE}`;
const description = 'Meet the experts and contributors behind our blog.';

---

<DefaultLayout title={title} description={description}>
    <div class="py-12 md:py-16 max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <span class="inline-block text-xs font-semibold uppercase tracking-wider bg-black-100 dark:bg-black-800 text-muted-foreground px-3 py-1 rounded-full mb-3">
                Contributors
            </span>
            <h1 class="text-4xl sm:text-5xl font-bold font-display tracking-tight text-foreground mb-4">
                Our Authors
            </h1>
            <p class="text-base sm:text-lg text-muted-foreground font-body">
                Meet the engineering practitioners, researchers, and educators behind our publications.
            </p>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {authors.map(author => (
                <a 
                    href={`/authors/${author.slug}`} 
                    class="group flex flex-col items-center text-center p-8 border border-black-200 dark:border-black-800 rounded-2xl bg-card shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300"
                >
                    {/* Author Avatar */}
                    <div class="relative w-24 h-24 mb-4 rounded-full overflow-hidden bg-black-100 dark:bg-black-800 border-2 border-black-200 dark:border-black-700 group-hover:border-primary transition-colors">
                        {author.image ? (
                            <img src={author.image} alt={author.label} class="w-full h-full object-cover" />
                        ) : (
                            <div class="flex items-center justify-center w-full h-full text-muted-foreground font-display font-bold text-2xl">
                                {author.label.charAt(0)}
                            </div>
                        )}
                    </div>

                    <h2 class="text-xl font-bold font-display text-foreground group-hover:text-primary transition-colors mb-2">
                        {author.label}
                    </h2>
                    
                    <span class="woords_tag text-xs">
                        {author.count} {author.count === 1 ? 'Article' : 'Articles'}
                    </span>
                </a>
            ))}
        </div>
    </div>
</DefaultLayout>