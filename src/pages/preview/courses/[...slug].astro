---
// Static placeholder to ensure clean GitHub Pages builds
export async function getStaticPaths() {
  return [];
}
---
<!DOCTYPE html>
<html>
<head>
  <script is:inline>
    const path = window.location.pathname.replace(/^\/preview/, '');
    const search = window.location.search;
    window.location.replace('/preview/' + search + (search ? '&' : '?') + 'to=' + encodeURIComponent(path));
  </script>
</head>
<body></body>
</html>
