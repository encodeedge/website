---
import { getCollection, render } from 'astro:content';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { CourseNavigation } from '@/components/ui/course-navigation';
import { getCoursesMap } from '@/utils/course-map';

export async function getStaticPaths() {
  const assignments = await getCollection('assignments');
  return assignments.map(assignment => ({
    params: { slug: assignment.id },
    props: { assignment },
  }));
}

const { assignment } = Astro.props;
const { Content } = await render(assignment);
const coursesMap = await getCoursesMap();
---

<DefaultLayout title={`${assignment.data.title} | Assignment`} description={assignment.data.description || assignment.data.title}>
  <div class="max-w-5xl mx-auto px-4 py-12 md:py-16">
    <CourseNavigation coursesMap={coursesMap} currentItemId={assignment.id} itemType="assignment" mode="top" client:load />

    <div class="mb-8 mt-6">
      <div class="flex items-center gap-4 mb-3">
        <span class="woords_tag_small">Assignment</span>
      </div>
      <h1 class="font-display font-bold text-3xl md:text-5xl tracking-tight text-foreground mb-3 leading-tight">
        {assignment.data.title}
      </h1>
      {assignment.data.description && (
        <p class="text-base sm:text-lg text-muted-foreground max-w-3xl leading-relaxed">
          {assignment.data.description}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
      <div class="lg:col-span-2">
        <div class="rounded-2xl border border-black-200 dark:border-black-800 bg-card p-6 md:p-8 shadow-sm">
          <h2 class="font-display font-bold text-xl text-foreground mb-4 pb-2 border-b border-border">
            Instructions
          </h2>
          <div class="prose prose-lg dark:prose-invert max-w-none font-body">
            <Content />
          </div>
        </div>
      </div>

      <div class="lg:col-span-1 space-y-6">
        {assignment.data.rubric && assignment.data.rubric.length > 0 && (
          <div class="rounded-2xl border border-black-200 dark:border-black-800 bg-card p-6 shadow-sm">
            <h3 class="font-display font-bold text-lg text-foreground mb-4 pb-2 border-b border-border">
              Grading Rubric
            </h3>
            <ul class="space-y-3">
              {assignment.data.rubric.map((item) => (
                <li class="flex justify-between items-start pb-2 border-b border-border/50 last:border-0 last:pb-0 text-xs">
                  <span class="text-muted-foreground">{item.criteria}</span>
                  <span class="font-semibold text-foreground shrink-0 ml-3">{item.maxPoints} pts</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {assignment.data.resources && assignment.data.resources.length > 0 && (
          <div class="rounded-2xl border border-black-200 dark:border-black-800 bg-card p-6 shadow-sm">
            <h3 class="font-display font-bold text-lg text-foreground mb-4 pb-2 border-b border-border">
              Resources & Starter Code
            </h3>
            <ul class="space-y-2.5 text-xs">
              {assignment.data.resources.map((resource) => (
                <li>
                  <a href={resource.url} target="_blank" rel="noopener noreferrer" class="flex items-center text-foreground hover:underline font-medium gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    <span>{resource.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>

    <CourseNavigation coursesMap={coursesMap} currentItemId={assignment.id} itemType="assignment" mode="bottom" client:load />
  </div>
</DefaultLayout>
