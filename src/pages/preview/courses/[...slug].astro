---
export const prerender = false;

import DefaultLayout from "@/layouts/DefaultLayout.astro";
import { CourseCurriculumAccordion } from "@/components/ui/course-curriculum-accordion";
import { CourseProgressCard } from "@/components/ui/course-progress-card";
import { CoursePrerequisiteFlow } from "@/components/interactive/CoursePrerequisiteFlow";
import { createGitHubReader } from "@keystatic/core/reader/github";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import keystaticConfig from "@/../keystatic.config";
import { getCollection } from "astro:content";
import { Eye, GitBranch, ArrowLeft, RefreshCw, AlertCircle, Clock, BookOpen, GraduationCap } from "lucide-react";

const { slug } = Astro.params;
const branch =
  Astro.url.searchParams.get("branch") ||
  Astro.cookies.get("ks-branch")?.value ||
  "master";

if (!slug) {
  return Astro.redirect("/courses");
}

let courseData: any = null;
let renderedAbout = "";
let errorMessage: string | null = null;

try {
  const reader = createGitHubReader(keystaticConfig, {
    repo: "encodeedge/website",
    ref: branch,
    token:
      import.meta.env.KEYSTATIC_GITHUB_TOKEN ||
      import.meta.env.GITHUB_TOKEN ||
      undefined,
  });

  const entry = await reader.collections.courses.read(slug);
  if (!entry) {
    errorMessage = `Course "${slug}" was not found on branch "${branch}". Ensure you have clicked "Save" in Keystatic.`;
  } else {
    courseData = entry;
    const rawAbout = await entry.about();
    const processor = await createMarkdownProcessor();
    const res = await processor.render(rawAbout || "");
    renderedAbout = res.code;
  }
} catch (err: any) {
  console.error("Preview course render error:", err);
  errorMessage = `Unable to fetch preview from GitHub branch "${branch}": ${err.message}`;
}

const allLessons = await getCollection("lessons").catch(() => []);
const allQuizzes = await getCollection("quizzes").catch(() => []);
const allAssignments = await getCollection("assignments").catch(() => []);
const allInstructors = await getCollection("instructors").catch(() => []);

const instructor = courseData
  ? allInstructors.find((i) => i.id === courseData.instructor)
  : null;

let flatItems: Array<{ id: string; type: string; title: string; url: string }> = [];
let totalDurationMinutes = 0;

const structuredChapters = (courseData?.chapters || []).map((chapter: any, chIdx: number) => {
  const items = (chapter.items || []).map((itemBlock: any, itemIdx: number) => {
    let itemTitle = `Item ${itemIdx + 1}`;
    let itemUrl = "#";
    let duration: number | undefined = undefined;

    if (itemBlock.discriminant === "lesson") {
      const refId = itemBlock.value.lessonRef;
      const lesson = allLessons.find((l) => l.id === refId);
      itemTitle = lesson?.data.title || refId;
      itemUrl = `/preview/lessons/${refId}?branch=${encodeURIComponent(branch)}`;
      duration = lesson?.data.duration;
      if (duration) totalDurationMinutes += duration;
      return { id: refId, type: "lesson" as const, title: itemTitle, lessonType: lesson?.data.lessonType || "article", duration, url: itemUrl };
    } else if (itemBlock.discriminant === "quiz") {
      const refId = itemBlock.value.quizRef;
      const quiz = allQuizzes.find((q) => q.id === refId);
      itemTitle = quiz?.data.title || refId;
      itemUrl = `/quizzes/${refId}`;
      totalDurationMinutes += 15;
      return { id: refId, type: "quiz" as const, title: itemTitle, duration: 15, url: itemUrl };
    } else {
      const refId = itemBlock.value.assignmentRef;
      const assignment = allAssignments.find((a) => a.id === refId);
      itemTitle = assignment?.data.title || refId;
      itemUrl = `/assignments/${refId}`;
      totalDurationMinutes += 90;
      return { id: refId, type: "assignment" as const, title: itemTitle, duration: 90, url: itemUrl };
    }
  });

  flatItems.push(...items);
  return { title: chapter.title || `Chapter ${chIdx + 1}`, description: chapter.description, items };
});
---

<DefaultLayout
  title={courseData ? `[Preview] ${courseData.title}` : `Preview Course: ${slug}`}
  description="Live Keystatic course preview"
>
  <!-- Sticky Live Preview Top Bar -->
  <div class="sticky top-0 z-50 bg-amber-500/10 dark:bg-amber-950/80 backdrop-blur-md border-b border-amber-500/30 px-4 py-2.5 shadow-sm">
    <div class="container mx-auto max-w-6xl flex items-center justify-between flex-wrap gap-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="font-bold text-amber-900 dark:text-amber-200 flex items-center gap-1.5">
          <Eye class="w-3.5 h-3.5" />
          Live Course Preview
        </span>
        <span class="px-2 py-0.5 rounded-md bg-amber-500/20 text-amber-950 dark:text-amber-300 font-mono font-semibold flex items-center gap-1">
          <GitBranch class="w-3 h-3" />
          {branch}
        </span>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={Astro.url.href}
          class="inline-flex items-center gap-1 text-muted-foreground hover:text-foreground font-medium transition-colors"
        >
          <RefreshCw class="w-3 h-3" />
          Refresh
        </a>
        <a
          href="/preview/end"
          class="px-2.5 py-1 rounded-md bg-amber-500/20 hover:bg-amber-500/30 text-amber-950 dark:text-amber-200 font-bold transition-colors inline-flex items-center gap-1"
        >
          <ArrowLeft class="w-3 h-3" />
          Exit Preview
        </a>
      </div>
    </div>
  </div>

  {errorMessage ? (
    <div class="container mx-auto max-w-2xl px-4 py-16 text-center space-y-4">
      <div class="size-12 rounded-2xl bg-destructive/10 text-destructive flex items-center justify-center mx-auto">
        <AlertCircle class="w-6 h-6" />
      </div>
      <h1 class="text-2xl font-bold font-display">Preview Not Available</h1>
      <p class="text-sm text-muted-foreground max-w-md mx-auto leading-relaxed">
        {errorMessage}
      </p>
    </div>
  ) : courseData ? (
    <div class="py-8 md:py-16 container mx-auto px-4 max-w-6xl space-y-12">
      <!-- Course Hero -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-8 space-y-4">
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20">
              {courseData.level}
            </span>
            <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              {courseData.status}
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-display tracking-tight text-foreground">
            {courseData.title}
          </h1>

          {courseData.shortDescription && (
            <p class="text-base sm:text-lg text-muted-foreground font-body leading-relaxed max-w-3xl">
              {courseData.shortDescription}
            </p>
          )}

          <div class="flex items-center gap-6 pt-2 text-xs text-muted-foreground flex-wrap">
            <span class="flex items-center gap-1.5 font-semibold">
              <BookOpen class="w-4 h-4 text-primary" />
              {flatItems.length} Lessons & Labs
            </span>
            <span class="flex items-center gap-1.5 font-semibold">
              <Clock class="w-4 h-4 text-primary" />
              ~{Math.round(totalDurationMinutes / 60)} Hours Total
            </span>
            {instructor && (
              <span class="flex items-center gap-1.5 font-semibold">
                <GraduationCap class="w-4 h-4 text-primary" />
                Instructor: {instructor.data.name}
              </span>
            )}
          </div>
        </div>

        {courseData.coverImage && (
          <div class="lg:col-span-4 rounded-2xl overflow-hidden border border-border/80 shadow-md">
            <img src={courseData.coverImage} alt={courseData.title} class="w-full h-auto object-cover" />
          </div>
        )}
      </div>

      <!-- Curriculum Accordion & Overview -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">
          <section>
            <h2 class="text-2xl font-bold font-display mb-4">Course Curriculum</h2>
            <CourseCurriculumAccordion courseId={slug} chapters={structuredChapters} client:load />
          </section>

          {renderedAbout && (
            <section class="prose prose-lg dark:prose-invert max-w-none pt-4 border-t border-border/60">
              <div set:html={renderedAbout} />
            </section>
          )}

          <section>
            <CoursePrerequisiteFlow courseId={slug} client:load />
          </section>
        </div>

        <aside class="lg:col-span-1 space-y-6">
          <CourseProgressCard
            courseId={slug}
            flatItems={flatItems}
            totalDurationMinutes={totalDurationMinutes}
            courseTitle={courseData.title}
            client:load
          />
        </aside>
      </div>
    </div>
  ) : null}
</DefaultLayout>

