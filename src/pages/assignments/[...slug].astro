---
import { getCollection, render } from 'astro:content';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { CourseLearningStudio } from '@/components/interactive/CourseLearningStudio';
import { AssignmentSubmissionCard } from '@/components/ui/assignment-submission-card';
import { getCoursesMap } from '@/utils/course-map';
import { Briefcase, CheckCircle2, Download, ExternalLink, Code } from 'lucide-react';

export async function getStaticPaths() {
  const assignments = await getCollection('assignments');
  return assignments.map(assignment => ({
    params: { slug: assignment.id },
    props: { assignment },
  }));
}

const { assignment } = Astro.props;
const { Content } = await render(assignment);
const coursesMap = await getCoursesMap();

const rubric = assignment.data.rubric || [];
const totalPoints = rubric.reduce((sum, item) => sum + item.maxPoints, 0);

// Load all collections to build full curriculum context
const allCourses = await getCollection('courses');
const allLessons = await getCollection('lessons');
const allQuizzes = await getCollection('quizzes');
const allAssignments = await getCollection('assignments');

const requestedCourseId = Astro.url.searchParams.get('course');
let activeCourse = requestedCourseId 
  ? allCourses.find(c => c.id === requestedCourseId) 
  : allCourses.find(c => c.data.chapters?.some(ch => ch.items?.some(it => it.discriminant === 'assignment' && it.value?.assignmentRef === assignment.id))) || allCourses[0];

// Format chapters into structured format matching CourseLearningStudio
const structuredChapters = (activeCourse?.data.chapters || []).map((chapter, chIdx) => {
  const chapterItems = (chapter.items || []).map((item, itemIdx) => {
    let type: 'lesson' | 'quiz' | 'assignment' = 'lesson';
    let id = '';
    let title = '';
    let lessonType = 'article';
    let duration = 20;

    let comingSoon = false;
    let draft = false;
    let comingSoonMessage = '';

    if (item.discriminant === 'lesson' && item.value.lessonRef) {
      type = 'lesson';
      id = item.value.lessonRef;
      const l = allLessons.find(x => x.id === id);
      title = l?.data.title || id.replace(/-/g, ' ');
      lessonType = l?.data.lessonType || 'article';
      duration = l?.data.duration || 20;
      comingSoon = l?.data.comingSoon || false;
      draft = l?.data.draft || false;
      comingSoonMessage = l?.data.comingSoonMessage || '';
    } else if (item.discriminant === 'quiz' && item.value.quizRef) {
      type = 'quiz';
      id = item.value.quizRef;
      const q = allQuizzes.find(x => x.id === id);
      title = q?.data.title || 'Interactive Quiz';
      lessonType = 'quiz';
      duration = 15;
    } else if (item.discriminant === 'assignment' && item.value.assignmentRef) {
      type = 'assignment';
      id = item.value.assignmentRef;
      const a = allAssignments.find(x => x.id === id);
      title = a?.data.title || 'Hands-on Project';
      lessonType = 'assignment';
      duration = 90;
    }

    const url = `/${type === 'lesson' ? 'lessons' : type === 'quiz' ? 'quizzes' : 'assignments'}/${id}?course=${activeCourse?.id || ''}`;

    return {
      id,
      type,
      title,
      lessonType,
      duration,
      url,
      isFree: chIdx === 0 && itemIdx < 2,
      comingSoon,
      draft,
      comingSoonMessage,
    };
  });

  return {
    title: chapter.title,
    description: chapter.description,
    items: chapterItems
  };
});
---

<DefaultLayout 
  title={`${assignment.data.title} | ${activeCourse?.data.title || 'Course'} Project`} 
  description={assignment.data.description || assignment.data.title}
>
  <div class="w-full">
    <CourseLearningStudio
      client:load
      courseId={activeCourse?.id || 'system-design'}
      courseTitle={activeCourse?.data.title || 'Course'}
      currentLesson={{
        id: assignment.id,
        title: assignment.data.title,
        description: assignment.data.description,
        lessonType: 'assignment',
        duration: 90
      }}
      chapters={structuredChapters}
    >
      <div class="space-y-8 pt-2">
        <!-- Two-Column Layout: Instructions vs Submission & Rubric -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
          
          <!-- Instructions Column (2/3) -->
          <div class="lg:col-span-2 space-y-6">
            <div class="rounded-3xl border border-border/80 bg-card p-6 md:p-8 shadow-sm space-y-6">
              <h2 class="font-display font-bold text-xl text-foreground pb-3 border-b border-border/60 flex items-center gap-2">
                <Code class="w-5 h-5 text-primary" />
                <span>Project Specifications &amp; Requirements</span>
              </h2>
              
              <div class="prose prose-lg dark:prose-invert max-w-none font-body leading-relaxed">
                <Content />
              </div>
            </div>
          </div>

          <!-- Right Column (1/3): Submission Simulator & Rubric -->
          <div class="lg:col-span-1 space-y-6 lg:sticky lg:top-24">
            
            <!-- Interactive Submission Simulator Card -->
            <AssignmentSubmissionCard 
              assignmentId={assignment.id} 
              totalPoints={totalPoints} 
              client:load 
            />

            <!-- Grading Rubric Card -->
            {rubric.length > 0 && (
              <div class="rounded-2xl border border-border/80 bg-card p-6 shadow-sm space-y-4">
                <h3 class="font-display font-bold text-base text-foreground pb-2 border-b border-border/60">
                  Evaluation Rubric
                </h3>
                <ul class="space-y-3">
                  {rubric.map((item) => (
                    <li class="flex justify-between items-start pb-2.5 border-b border-border/40 last:border-0 last:pb-0 text-xs">
                      <span class="text-muted-foreground leading-relaxed pr-2">{item.criteria}</span>
                      <span class="font-bold text-foreground shrink-0 ml-auto bg-muted px-2 py-0.5 rounded">
                        {item.maxPoints} pts
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Resources & Starter Code -->
            {assignment.data.resources && assignment.data.resources.length > 0 && (
              <div class="rounded-2xl border border-border/80 bg-card p-6 shadow-sm space-y-3">
                <h3 class="font-display font-bold text-base text-foreground pb-2 border-b border-border/60">
                  Starter Materials &amp; Links
                </h3>
                <ul class="space-y-2.5 text-xs">
                  {assignment.data.resources.map((resource) => (
                    <li>
                      <a 
                        href={resource.url} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="flex items-center text-primary hover:underline font-medium gap-2 group"
                      >
                        <ExternalLink class="w-3.5 h-3.5 shrink-0 text-muted-foreground group-hover:text-primary transition-colors" />
                        <span class="truncate">{resource.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

          </div>

        </div>
      </div>
    </CourseLearningStudio>
  </div>
</DefaultLayout>
