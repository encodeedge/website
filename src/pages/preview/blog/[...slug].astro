---
export const prerender = false;

import DefaultLayout from "@/layouts/DefaultLayout.astro";
import BlogPost from "@/components/blocks/BlogPost.astro";
import { createGitHubReader } from "@keystatic/core/reader/github";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import keystaticConfig from "@/../keystatic.config";
import { getCollection } from "astro:content";
import { Eye, GitBranch, ArrowLeft, RefreshCw, AlertCircle } from "lucide-react";

const { slug } = Astro.params;
const branch =
  Astro.url.searchParams.get("branch") ||
  Astro.cookies.get("ks-branch")?.value ||
  "master";

if (!slug) {
  return Astro.redirect("/blog");
}

let postData: any = null;
let renderedHtml = "";
let errorMessage: string | null = null;

try {
  const reader = createGitHubReader(keystaticConfig, {
    repo: "encodeedge/website",
    ref: branch,
    token:
      import.meta.env.KEYSTATIC_GITHUB_TOKEN ||
      import.meta.env.GITHUB_TOKEN ||
      undefined,
  });

  const entry = await reader.collections.blogs.read(slug);
  if (!entry) {
    errorMessage = `Post "${slug}" was not found on branch "${branch}". Ensure you have clicked "Save" in Keystatic for this item.`;
  } else {
    postData = entry;
    const rawContent = await entry.content();

    // Transform custom MDX tags to styled HTML for seamless previewing
    let processedContent = rawContent || "";
    
    // Convert <Callout kind="...">...</Callout>
    processedContent = processedContent.replace(
      /<Callout(?:\s+kind="([^"]*)")?(?:\s+title="([^"]*)")?>([\s\S]*?)<\/Callout>/g,
      (_match, kind = "info", title = "", body = "") => {
        const borderColors: Record<string, string> = {
          info: "border-blue-500/40 bg-blue-500/5 text-blue-950 dark:text-blue-200",
          tip: "border-emerald-500/40 bg-emerald-500/5 text-emerald-950 dark:text-emerald-200",
          warning: "border-amber-500/40 bg-amber-500/5 text-amber-950 dark:text-amber-200",
          danger: "border-red-500/40 bg-red-500/5 text-red-950 dark:text-red-200",
        };
        const style = borderColors[kind] || borderColors.info;
        return `\n\n<div class="my-6 p-4 rounded-xl border ${style}">
          ${title ? `<div class="font-bold text-sm mb-1">${title}</div>` : ""}
          <div class="text-sm leading-relaxed">${body.trim()}</div>
        </div>\n\n`;
      }
    );

    // Convert <CodeSnippet ... />
    processedContent = processedContent.replace(
      /<CodeSnippet(?:\s+language="([^"]*)")?(?:\s+filename="([^"]*)")?(?:\s+code="([^"]*)")?\s*\/>/g,
      (_match, language = "python", filename = "", code = "") => {
        return `\n\n<div class="my-6 rounded-xl overflow-hidden border border-border/80 bg-black-950 text-slate-200">
          ${filename ? `<div class="px-4 py-2 bg-black-900 border-b border-white/10 font-mono text-xs text-slate-400">${filename}</div>` : ""}
          <pre class="p-4 overflow-x-auto text-xs font-mono"><code>${code}</code></pre>
        </div>\n\n`;
      }
    );

    // Convert <CodeSandbox ... />
    processedContent = processedContent.replace(
      /<CodeSandbox(?:\s+snippetId="([^"]*)")?(?:\s+category="([^"]*)")?(?:\s+title="([^"]*)")?\s*\/>/g,
      (_match, snippetId = "", category = "Python Systems", title = "Interactive Code Sandbox") => {
        return `\n\n<div class="my-6 p-4 rounded-2xl border border-primary/30 bg-primary/5 flex items-center justify-between">
          <div class="space-y-1">
            <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-primary/20 text-primary">${category}</span>
            <div class="font-bold text-sm">${title}</div>
            <div class="text-xs text-muted-foreground">Interactive Simulator: ${snippetId || "Default"}</div>
          </div>
          <span class="text-xs font-semibold text-primary underline">Interactive Runner Enabled</span>
        </div>\n\n`;
      }
    );

    const processor = await createMarkdownProcessor();
    const res = await processor.render(processedContent);
    renderedHtml = res.code;
  }
} catch (err: any) {
  console.error("Preview render error:", err);
  errorMessage = `Unable to fetch preview from GitHub branch "${branch}": ${err.message}`;
}

// Gather all published posts for related/featured sidebars
const allPosts = await getCollection("blog").catch(() => []);
const featured = allPosts.slice(0, 4);
const relatedPosts = allPosts.slice(0, 3);

// Format post object to match BlogPost.astro props
const post = postData
  ? {
      id: slug,
      data: {
        title: postData.title || slug,
        description: postData.description || "",
        pubDate: postData.pubDate ? new Date(postData.pubDate) : new Date(),
        updatedDate: postData.updatedDate ? new Date(postData.updatedDate) : new Date(),
        readTime: postData.readTime || 5,
        image: postData.image || undefined,
        authorImage: postData.authorImage || undefined,
        authorName: postData.authorName || "Atul Jha",
        faqs: postData.faqs || [],
        references: postData.references || [],
        topics: postData.topics || ["python"],
        tags: postData.tags || [],
        featured: postData.featured || false,
      },
    }
  : null;
---

<DefaultLayout
  title={post ? `[Preview] ${post.data.title}` : `Preview: ${slug}`}
  description="Live Keystatic draft preview"
>
  <!-- Sticky Live Preview Top Bar -->
  <div class="sticky top-0 z-50 bg-amber-500/10 dark:bg-amber-950/80 backdrop-blur-md border-b border-amber-500/30 px-4 py-2.5 shadow-sm">
    <div class="container mx-auto max-w-6xl flex items-center justify-between flex-wrap gap-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="font-bold text-amber-900 dark:text-amber-200 flex items-center gap-1.5">
          <Eye class="w-3.5 h-3.5" />
          Live Keystatic Preview
        </span>
        <span class="px-2 py-0.5 rounded-md bg-amber-500/20 text-amber-950 dark:text-amber-300 font-mono font-semibold flex items-center gap-1">
          <GitBranch class="w-3 h-3" />
          {branch}
        </span>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={Astro.url.href}
          class="inline-flex items-center gap-1 text-muted-foreground hover:text-foreground font-medium transition-colors"
          title="Refresh to see latest Keystatic changes"
        >
          <RefreshCw class="w-3 h-3" />
          Refresh
        </a>
        <a
          href="/preview/end"
          class="px-2.5 py-1 rounded-md bg-amber-500/20 hover:bg-amber-500/30 text-amber-950 dark:text-amber-200 font-bold transition-colors inline-flex items-center gap-1"
        >
          <ArrowLeft class="w-3 h-3" />
          Exit Preview
        </a>
      </div>
    </div>
  </div>

  {errorMessage ? (
    <div class="container mx-auto max-w-2xl px-4 py-16 text-center space-y-4">
      <div class="size-12 rounded-2xl bg-destructive/10 text-destructive flex items-center justify-center mx-auto">
        <AlertCircle class="w-6 h-6" />
      </div>
      <h1 class="text-2xl font-bold font-display">Preview Not Available</h1>
      <p class="text-sm text-muted-foreground max-w-md mx-auto leading-relaxed">
        {errorMessage}
      </p>
      <div class="pt-4 flex items-center justify-center gap-3">
        <a
          href={Astro.url.href}
          class="px-4 py-2 rounded-xl bg-primary text-primary-foreground text-xs font-bold shadow-sm hover:opacity-90"
        >
          Retry
        </a>
        <a
          href="/blog"
          class="px-4 py-2 rounded-xl border border-border text-xs font-semibold hover:bg-muted"
        >
          Back to Blog
        </a>
      </div>
    </div>
  ) : post ? (
    <div class="py-6 md:py-10">
      <BlogPost
        post={post}
        featured={featured}
        relatedPosts={relatedPosts}
      >
        <div class="prose prose-lg dark:prose-invert max-w-none font-body leading-relaxed" set:html={renderedHtml} />
      </BlogPost>
    </div>
  ) : null}
</DefaultLayout>

