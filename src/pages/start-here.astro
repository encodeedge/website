---
import { getCollection } from 'astro:content';
import { ChevronRight } from 'lucide-react';

import { Background } from '@/components/background';
import { SITE_TITLE } from '@/consts';
import DefaultLayout from '@/layouts/DefaultLayout.astro';

// 1. Fetch all posts
const allPosts = await getCollection('blog');
const roadmaps = await getCollection('roadmaps');

// 2. Helper to get specific posts by their IDs
const getCuratedPosts = (ids: string[]) => {
    return allPosts
        .filter(post => ids.includes(post.id))
        .sort((a, b) => ids.indexOf(a.id) - ids.indexOf(b.id)); 
};

// --- CONFIGURATION: DEFINE YOUR CURRICULUM HERE ---
const curriculum = [
    {
        title: "The Foundations",
        description: "Before diving into algorithms, master essential Python tools, memory structures, and math foundations.",
        stepNumber: "1",
        color: "lime", 
        groups: [
            {
                subtitle: "Python for Machine Learning",
                description: "Learn the essential syntax, <a href='/topics/python' class='text-primary underline'>Python type hierarchy</a>, and memory references for data-heavy systems.",
                posts: getCuratedPosts([
                    'python-type-hierarchy',
                    'python-variables-and-memory-references',
                    'introduction-to-machine-learning', 
                ])
            },
            {
                subtitle: "Machine Learning Concepts",
                description: "Understand supervised vs unsupervised learning, bias-variance tradeoff, and evaluation metrics.",
                posts: getCuratedPosts([
                    'introduction-to-machine-learning', 
                    'statistics-for-ml',     
                ])
            }
        ]
    },
    {
        title: "Core Algorithms",
        description: "Master the canonical algorithms of ML with hands-on mathematical intuition and scikit-learn recipes.",
        stepNumber: "2",
        color: "blue",
        groups: [
            {
                subtitle: "Supervised Learning",
                description: "Predict continuous values and discrete classes from labeled features.",
                posts: getCuratedPosts([
                    'linear-regression-explained',
                    'decision-trees-tutorial',
                    'k-nearest-neighbors',
                ])
            },
            {
                subtitle: "Unsupervised Learning",
                description: "Discover latent patterns, cluster structures, and compress dimensionalities.",
                posts: getCuratedPosts([
                    'k-means-clustering', 
                    'pca-explained'       
                ])
            }
        ]
    },
    {
        title: "Deep Learning & Neural Architectures",
        description: "From multilayer perceptrons to convolutional networks and transformers.",
        stepNumber: "3",
        color: "rose",
        groups: [
            {
                subtitle: "Neural Network Basics",
                description: "Backpropagation, automatic differentiation, activation functions, and gradient descent.",
                posts: getCuratedPosts([
                    'intro-to-neural-networks',
                    'pytorch-vs-tensorflow',
                ])
            },
            {
                subtitle: "Computer Vision (CNNs)",
                description: "Spatial feature extraction, pooling, and image augmentation pipelines.",
                posts: getCuratedPosts([
                    'first-cnn-project',
                    'image-augmentation-guide' 
                ])
            }
        ]
    }
];

const title = `Start Here | ${SITE_TITLE}`;
const description = "New to Machine Learning? Follow this structured, step-by-step curriculum to master the fundamentals.";

// Helper for pastel badge colors matching Woords palette
const getColorClasses = (color: string) => {
    const colors: Record<string, { bg: string, text: string, darkBg: string, darkText: string }> = {
        lime:   { bg: 'bg-[#E5E795]/50', text: 'text-black', darkBg: 'dark:bg-[#E5E795]/20', darkText: 'dark:text-[#E5E795]' },
        blue:   { bg: 'bg-[#E0E7FF]', text: 'text-[#3730A3]', darkBg: 'dark:bg-[#312E81]/40', darkText: 'dark:text-[#C7D2FE]' },
        rose:   { bg: 'bg-[#FEE2E2]', text: 'text-[#991B1B]', darkBg: 'dark:bg-[#7F1D1D]/40', darkText: 'dark:text-[#FECACA]' },
    };
    return colors[color] || colors.lime;
};
---

<DefaultLayout title={title} description={description}>
    <Background>
        <div class="woords_container py-12 md:py-16">
            
            {/* --- HERO --- */}
            <div class="max-w-2xl mx-auto text-center mb-16 space-y-3">
                <span class="woords_tag_small">
                    Curriculum & Roadmap
                </span>
                <h1 class="font-display font-bold text-3xl sm:text-4xl md:text-5xl lg:text-6xl tracking-tight text-foreground leading-[1.12]">
                    Get Started with Practical AI & ML
                </h1>
                <p class="text-sm sm:text-base text-muted-foreground font-body leading-relaxed max-w-xl mx-auto">
                    A curated path from foundational Python code to production-grade neural networks. Follow the modules below in order.
                </p>
            </div>

            {/* --- DYNAMIC SECTIONS LOOP --- */}
            <div class="space-y-16 max-w-5xl mx-auto">
                {curriculum.map((section) => {
                    const colors = getColorClasses(section.color);
                    
                    return (
                        <section class="rounded-3xl border border-black-150 dark:border-black-800 bg-card p-6 md:p-8 shadow-xs">
                            {/* MAIN SECTION HEADER */}
                            <div class="flex items-center gap-4 mb-8 pb-6 border-b border-black-150 dark:border-black-800/80">
                                <div class={`shrink-0 flex items-center justify-center size-12 rounded-2xl ${colors.bg} ${colors.text} ${colors.darkBg} ${colors.darkText} font-display font-bold text-xl shadow-xs`}>
                                    {section.stepNumber}
                                </div>
                                <div>
                                    <h2 class="font-display font-bold text-2xl md:text-3xl text-foreground tracking-tight">
                                        {section.title}
                                    </h2>
                                    <p class="text-xs sm:text-sm text-muted-foreground mt-1">
                                        {section.description}
                                    </p>
                                </div>
                            </div>

                            {/* SUB-GROUPS LOOP */}
                            <div class="space-y-8">
                                {section.groups.map((group) => (
                                    <div>
                                        <div class="mb-4">
                                            <h3 class="font-display font-bold text-lg text-foreground mb-1">
                                                {group.subtitle}
                                            </h3>
                                            
                                            {group.description && (
                                                <p 
                                                    class="text-xs sm:text-sm text-muted-foreground max-w-2xl"
                                                    set:html={group.description}
                                                />
                                            )}
                                        </div>

                                        {/* POSTS GRID */}
                                        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                                            {group.posts.length > 0 ? (
                                                group.posts.map((post, index) => (
                                                    <a 
                                                        href={`/blog/${post.id}`} 
                                                        class="group flex items-center justify-between p-3.5 bg-background border border-black-150 dark:border-black-800/80 rounded-xl hover:shadow-md hover:border-black dark:hover:border-white transition-all duration-200"
                                                    >
                                                        <div class="flex items-center gap-2.5 min-w-0">
                                                            <span class={`shrink-0 text-[10px] font-bold px-2 py-0.5 rounded-full ${colors.bg} ${colors.text} ${colors.darkBg} ${colors.darkText}`}>
                                                                {index + 1}
                                                            </span>
                                                            <h4 class="text-xs font-semibold text-foreground truncate group-hover:underline">
                                                                {post.data.title}
                                                            </h4>
                                                        </div>
                                                        <ChevronRight className="shrink-0 size-3.5 text-muted-foreground group-hover:translate-x-0.5 transition-transform" />
                                                    </a>
                                                ))
                                            ) : (
                                                <p class="text-xs text-muted-foreground italic py-2 col-span-full">Tutorials for this module are coming soon.</p>
                                            )}
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </section>
                    );
                })}

                {/* --- ROADMAPS SECTION --- */}
                <section class="rounded-3xl border border-black-150 dark:border-black-800 bg-card p-6 md:p-8 shadow-xs">
                    <div class="flex items-center gap-4 mb-8 pb-6 border-b border-black-150 dark:border-black-800/80">
                        <div class="shrink-0 flex items-center justify-center size-12 rounded-2xl bg-[#E5E795]/50 dark:bg-[#E5E795]/20 text-black dark:text-[#E5E795] font-display font-bold text-xl shadow-xs">
                            4
                        </div>
                        <div>
                            <h2 class="font-display font-bold text-2xl md:text-3xl text-foreground tracking-tight">
                                Interactive Visual Roadmaps
                            </h2>
                            <p class="text-xs sm:text-sm text-muted-foreground mt-1">
                                Structured interactive tree paths to follow algorithms step-by-step.
                            </p>
                        </div>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        {roadmaps.filter(r => r.data.featured !== false).map((roadmap) => (
                            <a 
                                href={`/roadmaps/${roadmap.id}`} 
                                class="group flex flex-col justify-between p-5 bg-background border border-black-150 dark:border-black-800/80 rounded-2xl hover:shadow-md hover:border-black dark:hover:border-white transition-all duration-200"
                            >
                                <div>
                                    <div class="relative aspect-16/10 overflow-hidden rounded-xl border border-border/70 bg-black-100 dark:bg-black-900 mb-3">
                                        <img
                                            src={roadmap.data.image || `/assets/roadmaps/${roadmap.id}.svg`}
                                            alt={`Preview for ${roadmap.data.title}`}
                                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                            loading="lazy"
                                        />
                                    </div>
                                    <span class="woords_tag_small mb-2">Roadmap</span>
                                    <h4 class="font-display font-bold text-lg text-foreground group-hover:underline mb-1.5 leading-snug">
                                        {roadmap.data.title}
                                    </h4>
                                    <p class="text-xs text-muted-foreground line-clamp-2 leading-relaxed">
                                        {roadmap.data.description}
                                    </p>
                                </div>
                                <div class="pt-4 mt-2 flex items-center justify-between text-xs font-semibold text-foreground">
                                    <span>Explore Path</span>
                                    <span class="text-primary group-hover:translate-x-1 transition-transform">→</span>
                                </div>
                            </a>
                        ))}
                    </div>
                </section>

                {/* --- NEWSLETTER CTA BANNER --- */}
                <div class="rounded-3xl border border-black-200 dark:border-black-800 bg-[#E5E795]/20 dark:bg-black-900 p-8 md:p-10 text-center space-y-4">
                    <span class="woords_tag_small">Stay Updated</span>
                    <h3 class="font-display font-bold text-2xl md:text-3xl text-foreground tracking-tight">
                        Want weekly code blueprints & updates?
                    </h3>
                    <p class="text-sm text-muted-foreground max-w-lg mx-auto leading-relaxed">
                        Join 10,000+ machine learning engineers. Receive new model explanations, runnable code snippets, and roadmaps in your inbox.
                    </p>
                    <div class="pt-2">
                        <a 
                            href="/subscribe" 
                            class="woords_btn inline-block !bg-ghost-accent !text-black font-semibold text-xs py-3 px-8 shadow-xs"
                        >
                            Subscribe to Updates →
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </Background>
</DefaultLayout>