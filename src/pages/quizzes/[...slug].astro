---
import { getCollection } from 'astro:content';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { InteractiveQuiz } from '@/components/ui/interactive-quiz';
import { CourseNavigation } from '@/components/ui/course-navigation';
import { LessonCurriculumDrawer } from '@/components/ui/lesson-curriculum-drawer';
import { getCoursesMap } from '@/utils/course-map';
import { HelpCircle, Clock, Award } from 'lucide-react';

export async function getStaticPaths() {
  const quizzes = await getCollection('quizzes');
  return quizzes.map(quiz => ({
    params: { slug: quiz.id },
    props: { quiz },
  }));
}

const { quiz } = Astro.props;
const coursesMap = await getCoursesMap();
---

<DefaultLayout title={`${quiz.data.title} | Checkpoint Quiz`} description={quiz.data.description || quiz.data.title}>
  <div class="max-w-4xl mx-auto px-4 py-8 md:py-16 space-y-8">
    
    <!-- Top Navigation Bar -->
    <div class="space-y-4">
      <CourseNavigation coursesMap={coursesMap} currentItemId={quiz.id} itemType="quiz" mode="top" client:load />

      <div class="flex items-center justify-between border-b border-border/60 pb-4 flex-wrap gap-3">
        <LessonCurriculumDrawer 
          coursesMap={coursesMap} 
          currentItemId={quiz.id} 
          itemType="quiz" 
          client:load 
        />
        
        <div class="flex items-center gap-2 text-xs text-muted-foreground font-semibold">
          <Clock class="w-3.5 h-3.5" />
          <span>Approx. 15 min</span>
        </div>
      </div>
    </div>

    <!-- Quiz Header -->
    <div class="space-y-4 pt-2">
      <div class="flex items-center gap-3">
        <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
          Knowledge Checkpoint
        </span>
        {quiz.data.questions && (
          <span class="text-xs font-semibold text-muted-foreground">
            {quiz.data.questions.length} questions
          </span>
        )}
      </div>

      <h1 class="font-display font-bold text-3xl sm:text-4xl md:text-5xl tracking-tight text-foreground leading-[1.2]">
        {quiz.data.title}
      </h1>

      {quiz.data.description && (
        <p class="text-base sm:text-lg text-muted-foreground font-body leading-relaxed max-w-3xl">
          {quiz.data.description}
        </p>
      )}
    </div>

    <!-- Interactive Quiz Component -->
    {quiz.data.questions && (
      <div class="my-6">
        <InteractiveQuiz 
          questions={quiz.data.questions} 
          quizId={quiz.id} 
          client:load 
        />
      </div>
    )}

    <!-- Bottom Navigation -->
    <div class="pt-8 border-t border-border/60">
      <CourseNavigation coursesMap={coursesMap} currentItemId={quiz.id} itemType="quiz" mode="bottom" client:load />
    </div>

  </div>
</DefaultLayout>
