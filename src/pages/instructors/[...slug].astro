---
import { getCollection, render } from 'astro:content';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';

export async function getStaticPaths() {
  const instructors = await getCollection('instructors');
  return instructors.map(instructor => ({
    params: { slug: instructor.id },
    props: { instructor },
  }));
}

const { instructor } = Astro.props;
const { Content } = await render(instructor);

const allCourses = await getCollection('courses');
const instructorCourses = allCourses.filter(course => course.data.instructor === instructor.id && course.data.status === 'published');
---

<DefaultLayout title={instructor.data.name} description={`Profile of ${instructor.data.name}`}>
  <div class="py-12 md:py-16 max-w-4xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row gap-8 items-start mb-12">
      {instructor.data.avatar && (
        <div class="w-36 h-36 md:w-44 md:h-44 flex-shrink-0">
          <img 
            src={instructor.data.avatar} 
            alt={instructor.data.name} 
            class="w-full h-full object-cover rounded-full border-2 border-black-200 dark:border-black-700 shadow-md"
          />
        </div>
      )}
      
      <div>
        <span class="inline-block text-xs font-semibold uppercase tracking-wider bg-black-100 dark:bg-black-800 text-muted-foreground px-3 py-1 rounded-full mb-3">
          Instructor Profile
        </span>
        <h1 class="text-3xl md:text-5xl font-bold font-display tracking-tight text-foreground mb-3">{instructor.data.name}</h1>
        
        {instructor.data.socialLinks && instructor.data.socialLinks.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-6">
            {instructor.data.socialLinks.map(link => (
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="woords_tag text-xs">
                {link.platform} ↗
              </a>
            ))}
          </div>
        )}

        <div class="prose prose-lg dark:prose-invert max-w-none font-body">
          <Content />
        </div>
      </div>
    </div>

    {instructorCourses.length > 0 && (
      <div class="mt-12 pt-8 border-t border-black-100 dark:border-black-800">
        <h2 class="text-2xl md:text-3xl font-bold font-display tracking-tight text-foreground mb-6">Courses by {instructor.data.name}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {instructorCourses.map(course => (
            <div class="rounded-2xl border border-black-200 dark:border-black-800 bg-card p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300">
              <span class="woords_tag capitalize text-xs mb-3 inline-block">{course.data.level}</span>
              <h3 class="text-xl font-bold font-display text-foreground mb-2">
                <a href={`/courses/${course.id}`} class="hover:text-primary transition-colors">{course.data.title}</a>
              </h3>
              <p class="text-muted-foreground font-body text-sm line-clamp-2">{course.data.shortDescription}</p>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</DefaultLayout>

