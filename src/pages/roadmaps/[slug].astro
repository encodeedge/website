      </div>
      <div class="flex items-center justify-between py-1">
        <span class="text-muted-foreground">Quick Cycle Status</span>
        <kbd class="shortcut-key">Space</kbd>
      </div>
      <div class="flex items-center justify-between py-1">
        <span class="text-muted-foreground">Open Topic Drawer</span>
        <kbd class="shortcut-key">Enter</kbd>
      </div>
      <div class="flex items-center justify-between py-1">
        <span class="text-muted-foreground">Toggle Star / Favorite</span>
        <kbd class="shortcut-key">S</kbd>
      </div>
      <div class="flex items-center justify-between py-1">
        <span class="text-muted-foreground">Focus Search Input</span>
        <kbd class="shortcut-key">/</kbd>
      </div>
      <div class="flex items-center justify-between py-1">
        <span class="text-muted-foreground">Close Drawer &amp; Modals</span>
