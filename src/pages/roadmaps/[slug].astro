{/* 8. Keyboard Shortcuts Cheatsheet Modal */}
<div id="shortcutsModal" class="modal-overlay">
  <div class="modal-content max-w-md text-left">
    <div class="flex items-center justify-between pb-3 border-b border-border mb-4">
      <div class="flex items-center gap-2">
        <svg class="size-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
