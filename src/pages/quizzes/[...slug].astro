---
import { getCollection } from 'astro:content';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { CourseLearningStudio } from '@/components/interactive/CourseLearningStudio';
import { InteractiveQuiz } from '@/components/ui/interactive-quiz';
import { getCoursesMap } from '@/utils/course-map';
import { getFeatureFlags } from '@/lib/settings';

export async function getStaticPaths() {
  const quizzes = await getCollection('quizzes');
  return quizzes.map(quiz => ({
    params: { slug: quiz.id },
    props: { quiz },
  }));
}

const { quiz } = Astro.props;
const coursesMap = await getCoursesMap();
const flags = await getFeatureFlags();

// Load all collections to build full curriculum context
const allCourses = await getCollection('courses');
const allLessons = await getCollection('lessons');
const allQuizzes = await getCollection('quizzes');
const allAssignments = await getCollection('assignments');

const requestedCourseId = Astro.url.searchParams.get('course');
let activeCourse = requestedCourseId 
  ? allCourses.find(c => c.id === requestedCourseId) 
  : allCourses.find(c => c.data.chapters?.some(ch => ch.items?.some(it => it.discriminant === 'quiz' && it.value?.quizRef === quiz.id))) || allCourses[0];

// Format chapters into structured format matching CourseLearningStudio
const structuredChapters = (activeCourse?.data.chapters || []).map((chapter, chIdx) => {
  const chapterItems = (chapter.items || []).map((item, itemIdx) => {
    let type: 'lesson' | 'quiz' | 'assignment' = 'lesson';
    let id = '';
    let title = '';
    let lessonType = 'article';
    let duration = 20;

    let comingSoon = false;
    let draft = false;
    let comingSoonMessage = '';

    if (item.discriminant === 'lesson' && item.value.lessonRef) {
      type = 'lesson';
      id = item.value.lessonRef;
      const l = allLessons.find(x => x.id === id);
      title = l?.data.title || id.replace(/-/g, ' ');
      lessonType = l?.data.lessonType || 'article';
      duration = l?.data.duration || 20;
      comingSoon = l?.data.comingSoon || false;
      draft = l?.data.draft || false;
      comingSoonMessage = l?.data.comingSoonMessage || '';
    } else if (item.discriminant === 'quiz' && item.value.quizRef) {
      type = 'quiz';
      id = item.value.quizRef;
      const q = allQuizzes.find(x => x.id === id);
      title = q?.data.title || 'Interactive Quiz';
      lessonType = 'quiz';
      duration = 15;
    } else if (item.discriminant === 'assignment' && item.value.assignmentRef) {
      type = 'assignment';
      id = item.value.assignmentRef;
      const a = allAssignments.find(x => x.id === id);
      title = a?.data.title || 'Hands-on Project';
      lessonType = 'assignment';
      duration = 90;
    }

    const url = `/${type === 'lesson' ? 'lessons' : type === 'quiz' ? 'quizzes' : 'assignments'}/${id}?course=${activeCourse?.id || ''}`;

    return {
      id,
      type,
      title,
      lessonType,
      duration,
      url,
      isFree: chIdx === 0 && itemIdx < 2,
      comingSoon,
      draft,
      comingSoonMessage,
    };
  });

  return {
    title: chapter.title,
    description: chapter.description,
    items: chapterItems
  };
});
---

<DefaultLayout 
  title={`${quiz.data.title} | ${activeCourse?.data.title || 'Course'} Checkpoint Quiz`} 
  description={quiz.data.description || quiz.data.title}
>
  <div class="w-full">
    <CourseLearningStudio
      client:load
      courseId={activeCourse?.id || 'system-design'}
      courseTitle={activeCourse?.data.title || 'Course'}
      currentLesson={{
        id: quiz.id,
        title: quiz.data.title,
        description: quiz.data.description,
        lessonType: 'quiz',
        duration: 15
      }}
      chapters={structuredChapters}
    >
      <div class="space-y-6 pt-2">
        {quiz.data.questions && quiz.data.questions.length > 0 ? (
          <InteractiveQuiz 
            questions={quiz.data.questions} 
            quizId={quiz.id} 
            courseId={activeCourse?.id}
            coursesMap={coursesMap}
            passingScorePercentage={quiz.data.passingScorePercentage ?? flags.gamification?.quizMinimumPassPercentage ?? 0}
            markCompletedOnAttempt={quiz.data.markCompletedOnAttempt ?? true}
            spacedRepetitionEnabled={flags.spacedRepetition.enabled}
            gamificationEnabled={flags.gamification.enabled}
            client:load 
          />
        ) : (
          <div class="p-8 text-center bg-card rounded-2xl border border-border space-y-2">
            <p class="text-sm font-semibold text-foreground">No questions configured for this quiz yet.</p>
            <p class="text-xs text-muted-foreground">You can manage and add questions to this checkpoint via Keystatic CMS.</p>
          </div>
        )}
      </div>
    </CourseLearningStudio>
  </div>
</DefaultLayout>
