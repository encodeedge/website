---
import { getCollection, render } from 'astro:content';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { CourseCurriculumAccordion } from '@/components/ui/course-curriculum-accordion';
import { CourseProgressCard } from '@/components/ui/course-progress-card';
import { CoursePrerequisiteFlow } from '@/components/interactive/CoursePrerequisiteFlow';
import { CourseFlashcardsDrawer } from '@/components/interactive/CourseFlashcardsDrawer';
import { CourseCertificate } from '@/components/interactive/CourseCertificate';
import { 
  Clock, 
  BookOpen, 
  Code, 
  Award, 
  CheckCircle2, 
  Sparkles, 
  ChevronRight, 
  Users, 
  ShieldCheck,
  GraduationCap
} from 'lucide-react';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map(course => ({
    params: { slug: course.id },
    props: { course },
  }));
}

const { course } = Astro.props;
const { Content } = await render(course);

const allLessons = await getCollection('lessons');
const allQuizzes = await getCollection('quizzes');
const allAssignments = await getCollection('assignments');
const allInstructors = await getCollection('instructors');
const allBatches = await getCollection('batches');

const instructor = allInstructors.find(i => i.id === course.data.instructor);
const relatedBatches = allBatches.filter(b => b.data.course === course.id);

// Process chapters into structured format for accordion and progress tracking
let flatItems: Array<{ id: string; type: string; title: string; url: string }> = [];
let totalDurationMinutes = 0;

const structuredChapters = (course.data.chapters || []).map((chapter, chIdx) => {
  const chapterItems = (chapter.items || []).map(item => {
    let type: 'lesson' | 'quiz' | 'assignment' = 'lesson';
    let id = '';
    let title = '';
    let lessonType = 'article';
    let duration = 20;

    if (item.discriminant === 'lesson' && item.value.lessonRef) {
      type = 'lesson';
      id = item.value.lessonRef;
      const lesson = allLessons.find(l => l.id === id);
      title = lesson?.data.title || id.replace(/-/g, ' ');
      lessonType = lesson?.data.lessonType || 'article';
      duration = lesson?.data.duration || 20;
    } else if (item.discriminant === 'quiz' && item.value.quizRef) {
      type = 'quiz';
      id = item.value.quizRef;
      const quiz = allQuizzes.find(q => q.id === id);
      title = quiz?.data.title || 'Interactive Quiz';
      duration = 15;
    } else if (item.discriminant === 'assignment' && item.value.assignmentRef) {
      type = 'assignment';
      id = item.value.assignmentRef;
      const assignment = allAssignments.find(a => a.id === id);
      title = assignment?.data.title || 'Hands-on Project';
      duration = 90;
    }

    const url = `/${type === 'lesson' ? 'lessons' : type === 'quiz' ? 'quizzes' : 'assignments'}/${id}?course=${course.id}`;

    totalDurationMinutes += duration;

    const itemRecord = {
      id,
      type,
      title,
      lessonType,
      duration,
      url,
    };

    flatItems.push({ id, type, title, url });

    return itemRecord;
  });

  return {
    title: chapter.title,
    description: chapter.description,
    items: chapterItems,
  };
});

const hours = Math.floor(totalDurationMinutes / 60);
const mins = totalDurationMinutes % 60;
const totalDurationStr = hours > 0 ? `${hours}h ${mins}m` : `${mins}m`;
---

<DefaultLayout 
  title={`${course.data.title} | EncodeEdge Academy`} 
  description={course.data.shortDescription || course.data.title}
>
  <div class="py-8 md:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-muted-foreground">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <ChevronRight class="w-3.5 h-3.5" />
      <a href="/courses" class="hover:text-foreground transition-colors">Courses</a>
      <ChevronRight class="w-3.5 h-3.5" />
      <span class="text-foreground font-medium truncate max-w-xs">{course.data.title}</span>
    </nav>

    <!-- Course Header Hero -->
    <header class="space-y-6 max-w-4xl">
      <div class="flex items-center gap-2.5 flex-wrap">
        <span class={`text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full ${
          course.data.level === 'advanced' 
            ? 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20' 
            : course.data.level === 'intermediate'
              ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20'
              : 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20'
        }`}>
          {course.data.level} Level
        </span>
        <span class="text-xs font-semibold uppercase tracking-wider px-3 py-1 rounded-full bg-muted text-muted-foreground border border-border">
          Self-Paced Track
        </span>
        <span class="text-xs font-semibold px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center gap-1">
          <Award class="w-3.5 h-3.5" /> Certificate Included
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-display tracking-tight text-foreground leading-[1.15]">
        {course.data.title}
      </h1>

      <p class="text-base sm:text-lg md:text-xl text-muted-foreground font-body leading-relaxed">
        {course.data.shortDescription}
      </p>

      <!-- Key Metadata Strip -->
      <div class="flex items-center gap-6 text-xs text-muted-foreground flex-wrap pt-2">
        <div class="flex items-center gap-2">
          <Clock class="w-4 h-4 text-primary" />
          <span><strong class="text-foreground">{totalDurationStr}</strong> total content</span>
        </div>
        <div class="flex items-center gap-2">
          <BookOpen class="w-4 h-4 text-primary" />
          <span><strong class="text-foreground">{flatItems.length}</strong> lessons &amp; projects</span>
        </div>
        <div class="flex items-center gap-2">
          <GraduationCap class="w-4 h-4 text-primary" />
          <span>Instructor: <strong class="text-foreground">{instructor?.data.name || 'Atul Jha'}</strong></span>
        </div>
        <div class="ml-auto flex items-center gap-2 flex-wrap">
          <CourseFlashcardsDrawer initialCategory={course.id} client:load />
          <CourseCertificate
            courseId={course.id}
            courseTitle={course.data.title}
            instructorName={instructor?.data.name || 'Atul Jha'}
            client:load
          />
        </div>
      </div>
    </header>

    <!-- Main Content & Sidebar Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
      
      <!-- Left 2-Column: Course Syllabus & Overview -->
      <div class="lg:col-span-2 space-y-12">
        
        <!-- Course Artwork Banner -->
        {course.data.coverImage && (
          <div class="w-full aspect-video rounded-3xl overflow-hidden border border-border/80 bg-muted shadow-sm">
            <img 
              src={course.data.coverImage} 
              alt={course.data.title} 
              class="w-full h-full object-cover"
            />
          </div>
        )}

        <!-- Course About / Markdown Prose -->
        <section class="space-y-4">
          <h2 class="text-2xl font-bold font-display text-foreground border-b border-border/60 pb-3">
            Course Overview
          </h2>
          <div class="prose prose-lg dark:prose-invert max-w-none font-body leading-relaxed">
            <Content />
          </div>
        </section>

        <!-- What You'll Master -->
        <section class="rounded-3xl border border-border/80 bg-card p-6 md:p-8 space-y-6 shadow-sm">
          <h2 class="text-xl sm:text-2xl font-bold font-display text-foreground flex items-center gap-2">
            <Sparkles class="w-5 h-5 text-primary" />
            <span>Key Competencies You'll Build</span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div class="flex items-start gap-3 p-3.5 rounded-xl bg-muted/30 border border-border/40">
              <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
              <span class="text-foreground font-medium">Mathematical foundations written from pure first principles</span>
            </div>
            <div class="flex items-start gap-3 p-3.5 rounded-xl bg-muted/30 border border-border/40">
              <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
              <span class="text-foreground font-medium">Clean, reproducible PyTorch / Python code without black boxes</span>
            </div>
            <div class="flex items-start gap-3 p-3.5 rounded-xl bg-muted/30 border border-border/40">
              <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
              <span class="text-foreground font-medium">Production deployment and low-latency inference patterns</span>
            </div>
            <div class="flex items-start gap-3 p-3.5 rounded-xl bg-muted/30 border border-border/40">
              <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
              <span class="text-foreground font-medium">Hands-on capstone portfolio piece ready for GitHub</span>
            </div>
          </div>
        </section>

        <!-- Course Syllabus / Curriculum Accordion -->
        <section class="space-y-6">
          <div class="flex items-center justify-between flex-wrap gap-4 border-b border-border/60 pb-3">
            <div>
              <h2 class="text-2xl font-bold font-display text-foreground">
                Course Curriculum
              </h2>
              <p class="text-xs text-muted-foreground mt-1">
                {structuredChapters.length} chapters • {flatItems.length} total lessons &amp; checkpoints
              </p>
            </div>
          </div>

          <CourseCurriculumAccordion 
            courseId={course.id} 
            chapters={structuredChapters} 
            client:load 
          />
        </section>

        <!-- Career Path & Prerequisite Flow -->
        <section>
          <CoursePrerequisiteFlow courseId={course.id} client:load />
        </section>
      </div>

      <!-- Right 1-Column: Sticky Progress Card & Instructor -->
      <aside class="lg:col-span-1 space-y-6 lg:sticky lg:top-[8.25rem]">
        
        <!-- Interactive Course Progress Card -->
        <CourseProgressCard 
          courseId={course.id}
          flatItems={flatItems}
          totalDurationMinutes={totalDurationMinutes}
          courseTitle={course.data.title}
          client:load
        />

        <!-- Instructor Profile Card -->
        {instructor && (
          <div class="rounded-2xl border border-border/80 bg-card p-6 shadow-sm space-y-4">
            <div class="text-[10px] uppercase font-bold tracking-wider text-muted-foreground">
              Your Course Instructor
            </div>
            <div class="flex items-center gap-3.5">
              <img 
                src={instructor.data.avatar || '/assets/python-variables-and-memory-references/authorImage.png'} 
                alt={instructor.data.name} 
                class="w-12 h-12 rounded-full object-cover border border-border"
              />
              <div>
                <h4 class="font-bold font-display text-base text-foreground leading-snug">
                  {instructor.data.name}
                </h4>
                <p class="text-xs text-muted-foreground">
                  AI Practitioner &amp; Founder, EncodeEdge
                </p>
              </div>
            </div>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Experienced engineer and educator passionate about demystifying complex AI algorithms and making them accessible through clean code.
            </p>
            <a 
              href={`/instructors/${course.data.instructor}`} 
              class="text-xs font-semibold text-primary hover:underline inline-block pt-1"
            >
              View Instructor Bio →
            </a>
          </div>
        )}

        <!-- Live Cohort Card (if batches exist) -->
        {relatedBatches.length > 0 && (
          <div class="rounded-2xl border border-amber-500/30 bg-amber-500/5 p-5 space-y-3">
            <div class="flex items-center gap-2 text-xs font-bold text-amber-700 dark:text-amber-400">
              <Users class="w-4 h-4" />
              <span>Live Mentorship Available</span>
            </div>
            <h4 class="font-bold text-sm text-foreground">
              {relatedBatches[0].data.title}
            </h4>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Prefer live weekend workshops, personalized code critiques, and direct Slack access?
            </p>
            <a 
              href="/batches"
              class="block w-full text-center py-2 px-3 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-semibold text-xs transition-colors shadow-sm"
            >
              View Live Cohort Schedule →
            </a>
          </div>
        )}

      </aside>

    </div>
  </div>
</DefaultLayout>
