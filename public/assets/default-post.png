<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F8FAFC" class="light-bg-0" />
      <stop offset="100%" stop-color="#EFF6FF" class="light-bg-1" />
    </linearGradient>
    <pattern id="dotGrid" width="28" height="28" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.5" fill="#CBD5E1" opacity="0.6" />
    </pattern>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FDA4AF" />
      <stop offset="50%" stop-color="#A2D2FF" />
      <stop offset="100%" stop-color="#C084FC" />
    </linearGradient>
    <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="32" />
    </filter>
  </defs>

  <style>
    @media (prefers-color-scheme: dark) {
      .bg-rect { fill: #0F172A !important; }
      .grid-pattern { opacity: 0.2 !important; }
      .card-box { fill: #1E293B !important; stroke: #334155 !important; }
      .title-text { fill: #F8FAFC !important; }
      .subtitle-text { fill: #94A3B8 !important; }
    }
  </style>

  <!-- Background Base -->
  <rect width="1200" height="675" fill="url(#bgGrad)" class="bg-rect" />
  <rect width="1200" height="675" fill="url(#dotGrid)" class="grid-pattern" />

  <!-- Soft Ambient Glow Orbs -->
  <circle cx="250" cy="200" r="180" fill="#FDA4AF" opacity="0.18" filter="url(#softGlow)" />
  <circle cx="950" cy="450" r="220" fill="#A2D2FF" opacity="0.18" filter="url(#softGlow)" />
  <circle cx="600" cy="330" r="160" fill="#C084FC" opacity="0.12" filter="url(#softGlow)" />

  <!-- Central Editorial Frame -->
  <g transform="translate(350, 185)">
    <rect width="500" height="300" rx="24" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="2" class="card-box" />
    
    <!-- Decorative Header Bar -->
    <path d="M 0 24 Q 0 0 24 0 L 476 0 Q 500 0 500 24 L 500 64 L 0 64 Z" fill="url(#accentGrad)" opacity="0.15" />
    <line x1="0" y1="64" x2="500" y2="64" stroke="#E2E8F0" stroke-width="1.5" />

    <!-- Three Window Dots -->
    <circle cx="28" cy="32" r="5" fill="#FDA4AF" />
    <circle cx="46" cy="32" r="5" fill="#E5E795" />
    <circle cx="64" cy="32" r="5" fill="#A2D2FF" />

    <!-- Editorial Badge -->
    <rect x="200" y="22" width="100" height="20" rx="10" fill="#FFFFFF" opacity="0.9" />
    <text x="250" y="36" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="10" font-weight="700" fill="#64748B" letter-spacing="1.5">BLUEPRINT</text>

    <!-- Center Monogram -->
    <g transform="translate(215, 95)">
      <rect width="70" height="70" rx="18" fill="url(#accentGrad)" />
      <text x="35" y="44" text-anchor="middle" font-family="'Fraunces', Georgia, serif" font-size="28" font-weight="800" fill="#FFFFFF">EE</text>
    </g>

    <!-- Title & Subtitle -->
    <text x="250" y="205" text-anchor="middle" font-family="'Fraunces', Georgia, serif" font-size="22" font-weight="700" fill="#0F172A" class="title-text">EncodeEdge</text>
    <text x="250" y="235" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="500" fill="#64748B" letter-spacing="0.5" class="subtitle-text">Deep Dive Engineering & AI Blueprints</text>
  </g>
</svg>
