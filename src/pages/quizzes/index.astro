---
import { getCollection } from 'astro:content';
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const quizzes = await getCollection('quizzes');
---

<DefaultLayout title="Quizzes | Encode Edge" description="Test your knowledge with our collection of interactive AI and ML quizzes.">
  <div class="woords_container py-12 md:py-16">
    <header class="max-w-2xl mx-auto text-center mb-12 space-y-3">
      <span class="woords_tag_small">Knowledge Checks</span>
      <h1 class="font-display font-bold text-3xl sm:text-4xl md:text-5xl tracking-tight text-foreground">
        Interactive Quizzes
      </h1>
      <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
        Reinforce key concepts, benchmark your understanding, and test your retention with interactive quizzes.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {quizzes.map(quiz => (
        <a 
          href={`/quizzes/${quiz.id}`}
          class="rounded-2xl border border-black-200 dark:border-black-800 bg-card p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="woords_tag_small">
                Quiz
              </span>
              <span class="text-[11px] font-semibold text-muted-foreground">
                {quiz.data.questions?.length || 0} Questions
              </span>
            </div>

            <h2 class="font-display font-bold text-xl text-foreground group-hover:underline leading-snug mb-2">
              {quiz.data.title}
            </h2>

            {quiz.data.description && (
              <p class="text-xs text-muted-foreground line-clamp-3 leading-relaxed mb-4">
                {quiz.data.description}
              </p>
            )}
          </div>

          <div class="pt-4 border-t border-black-150 dark:border-black-800/80 flex items-center justify-between text-xs font-semibold text-foreground">
            <span>Take Quiz</span>
            <span class="text-primary transition-transform duration-200 group-hover:translate-x-1">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</DefaultLayout>
