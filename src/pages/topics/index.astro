---
// src/pages/topics/index.astro
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '@/consts';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { 
  ArrowRight, 
  Sparkles, 
  Brain, 
  Bot, 
  LineChart, 
  MessageSquareCode, 
  Eye, 
  Code2, 
  Terminal, 
  Compass, 
  BookOpen, 
  Layers 
} from 'lucide-react';
import { TOPIC_LIST } from '@/lib/topics';

const allPosts = await getCollection('blog');
const allRoadmaps = await getCollection('roadmaps');
const roadmapSlugs = new Set(allRoadmaps.map(r => r.id));

// Calculate counts, total read times, and sample articles for each topic
const topicStats = TOPIC_LIST.map((meta) => {
  const posts = allPosts.filter((p) => p.data.topics && p.data.topics.includes(meta.value as any));
  const totalReadTime = posts.reduce((sum, p) => sum + (p.data.readTime || 5), 0);
  const recentArticles = posts
    .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
    .slice(0, 2);

  const hasRoadmap = meta.roadmapSlug && roadmapSlugs.has(meta.roadmapSlug);

  return {
    ...meta,
    count: posts.length,
    totalReadTime,
    recentArticles,
    hasRoadmap,
  };
}).sort((a, b) => b.count - a.count);

const title = `Topic Knowledge Hubs | ${SITE_TITLE}`;
const description = 'Browse our curated engineering tracks from foundational Python and statistical mathematics to deep learning architectures and production LLMs.';
---

<DefaultLayout title={title} description={description}>
  <div class="py-12 md:py-16 max-w-6xl mx-auto px-4 sm:px-6">
    
    {/* Page Header */}
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-black-100 dark:bg-black-800 text-foreground mb-4">
        <Sparkles class="size-3.5 text-primary" />
        Knowledge Directory
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold font-display tracking-tight text-foreground mb-4">
        Explore Topic Hubs
      </h1>
      <p class="text-base sm:text-lg text-muted-foreground font-body leading-relaxed">
        Select a primary domain to explore in-depth tutorials, mathematical formulations, and production-tested code blueprints.
      </p>

      {/* Quick Jump Topic Pills */}
      <div class="flex items-center justify-center gap-2 flex-wrap mt-6">
        {topicStats.map((t) => (
          <a
            href={`/topics/${t.value}`}
            class="px-3 py-1 rounded-full text-xs font-semibold border border-black-150 dark:border-black-800 bg-card hover:bg-black-50 dark:hover:bg-black-850 hover:border-primary/50 text-foreground transition-all"
          >
            {t.label} ({t.count})
          </a>
        ))}
      </div>
    </div>

    {/* Topic Cards Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {topicStats.map((topic) => (
        <a 
          href={`/topics/${topic.value}`} 
          class="group flex flex-col justify-between p-6 border border-black-200 dark:border-black-800 rounded-3xl bg-card hover:shadow-md hover:-translate-y-1 transition-all duration-300 relative overflow-hidden"
        >
          <div>
            {/* Top Row: Icon + Count */}
            <div class="flex items-center justify-between gap-3 mb-4">
              <div 
                class="size-12 rounded-2xl flex items-center justify-center text-black shadow-2xs group-hover:scale-105 transition-transform"
                style={`background-color: ${topic.color};`}
              >
                {topic.value === 'machine-learning' && <Brain class="size-6 text-black" />}
                {topic.value === 'deep-learning' && <Bot class="size-6 text-black" />}
                {topic.value === 'data-science' && <LineChart class="size-6 text-black" />}
                {topic.value === 'python' && <Terminal class="size-6 text-black" />}
                {topic.value === 'nlp' && <MessageSquareCode class="size-6 text-black" />}
                {topic.value === 'computer-vision' && <Eye class="size-6 text-black" />}
                {topic.value === 'web-dev' && <Code2 class="size-6 text-black" />}
              </div>

              <div class="flex items-center gap-1.5">
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-secondary text-secondary-foreground font-mono">
                  {topic.count} {topic.count === 1 ? 'article' : 'articles'}
                </span>
              </div>
            </div>

            {/* Title & Description */}
            <h2 class="text-2xl font-bold font-display text-foreground group-hover:text-primary transition-colors leading-tight mb-2">
              {topic.label}
            </h2>

            <p class="text-xs sm:text-sm text-muted-foreground font-body line-clamp-3 leading-relaxed mb-4">
              {topic.description}
            </p>

            {/* Recent Articles Preview */}
            {topic.recentArticles.length > 0 && (
              <div class="space-y-1.5 pt-3 border-t border-black-150 dark:border-black-800 mb-4">
                <span class="text-[10px] font-bold font-display uppercase tracking-wider text-muted-foreground block mb-1">
                  Recent In This Hub:
                </span>
                {topic.recentArticles.map((article) => (
                  <div class="text-xs text-foreground/90 font-medium truncate flex items-center gap-1.5 group-hover:text-foreground">
                    <span class="size-1.5 rounded-full bg-primary shrink-0"></span>
                    <span class="truncate">{article.data.title}</span>
                  </div>
                ))}
              </div>
            )}
          </div>

          {/* Card Footer: Action & Roadmap indicator */}
          <div class="pt-4 border-t border-black-150 dark:border-black-800 flex items-center justify-between text-xs font-semibold text-foreground group-hover:text-primary transition-colors">
            <span class="flex items-center gap-1">
              Explore {topic.label}
              <ArrowRight class="size-3.5 transform group-hover:translate-x-1 transition-transform" />
            </span>

            {topic.hasRoadmap && (
              <span class="inline-flex items-center gap-1 text-[11px] text-muted-foreground font-mono">
                <Compass class="size-3 text-primary" />
                Roadmap
              </span>
            )}
          </div>
        </a>
      ))}
    </div>

  </div>
</DefaultLayout>