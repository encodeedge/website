---
import { getCollection, render } from 'astro:content';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { CourseLearningStudio } from '@/components/interactive/CourseLearningStudio';
import { CodeSandboxRunner } from '@/components/interactive/CodeSandboxRunner';
import { hasSnippetForContent } from '@/lib/code-snippets';
import { NeuralPlayground } from '@/components/interactive/NeuralPlayground';
import { GradientDescentLab } from '@/components/interactive/GradientDescentLab';
import { MemoryExplorer } from '@/components/interactive/MemoryExplorer';
import { Callout, VideoEmbed, AudioPlayer, QuizBlock, NewsletterCTA, StatCard, CodeSnippet, ReferenceCard, InteractiveLab, CodeSandbox, MathFormula, PaywallGuard } from '@/components/mdx';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  const paths = lessons.map(lesson => ({
    params: { slug: lesson.id },
    props: { lesson },
  }));
  // Legacy aliases so old links (dlfn-*, fds-*, etc.) automatically resolve
  for (const lesson of lessons) {
    if (lesson.id.startsWith('dl-')) {
      paths.push({
        params: { slug: lesson.id.replace(/^dl-/, 'dlfn-') },
        props: { lesson },
      });
    } else if (lesson.id.startsWith('ds-')) {
      paths.push({
        params: { slug: lesson.id.replace(/^ds-/, 'fds-') },
        props: { lesson },
      });
    }
  }
  // Specific legacy names renamed during refinement
  const specificAliases: Record<string, string> = {
    'dl-backprop-computation-graphs-and-chain-rule': 'dl-computation-graphs-and-the-multivariate-chain-rule',
    'dl-adaptive-learning-rates-rmsprop-adam': 'dl-adaptive-learning-rate-algorithms-ada-grad-rms-prop-and-adam',
    'dl-batch-normalization-mechanics': 'dl-batch-normalization',
    'dlfn-backprop-computation-graphs-and-chain-rule': 'dl-computation-graphs-and-the-multivariate-chain-rule',
    'dlfn-adaptive-learning-rates-rmsprop-adam': 'dl-adaptive-learning-rate-algorithms-ada-grad-rms-prop-and-adam',
    'dlfn-batch-normalization-mechanics': 'dl-batch-normalization',
    'dl-six-jars-framework-data-and-tasks': 'dl-data-and-tasks',
    'dl-six-jars-models-and-loss-functions': 'dl-models-and-loss-functions',
    'dl-six-jars-learning-and-evaluation': 'dl-learning-algorithms-and-evaluation',
    'dlfn-six-jars-framework-data-and-tasks': 'dl-data-and-tasks',
    'dlfn-six-jars-models-and-loss-functions': 'dl-models-and-loss-functions',
    'dlfn-six-jars-learning-and-evaluation': 'dl-learning-algorithms-and-evaluation',
  };
  for (const [oldSlug, targetId] of Object.entries(specificAliases)) {
    const targetLesson = lessons.find(l => l.id === targetId);
    if (targetLesson) {
      paths.push({
        params: { slug: oldSlug },
        props: { lesson: targetLesson },
      });
    }
  }
  return paths;
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);

// Load all collections to build full curriculum context
const allCourses = await getCollection('courses');
const allLessons = await getCollection('lessons');
const allQuizzes = await getCollection('quizzes');
const allAssignments = await getCollection('assignments');

const requestedCourseId = Astro.url.searchParams.get('course');
let activeCourse = requestedCourseId 
  ? allCourses.find(c => c.id === requestedCourseId) 
  : allCourses.find(c => c.data.chapters?.some(ch => ch.items?.some(it => it.discriminant === 'lesson' && it.value?.lessonRef === lesson.id))) || allCourses[0];

// Format chapters into structured format
const structuredChapters = (activeCourse?.data.chapters || []).map((chapter, chIdx) => {
  const chapterItems = (chapter.items || []).map((item, itemIdx) => {
    let type: 'lesson' | 'quiz' | 'assignment' = 'lesson';
    let id = '';
    let title = '';
    let lessonType = 'article';
    let duration = 20;

    let comingSoon = false;
    let draft = false;
    let comingSoonMessage = '';

    if (item.discriminant === 'lesson' && item.value.lessonRef) {
      type = 'lesson';
      id = item.value.lessonRef;
      const l = allLessons.find(x => x.id === id);
      title = l?.data.title || id.replace(/-/g, ' ');
      lessonType = l?.data.lessonType || 'article';
      duration = l?.data.duration || 20;
      comingSoon = l?.data.comingSoon || false;
      draft = l?.data.draft || false;
      comingSoonMessage = l?.data.comingSoonMessage || '';
    } else if (item.discriminant === 'quiz' && item.value.quizRef) {
      type = 'quiz';
      id = item.value.quizRef;
      const q = allQuizzes.find(x => x.id === id);
      title = q?.data.title || 'Interactive Quiz';
      duration = 15;
    } else if (item.discriminant === 'assignment' && item.value.assignmentRef) {
      type = 'assignment';
      id = item.value.assignmentRef;
      const a = allAssignments.find(x => x.id === id);
      title = a?.data.title || 'Hands-on Project';
      duration = 90;
    }

    const url = `/${type === 'lesson' ? 'lessons' : type === 'quiz' ? 'quizzes' : 'assignments'}/${id}?course=${activeCourse?.id || ''}`;

    return {
      id,
      type,
      title,
      lessonType,
      duration,
      url,
      isFree: chIdx === 0 && itemIdx < 2,
      comingSoon,
      draft,
      comingSoonMessage,
    };
  });

  return {
    title: chapter.title,
    description: chapter.description,
    items: chapterItems
  };
});
---

<DefaultLayout 
  title={`${lesson.data.title} | ${activeCourse?.data.title || 'Course'} - EncodeEdge`}
  description={lesson.data.description || lesson.data.title}
>
  <div class="w-full">
    <CourseLearningStudio
      client:load
      courseId={activeCourse?.id || 'system-design'}
      courseTitle={activeCourse?.data.title || 'System Design Mastery'}
      currentLesson={{
        id: lesson.id,
        title: lesson.data.title,
        description: lesson.data.description,
        lessonType: lesson.data.lessonType,
        duration: lesson.data.duration,
        videoUrl: lesson.data.videoUrl,
        interactiveLab: lesson.data.interactiveLab,
        comingSoon: lesson.data.comingSoon || false,
        draft: lesson.data.draft || false,
        comingSoonMessage: lesson.data.comingSoonMessage,
      }}
      chapters={structuredChapters}
    >
      {!lesson.data.comingSoon && !lesson.data.draft && (
        <>
          <!-- Interactive Lab Embed: Managed per-lesson via Keystatic -->
          {lesson.data.interactiveLab === 'neural-playground' && (
            <div class="my-6">
              <NeuralPlayground client:load />
            </div>
          )}

          {lesson.data.interactiveLab === 'gradient-descent' && (
            <div class="my-6">
              <GradientDescentLab client:load />
            </div>
          )}

          {lesson.data.interactiveLab === 'memory-explorer' && (
            <div class="my-6">
              <MemoryExplorer client:load />
            </div>
          )}

          {(lesson.data.interactiveLab === 'code-sandbox' || lesson.data.interactiveLab === 'custom-sandbox' || (lesson.data.lessonType === 'lab' && (!lesson.data.interactiveLab || lesson.data.interactiveLab === 'none'))) && (lesson.data.customLabCode || hasSnippetForContent(lesson.id)) && (
            <div class="my-6">
              <CodeSandboxRunner 
                contentId={lesson.id} 
                titleOverride={lesson.data.interactiveLabTitle}
                descriptionOverride={lesson.data.interactiveLabDescription}
                customSnippet={lesson.data.customLabCode ? {
                  id: `custom-${lesson.id}`,
                  title: lesson.data.interactiveLabTitle || `${lesson.data.title}: Interactive Lab`,
                  shortTitle: lesson.data.interactiveLabTitle || 'Custom Lab',
                  category: 'Python',
                  code: lesson.data.customLabCode,
                  expectedOutput: lesson.data.customLabOutput ? lesson.data.customLabOutput.split('\n') : ['[Execution verified]'],
                  description: lesson.data.interactiveLabDescription || 'Interactive Python simulation tailored to this lesson.',
                } : undefined}
                client:load 
              />
            </div>
          )}

          <!-- Lesson Markdown Prose Content -->
          <Content components={{ Callout, VideoEmbed, AudioPlayer, QuizBlock, NewsletterCTA, StatCard, CodeSnippet, ReferenceCard, InteractiveLab, CodeSandbox, MathFormula, PaywallGuard }} />
        </>
      )}
    </CourseLearningStudio>
  </div>
</DefaultLayout>
