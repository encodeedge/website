---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { SystemDesignStudio } from '@/components/interactive/SystemDesignStudio';
import { getCollection } from 'astro:content';
import { getSystemDesignPageSettings } from '@/lib/settings';
import { 
  Network, 
  Cpu, 
  Zap, 
  Sparkles, 
  Boxes, 
  ArrowRight, 
  ShieldCheck, 
  Layers, 
  BookOpen
} from 'lucide-react';

const pageSettings = await getSystemDesignPageSettings();

// Load dynamic collections from Keystatic
const problemEntries = await getCollection('systemDesignProblems');
const archEntries = await getCollection('systemDesignArchitectures');
const scenarioEntries = await getCollection('systemDesignScenarios');

// Map problems for interactive flight simulator
const problems = problemEntries.length > 0
  ? problemEntries.map(e => ({
      id: e.id,
      title: e.data.title,
      difficulty: e.data.difficulty,
      category: e.data.category,
      targetQps: e.data.targetQps,
      readRatioPercent: e.data.readRatioPercent,
      maxLatencyMs: e.data.maxLatencyMs,
      summary: e.data.summary,
      functionalRequirements: e.data.functionalRequirements,
      nonFunctionalRequirements: e.data.nonFunctionalRequirements,
      hints: e.data.hints,
      referenceNodes: e.data.referenceNodes,
      referenceEdges: e.data.referenceEdges,
      order: e.data.order ?? 1,
    })).sort((a, b) => a.order - b.order)
  : undefined;

// Map architectures (ordered)
const architectures = archEntries.length > 0 
  ? archEntries.map(e => ({
      id: e.id,
      title: e.data.title,
      category: e.data.category,
      sla: e.data.sla,
      summary: e.data.summary,
      latencyBudget: e.data.latencyBudget,
      componentsUsed: e.data.componentsUsed,
      coreTradeoff: e.data.coreTradeoff,
      order: e.data.order ?? 1,
    })).sort((a, b) => a.order - b.order)
  : [];

// Map puzzle scenarios
const scenarios = scenarioEntries.length > 0
  ? scenarioEntries.map(e => ({
      id: e.id,
      title: e.data.title,
      systemName: e.data.systemName,
      slaTarget: e.data.slaTarget,
      difficulty: e.data.difficulty,
      xpReward: e.data.xpReward,
      scenarioDescription: e.data.scenarioDescription,
      objective: e.data.objective,
      vpcName: e.data.vpcName,
      subnets: e.data.subnets,
      components: e.data.components,
      engineeringInsight: e.data.engineeringInsight,
      hint: e.data.hint,
      order: e.data.order ?? 1,
    })).sort((a, b) => a.order - b.order)
  : undefined;

const goldenPrinciples = pageSettings.goldenPrinciples?.length > 0 
  ? pageSettings.goldenPrinciples 
  : [];

const title = pageSettings.seoTitle || 'System Design Studio: Interactive Problem Simulator & Blueprints | EncodeEdge';
const description = pageSettings.seoDescription || 'Master enterprise distributed and AI/ML system design. Practice interactive problem challenges, simulate live production traffic (1k–250k QPS), find bottlenecks, solve AWS pipeline puzzles, and inspect production reference blueprints.';
---

<DefaultLayout title={title} description={description}>
  <div class="relative overflow-hidden pt-6 pb-20 px-2 sm:px-4 lg:px-6 max-w-[1800px] w-full mx-auto space-y-8">
    {/* Ambient Glow matching EncodeEdge brand theme */}
    <div class="absolute top-10 left-1/2 -translate-x-1/2 -z-10 w-full max-w-6xl h-72 bg-gradient-to-tr from-[#E5E795]/15 via-indigo-500/10 to-cyan-500/10 blur-3xl rounded-full pointer-events-none" />

    {/* Hero Section */}
    <header class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#E5E795]/20 border border-[#E5E795]/40 text-[#2a2c07] dark:text-[#E5E795] text-xs font-mono font-bold uppercase tracking-wider">
        <Cpu class="w-3.5 h-3.5 text-indigo-600 dark:text-[#E5E795]" />
        <span>{pageSettings.hero?.eyebrow || 'System Design Flight Simulator & Blueprint Studio'}</span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-foreground tracking-tight leading-tight">
        {pageSettings.hero?.heading || 'Interactive System Design Studio'}
      </h1>
      
      <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed font-body">
        {pageSettings.hero?.subheading || 'Practice real-world distributed architectures. Drag & drop infrastructure blocks, wire synchronous and asynchronous dataflows, push live production traffic (1k–250k QPS), find bottlenecks, and get scored across 5 interview dimensions.'}
      </p>

      {/* Quick Nav Anchors */}
      <div class="pt-1 flex flex-wrap items-center justify-center gap-2 text-xs font-medium">
        <a 
          href="/system-design"
          class="px-3.5 py-1.5 rounded-xl bg-[#E5E795]/20 border border-[#E5E795]/40 text-indigo-600 dark:text-[#E5E795] hover:bg-[#E5E795]/30 transition-colors flex items-center gap-1.5 shadow-2xs font-semibold"
        >
          <Cpu class="w-3.5 h-3.5 text-indigo-600 dark:text-[#E5E795]" />
          <span>Problem Simulator (Game Play)</span>
        </a>
        <a 
          href="/system-design?mode=puzzle#blueprint-lab"
          class="px-3.5 py-1.5 rounded-xl bg-card border border-border text-foreground hover:bg-secondary transition-colors flex items-center gap-1.5 shadow-2xs"
        >
          <Boxes class="w-3.5 h-3.5 text-cyan-500" />
          <span>AWS Blueprint Lab</span>
        </a>
        <a 
          href="/system-design?mode=reference#reference-architectures"
          class="px-3.5 py-1.5 rounded-xl bg-card border border-border text-foreground hover:bg-secondary transition-colors flex items-center gap-1.5 shadow-2xs"
        >
          <BookOpen class="w-3.5 h-3.5 text-emerald-500" />
          <span>Reference Blueprints</span>
        </a>
        <a 
          href="/system-design?mode=principles#golden-principles"
          class="px-3.5 py-1.5 rounded-xl bg-card border border-border text-foreground hover:bg-secondary transition-colors flex items-center gap-1.5 shadow-2xs"
        >
          <ShieldCheck class="w-3.5 h-3.5 text-indigo-500" />
          <span>Golden Principles</span>
        </a>
      </div>
    </header>

    {/* The Unified Interactive Studio Component (Multi-mode Island) */}
    <main class="relative z-10">
      <SystemDesignStudio
        initialProblems={problems}
        scenarios={scenarios}
        architectures={architectures}
        goldenPrinciples={goldenPrinciples}
        pageSettings={pageSettings}
        client:load
      />
    </main>

    {/* Bottom Navigation CTA */}
    <div class="p-8 rounded-3xl bg-gradient-to-r from-[#E5E795]/10 via-card to-indigo-500/10 border border-border flex flex-col sm:flex-row sm:items-center justify-between gap-6 shadow-sm">
      <div class="space-y-1">
        <h3 class="text-xl font-bold font-display text-foreground">
          {pageSettings.bottomCta?.heading || 'Continue Learning AI Engineering'}
        </h3>
        <p class="text-xs sm:text-sm text-muted-foreground font-body">
          {pageSettings.bottomCta?.subheading || 'Dive into step-by-step algorithms, loss surface mathematics, and complete code walkthroughs.'}
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a 
          href={pageSettings.bottomCta?.secondaryButtonUrl || '/labs'} 
          class="px-5 py-2.5 rounded-xl bg-card hover:bg-secondary border border-border text-foreground font-medium text-xs sm:text-sm flex items-center gap-2 transition-colors"
        >
          <span>{pageSettings.bottomCta?.secondaryButtonText || 'All Interactive Labs'}</span>
          <ArrowRight class="w-4 h-4" />
        </a>
        <a 
          href={pageSettings.bottomCta?.primaryButtonUrl || '/courses'} 
          class="px-5 py-2.5 rounded-xl bg-primary text-primary-foreground font-bold text-xs sm:text-sm flex items-center gap-2 transition-colors shadow-md hover:brightness-105"
        >
          <span>{pageSettings.bottomCta?.primaryButtonText || 'Explore Courses'}</span>
          <ArrowRight class="w-4 h-4 stroke-[3]" />
        </a>
      </div>
    </div>
  </div>
</DefaultLayout>
