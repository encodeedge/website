---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { getCollection } from 'astro:content';
import { Card, CardHeader, CardTitle, CardDescription, CardContent, CardFooter } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';

const allCourses = await getCollection('courses');
const publishedCourses = allCourses.filter(course => course.data.status === 'published');
---

<DefaultLayout title="Courses" description="Explore our comprehensive courses.">
  <div class="py-12 md:py-16 max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-block text-xs font-semibold uppercase tracking-wider bg-black-100 dark:bg-black-800 text-muted-foreground px-3 py-1 rounded-full mb-3">
        Structured Learning
      </span>
      <h1 class="text-4xl sm:text-5xl font-bold font-display tracking-tight text-foreground mb-4">
        Our Courses
      </h1>
      <p class="text-base sm:text-lg text-muted-foreground font-body">
        Level up your skills with comprehensive, hands-on courses led by experienced practitioners.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {publishedCourses.length > 0 ? publishedCourses.map(course => (
        <div class="flex flex-col h-full rounded-2xl border border-black-200 dark:border-black-800 bg-card overflow-hidden shadow-sm hover:shadow-md transition-all hover:-translate-y-1">
          {course.data.coverImage && (
            <div class="w-full h-48 overflow-hidden bg-black-100 dark:bg-black-800">
              <img 
                src={course.data.coverImage} 
                alt={course.data.title} 
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
              />
            </div>
          )}
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-center mb-3">
                <span class="woords_tag capitalize text-xs">
                  {course.data.level}
                </span>
              </div>
              <h2 class="text-xl font-bold font-display text-foreground mb-2">
                {course.data.title}
              </h2>
              <p class="text-sm text-muted-foreground font-body line-clamp-2">
                {course.data.shortDescription}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-black-100 dark:border-black-800">
              <a href={`/courses/${course.id}`} class="block w-full">
                <button class="woords_btn w-full text-sm">
                  View Course →
                </button>
              </a>
            </div>
          </div>
        </div>
      )) : (
        <p class="text-muted-foreground col-span-3 text-center py-12">No courses available at the moment. Please check back later.</p>
      )}
    </div>
  </div>
</DefaultLayout>

